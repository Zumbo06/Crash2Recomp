# ==========================================================================
# Crash 2 Recomp
#
# What this repo IS: the launcher source, our reverse-engineering work
# (seeds, symbols, patches, notes) and the build scripts.
#
# What it is NOT: the game, anything derived from the game, a BIOS, or the
# psxrecomp framework. Those are either copyrighted, machine-translated from
# copyrighted code, or third-party trees we deliberately do not carry.
#
# Everything under _build/ is reproducible from this repo plus your own disc.
# ==========================================================================


# --------------------------------------------------------------------------
# 1. Copyrighted game data - NEVER commit any of this
# --------------------------------------------------------------------------
# Your disc dump. Keep it outside the repo, or here where it stays ignored.
Crash Bandicoot 2 - Cortex Strikes Back (USA)/
*.bin
*.cue
*.iso
*.chd
*.img
*.ccd
*.sub
*.m3u

# The game's boot executable, extracted from the disc (e.g. SCUS_941.54).
input/
prepared_disc/
SCUS_*
SCES_*
SLUS_*
SLES_*

# C machine-translated from the game's MIPS code. Derived work - regenerate it
# locally with psxrecomp.exe build; never distribute it.
generated/
*_full.c
*_full_*.c
*_dispatch.c
*_decls.h
*.ranges

# PS1 BIOS images. OpenBIOS is MIT and ships with psxrecomp; a retail dump is
# yours alone. Neither belongs in git.
*.BIN
openbios.bin
SCPH*.bin
SCPH*.BIN
bios/


# --------------------------------------------------------------------------
# 2. Third-party trees we do not carry
# --------------------------------------------------------------------------
# psxrecomp is a BUILD-TIME TOOL, not a dependency of this project.
# PolyForm Noncommercial licensed. Fetch it yourself:
#   _build/psxrecomp-cli  <- release zip
#   _build/psxrecomp-src  <- git clone (for `analyze` tooling)
_build/psxrecomp-cli/
_build/psxrecomp-src/
_build/psxrecomp-cli.zip
psxrecomp/
recomp-ui/

# The generated project (contains the vendored framework + generated C).
_build/Crash2Recomp/

# Downloaded toolchains (ninja, cmake-clang-v1).
_build/tools/
toolchain/
*.tar.gz
*.zip


# --------------------------------------------------------------------------
# 3. Build output
# --------------------------------------------------------------------------
# Ignore the scratch build area, but keep the scripts and the small,
# hand-maintained project inputs someone needs to reproduce this build.
# (Pattern must be `_build/*`, not `_build/`, for the negations to apply, and
# each parent directory has to be re-included before its children.)
_build/*
!_build/*.ps1
!_build/*.py
!_build/padprobe.c

# The generated project: keep ONLY the reproducible inputs. Everything derived
# from the disc stays out - see section 1.
!_build/Crash2Recomp/
_build/Crash2Recomp/*
!_build/Crash2Recomp/game.toml
!_build/Crash2Recomp/CMakeLists.txt
!_build/Crash2Recomp/build.ps1
!_build/Crash2Recomp/build.sh
!_build/Crash2Recomp/README.md
!_build/Crash2Recomp/seeds/
!_build/Crash2Recomp/seeds/*.txt

build/
build-clang/
dist/
# Local release-packaging scripts. Anchored to the repo root so it cannot hide
# a vendored tools/ directory deeper in the tree.
/tools/
# Release notes are drafted per release and published with the download rather
# than kept in history. package.ps1 copies this into the bundle when present
# and simply omits it when not.
/RELEASE_NOTES.md
out/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
*.o
*.obj
*.a
*.lib
*.exe
*.dll
*.pdb
*.ilk
*.exp
compile_commands.json
.ninja_deps
.ninja_log


# --------------------------------------------------------------------------
# 4. Runtime-generated state
# --------------------------------------------------------------------------
# Save data and memory cards are personal, and savestates are not portable
# between BIOS backends.
userdata/
saves/
save/
*.mcd
*.mcr
*.sav
*.savestate

# Written by the runtime next to the executable on first launch.
settings.json
settings.toml
keybinds.ini
input.ini
config.ini
game_options.toml
disc.cfg
bios.cfg

# Overlay capture/compile cache - rebuilt by playing.
overlay_captures.json
overlay_captures.json.d/
overlay_cache/
overlay_toolchain/

# Diagnostics.
*.log
psx_freeze_dump_*.json
psx_cps_exit_trace.json
analysis/

# Screenshots and frame grabs from debugging. Launcher UI artwork and anything
# under docs/ is real content, so keep those.
*.png
!docs/**/*.png
!launcher/**/assets/**/*.png
!launcher/**/assets/**/*.ico
!launcher/**/assets/**/*.svg
# Personal launcher artwork supplied locally; the native fallback is in code.
/launcher/crash2launcher/ui/assets/play-reference.png


# --------------------------------------------------------------------------
# 5. Python (the launcher)
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# PyInstaller
*.spec
!launcher/crash2launcher.spec
launcher/build/
launcher/dist/


# --------------------------------------------------------------------------
# 6. Editors and OS
# --------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
Desktop.ini
.DS_Store

+void psx_pause_menu_place(int surf_w, int surf_h, int *x, int *y, int *w, int *h)
+{
+    double fit;
+    int pw, ph;
+    if (surf_w <= 0 || surf_h <= 0) {
+        if (x) *x = 0;
+        if (y) *y = 0;
+        if (w) *w = 0;
+        if (h) *h = 0;
+        return;
+    }
+    fit = (double)surf_w / PM_W;
+    if ((double)surf_h / PM_H < fit) fit = (double)surf_h / PM_H;
+    if (fit >= 2.0) {
+        /* Whole pixels: the 8x8 font stays square and every stroke even. */
+        int s = (int)fit;
+        if (s > 2 && s * PM_H > surf_h - 2 * PM_MARGIN) s--;
+        pw = s * PM_W;
+        ph = s * PM_H;
+    } else {
+        /* A small window cannot afford 2x: fit it, a little inside. */
+        pw = (int)(PM_W * fit * 0.96);
+        ph = (int)(PM_H * fit * 0.96);
+    }
+    if (x) *x = (surf_w - pw) / 2;
+    if (y) *y = (surf_h - ph) / 2;
+    if (w) *w = pw;
+    if (h) *h = ph;
 }
 

+        !p_glBlendFuncSeparate || !p_glBlendEquationSeparate)
+        return;
+    p_glActiveTexture(PSXGL_TEXTURE0);
+    if (!s_dim_tex) {
+        const uint32_t grey = 0xFF000000u
+            | (uint32_t)PSX_PAUSE_BACKDROP_KEEP * 0x010101u;

+void crash2_wide_reject_note_restore(void) { c2wr_code = -1; }
+
+void crash2_wide_reject_control(int on, int reset) {
+    if (on == 0 || on == 1) c2wr_mode = on;
+    if (reset) c2wr_checked = c2wr_kept = c2wr_mismatch = 0;
+}
+
+void crash2_wide_reject_stats(unsigned long long out[3], int *on, int *code_ok,
+                              int *off) {
+    out[0] = c2wr_checked; out[1] = c2wr_kept; out[2] = c2wr_mismatch;
+    if (on)      *on = c2wr_mode < 0 ? 1 : c2wr_mode;
+    if (code_ok) *code_ok = c2wr_code;
+    if (off)     *off = c2wr_last_off;
+}
+
+static int c2wr_code_ok(CPUState *cpu) {
+    for (size_t i = 0; i < sizeof(c2wr_words) / sizeof(c2wr_words[0]); ++i)
+        if (cpu->read_word(c2wr_words[i][0]) != c2wr_words[i][1]) return 0;
+    return 1;
+}
+
+/* The game's rule with the edges as parameters: outside when every X is left
+ * of lo (if that edge is tested) or every X is at or right of hi. */
+static int c2wr_outside(const int *x, int n, int lo, int hi, int left_edge) {
+    int all_left = left_edge, all_right = 1;
+    for (int i = 0; i < n; ++i) {
+        if (x[i] >= lo) all_left = 0;
+        if (x[i] < hi) all_right = 0;
+    }
+    return all_left || all_right;
+}
+
+static void crash2_wide_reject(CPUState *cpu, uint32_t pc) {
+    if (pc - C2WR_FIRST > C2WR_LAST - C2WR_FIRST) return;
+    int kind;
+    switch (pc) {
+    case 0x80041C18u: case 0x800424E0u: case 0x80045EC4u: kind = C2WR_TRI; break;
+    case 0x800427A0u: case 0x800460D0u:                   kind = C2WR_QUAD; break;
+    case 0x8004518Cu:                                     kind = C2WR_LINE; break;
+    case 0x80045404u:                                     kind = C2WR_DOT; break;
+    default: return;
+    }
+    if ((int32_t)cpu->gpr[24] >= 0) return;        /* the game keeps it anyway */

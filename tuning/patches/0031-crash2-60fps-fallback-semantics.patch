+            c2_60_hold_bad = 0;
+            if (++c2_60_host_bad >= C2_60_HOST_STREAK)
+                c2_60_back_off(now);
         } else if (verdict == C2_60_FAIL_HOLD) {
             /* The host is fine; the GUEST cannot fit its frame in one field.
              *
@@ -423,9 +446,11 @@ static void crash2_60fps(CPUState *cpu, uint32_t pc)
              * wall-clock second for a host that is already close to its limit

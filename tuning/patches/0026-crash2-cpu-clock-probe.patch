Record of the CPU-only clock probe that landed alongside 0025 and was never
written down. The 60 FPS work in 0027 modifies these hunks, so the record has
to exist before it. Reconstructed against _build/psxrecomp-src; the unrelated
SPU sample-event drift in psx_cycles.c is deliberately not carried here.

--- a/runtime/src/psx_cycles.c
+++ b/runtime/src/psx_cycles.c
@@ -23,0 +23,26 @@
 uint64_t psx_cycle_count = 0;
+#ifndef PSX_NO_DEBUG_TOOLS
+/* SCUS-94154 CPU-only overclock experiment. CPU charges are reduced while
+ * device intervals, VBlank, CD, SPU and timers stay on their original clock.
+ * Fractional carry keeps long-run guest time exact at a given percentage. */
+uint32_t g_crash2_cpu_clock_pct = 100u;
+static uint32_t s_crash2_cpu_clock_remainder = 0u;
+
+void psx_crash2_cpu_clock_set(uint32_t percent) {
+    g_crash2_cpu_clock_pct = percent;
+    s_crash2_cpu_clock_remainder = 0u;
+}
+
+uint32_t psx_crash2_cpu_clock_charge(uint32_t cycles) {
+    uint32_t pct = g_crash2_cpu_clock_pct;
+    if (pct == 100u) return cycles;
+    uint64_t numerator = (uint64_t)cycles * 100u + s_crash2_cpu_clock_remainder;
+    s_crash2_cpu_clock_remainder = (uint32_t)(numerator % pct);
+    return (uint32_t)(numerator / pct);
+}
+
+/* Native overlay DLLs batch their CPU charges before invoking this callback.
+ * Share the same fractional carry as main-exe and interpreted instructions. */
+void psx_crash2_overlay_advance_cycles(uint32_t cycles) {
+    psx_advance_cycles(psx_crash2_cpu_clock_charge(cycles));
+}
+#endif
 uint32_t g_psx_cyc_batch = 0;

+/* Developer-only CPU-clock ceiling probe. This is not game-speed
+ * compensation; a 60 Hz loop may make gameplay twice as fast. */
+static void handle_crash2_cpu_clock_probe(int id, const char *json)
+{
+    extern uint32_t g_crash2_cpu_clock_pct;
+    extern void psx_crash2_cpu_clock_set(uint32_t percent);
+    if (psx_read_word(0x80011848u) != 0x3C028007u ||
+        psx_read_word(0x8001184Cu) != 0x8C429944u ||
+        psx_read_word(0x80016868u) != 0x0C012921u) {
+        send_err(id, "SCUS-94154 CPU-clock signature mismatch");
+        return;
+    }
+    int requested = json_get_int(json, "percent", -1);
+    if (requested >= 0) {
+        if (requested < 100 || requested > 150) {
+            send_err(id, "percent must be 100..150");
+            return;
+        }
+        psx_crash2_cpu_clock_set((uint32_t)requested);
+    }
+    send_fmt("{\"id\":%d,\"ok\":true,\"percent\":%u}",
+             id, (unsigned)g_crash2_cpu_clock_pct);
+}

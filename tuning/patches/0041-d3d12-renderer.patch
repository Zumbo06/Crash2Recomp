+/* Pixel-pack buffer mapping (asynchronous VRAM download). */
+static void *x_MapBufferRange(unsigned target, ptrdiff_t offset, ptrdiff_t length, unsigned) {
+    if (target != X_PIXEL_PACK_BUFFER) return nullptr;
+    Buf *b = T_buf.get(S.pack_buffer);
+    if (!b || !b->rb) return nullptr;
+    if (b->rb_pending) {
+        if (b->rb_fence > D->fence_submitted) submit();
+        wait_value(b->rb_fence);
+        b->rb_pending = false;
+    }
+    void *p = nullptr;
+    D3D12_RANGE r{0, (SIZE_T)b->rb_size};
+    if (FAILED(b->rb->Map(0, &r, &p))) return nullptr;
+    const int dbpp = client_bpp(b->rb_fmt, b->rb_type);
+    const size_t row_px = S.pack_row > 0 ? (size_t)S.pack_row : (size_t)b->rb_w;
+    const size_t stride = align_up(row_px * (size_t)dbpp, (size_t)std::max(1, S.pack_align));
+    b->mapped.assign(std::max(b->size, stride * (size_t)b->rb_h), 0);
+    unpack_rows((const uint8_t *)p, b->rb_pitch, b->rb_src, b->rb_w, b->rb_h, b->rb_fmt, b->rb_type,
+                b->mapped.data());
+    D3D12_RANGE none{0, 0};
+    b->rb->Unmap(0, &none);
+    if ((size_t)offset + (size_t)length > b->mapped.size()) return nullptr;
+    return b->mapped.data() + offset;
+}

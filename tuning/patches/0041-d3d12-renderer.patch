+void *gl12_CreateContext(SDL_Window *win) {
+    if (D) destroy_all();
+    g_err_text[0] = 0;
+    D = new Dev();
+    D->win = win;
+    D->hwnd = (HWND)SDL_GetPointerProperty(SDL_GetWindowProperties(win),
+                                           SDL_PROP_WINDOW_WIN32_HWND_POINTER, nullptr);
+    if (!D->hwnd) { std::snprintf(g_err_text, sizeof(g_err_text), "no window handle"); destroy_all(); return nullptr; }
+
+    D->compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+    if (D->compiler) {
+        D->compile = (pD3DCompile)(void *)GetProcAddress(D->compiler, "D3DCompile");
+        D->reflect = (decltype(&D3DReflect))(void *)GetProcAddress(D->compiler, "D3DReflect");
+        D->create_blob = (decltype(&D3DCreateBlob))(void *)GetProcAddress(D->compiler, "D3DCreateBlob");
+    }
+    if (!D->compile || !D->reflect || !D->create_blob) {
+        std::snprintf(g_err_text, sizeof(g_err_text), "d3dcompiler_47.dll is missing");
+        logf("%s", g_err_text);
+        destroy_all();
+        return nullptr;
+    }
+    if (const char *base = SDL_GetBasePath()) {
+        D->cache_dir = base;
+        D->cache_dir += "shadercache\\";
+        CreateDirectoryA(D->cache_dir.c_str(), nullptr);
+    }
+
+    const char *dbg = std::getenv("PSX_D3D12_DEBUG");
+    UINT fflags = 0;
+    if (dbg && dbg[0] == '1') {
+        ID3D12Debug *d = nullptr;
+        if (SUCCEEDED(D3D12GetDebugInterface(IID_PPV_ARGS(&d)))) {
+            d->EnableDebugLayer();
+            d->Release();
+            fflags |= DXGI_CREATE_FACTORY_DEBUG;
+            logf("debug layer enabled");
+        }
+    }
+    HRESULT hr = CreateDXGIFactory2(fflags, IID_PPV_ARGS(&D->factory));
+    if (FAILED(hr)) { fail_text("DXGI factory creation failed", hr); destroy_all(); return nullptr; }
+
+    IDXGIAdapter1 *adapter = nullptr;
+    IDXGIFactory6 *f6 = nullptr;
+    if (SUCCEEDED(D->factory->QueryInterface(IID_PPV_ARGS(&f6)))) {
+        f6->EnumAdapterByGpuPreference(0, DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE, IID_PPV_ARGS(&adapter));
+        f6->Release();
+    }
+    hr = D3D12CreateDevice(adapter, D3D_FEATURE_LEVEL_11_0, IID_PPV_ARGS(&D->dev));
+    if (FAILED(hr) && adapter) { rel(adapter); hr = D3D12CreateDevice(nullptr, D3D_FEATURE_LEVEL_11_0, IID_PPV_ARGS(&D->dev)); }
+    if (adapter) {
+        DXGI_ADAPTER_DESC1 ad{};
+        adapter->GetDesc1(&ad);
+        char name[128] = {0};
+        WideCharToMultiByte(CP_UTF8, 0, ad.Description, -1, name, sizeof(name) - 1, nullptr, nullptr);
+        logf("adapter: %s", name);
+        rel(adapter);
+    }
+    if (FAILED(hr)) { fail_text("no Direct3D 12 device (feature level 11_0)", hr); destroy_all(); return nullptr; }
+    if (dbg && dbg[0] == '1' && SUCCEEDED(D->dev->QueryInterface(IID_PPV_ARGS(&D->iq)))) {
+        /* Resources are created without an optimized clear value, so every
+         * clear draws a performance note; and the textured program always
+         * writes its dual-source second output, which passes that do not
+         * blend with it discard. Both are expected, not faults. */
+        D3D12_MESSAGE_ID deny[] = {
+            D3D12_MESSAGE_ID_CLEARRENDERTARGETVIEW_MISMATCHINGCLEARVALUE,
+            D3D12_MESSAGE_ID_CLEARDEPTHSTENCILVIEW_MISMATCHINGCLEARVALUE,
+            D3D12_MESSAGE_ID_CREATEGRAPHICSPIPELINESTATE_RENDERTARGETVIEW_NOT_SET,
+        };
+        D3D12_INFO_QUEUE_FILTER f{};
+        f.DenyList.NumIDs = (UINT)(sizeof(deny) / sizeof(deny[0]));
+        f.DenyList.pIDList = deny;
+        D->iq->AddStorageFilterEntries(&f);
+    }
+    if (const char *dump = std::getenv("PSX_GL12_DUMP")) D->dump_prefix = dump;
+
+    D3D12_COMMAND_QUEUE_DESC qd{};
+    qd.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    if (FAILED(hr = D->dev->CreateCommandQueue(&qd, IID_PPV_ARGS(&D->queue)))) {
+        fail_text("command queue creation failed", hr); destroy_all(); return nullptr;
+    }
+    D->queue->GetTimestampFrequency(&D->ts_freq);
+    if (!D->ts_freq) D->ts_freq = 1;
+
+    {
+        IDXGIFactory5 *f5 = nullptr;
+        BOOL allow = FALSE;
+        if (SUCCEEDED(D->factory->QueryInterface(IID_PPV_ARGS(&f5)))) {
+            if (SUCCEEDED(f5->CheckFeatureSupport(DXGI_FEATURE_PRESENT_ALLOW_TEARING, &allow, sizeof(allow))))
+                D->tearing = allow != FALSE;
+            f5->Release();
+        }
+    }
+    int ww = 0, wh = 0;
+    window_pixels(&ww, &wh);
+    if (ww <= 0) ww = 640;
+    if (wh <= 0) wh = 480;
+    DXGI_SWAP_CHAIN_DESC1 sd{};
+    sd.Width = (UINT)ww; sd.Height = (UINT)wh;
+    sd.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    sd.SampleDesc.Count = 1;
+    sd.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    sd.BufferCount = GL12_FRAMES;
+    sd.Scaling = DXGI_SCALING_STRETCH;
+    sd.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+    sd.AlphaMode = DXGI_ALPHA_MODE_UNSPECIFIED;
+    sd.Flags = D->tearing ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0;
+    IDXGISwapChain1 *sc1 = nullptr;
+    hr = D->factory->CreateSwapChainForHwnd(D->queue, D->hwnd, &sd, nullptr, nullptr, &sc1);
+    if (FAILED(hr)) { fail_text("swap chain creation failed", hr); destroy_all(); return nullptr; }
+    sc1->QueryInterface(IID_PPV_ARGS(&D->swap));
+    sc1->Release();
+    D->factory->MakeWindowAssociation(D->hwnd, DXGI_MWA_NO_ALT_ENTER);
+    D->sc_w = (UINT)ww; D->sc_h = (UINT)wh;
+
+    if (FAILED(hr = D->dev->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&D->fence)))) {
+        fail_text("fence creation failed", hr); destroy_all(); return nullptr;
+    }
+    D->event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    for (int i = 0; i < GL12_ALLOCATORS; i++) {
+        if (FAILED(hr = D->dev->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&D->alloc[i])))) {
+            fail_text("command allocator creation failed", hr); destroy_all(); return nullptr;
+        }
+    }
+    if (FAILED(hr = D->dev->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, D->alloc[0], nullptr,
+                                             IID_PPV_ARGS(&D->cl)))) {
+        fail_text("command list creation failed", hr); destroy_all(); return nullptr;
+    }
+    D->cl->Close();
+    D->alloc_cur = GL12_ALLOCATORS - 1;
+
+    if (!D->srv.init(D->dev, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV, 4096) ||
+        !D->rtv.init(D->dev, D3D12_DESCRIPTOR_HEAP_TYPE_RTV, 1024) ||
+        !D->dsv.init(D->dev, D3D12_DESCRIPTOR_HEAP_TYPE_DSV, 64)) {
+        fail_text("descriptor heap creation failed", E_FAIL); destroy_all(); return nullptr;
+    }
+    {
+        D3D12_DESCRIPTOR_HEAP_DESC d{};
+        d.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+        d.NumDescriptors = GL12_GPU_DESC;
+        d.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        if (FAILED(hr = D->dev->CreateDescriptorHeap(&d, IID_PPV_ARGS(&D->gsrv)))) {
+            fail_text("shader-visible heap creation failed", hr); destroy_all(); return nullptr;
+        }
+        D->gsrv_inc = D->dev->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+        for (int b = GL12_GPU_DESC / GL12_DESC_BLOCK - 1; b >= 0; b--) D->desc_free.push_back(b);
+        d.Type = D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER;
+        d.NumDescriptors = 1024;
+        if (FAILED(hr = D->dev->CreateDescriptorHeap(&d, IID_PPV_ARGS(&D->gsmp)))) {
+            fail_text("sampler heap creation failed", hr); destroy_all(); return nullptr;
+        }
+        D->gsmp_inc = D->dev->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER);
+    }
+    D->null_srv = D->srv.alloc();
+    D->null_srv_uint = D->srv.alloc();
+    {
+        D3D12_SHADER_RESOURCE_VIEW_DESC nd{};
+        nd.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        nd.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        nd.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        nd.Texture2D.MipLevels = 1;
+        D->dev->CreateShaderResourceView(nullptr, &nd, D->srv.at(D->null_srv));
+        nd.Format = DXGI_FORMAT_R16_UINT;
+        D->dev->CreateShaderResourceView(nullptr, &nd, D->srv.at(D->null_srv_uint));
+    }
+    if (!make_root() || !make_samplers() || !make_flip_pso()) { destroy_all(); return nullptr; }
+    D->line_gs = compile_hlsl("GL12_LINE_GS", LINE_GS, "gs_5_0");
+
+    {
+        D3D12_QUERY_HEAP_DESC qh{};
+        qh.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+        qh.Count = GL12_QUERY_SLOTS;
+        if (SUCCEEDED(D->dev->CreateQueryHeap(&qh, IID_PPV_ARGS(&D->qheap)))) {
+            D3D12_HEAP_PROPERTIES hp{}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+            D3D12_RESOURCE_DESC rd{};
+            rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+            rd.Width = (UINT64)GL12_QUERY_SLOTS * 8; rd.Height = 1; rd.DepthOrArraySize = 1;
+            rd.MipLevels = 1; rd.SampleDesc.Count = 1; rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+            if (SUCCEEDED(D->dev->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &rd,
+                    D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&D->qrb)))) {
+                D3D12_RANGE r{0, (SIZE_T)GL12_QUERY_SLOTS * 8};
+                D->qrb->Map(0, &r, (void **)&D->qrb_cpu);
+            }
+        }
+    }
+
+    if (!swap_buffers_acquire()) { fail_text("swap chain buffers unavailable", E_FAIL); destroy_all(); return nullptr; }
+    fb0_ensure(ww, wh);
+    S = State();
+    S.vp[2] = ww; S.vp[3] = wh;
+    logf("device ready (%s tearing, %dx%d)", D->tearing ? "with" : "without", ww, wh);
+    return (void *)D;
+}

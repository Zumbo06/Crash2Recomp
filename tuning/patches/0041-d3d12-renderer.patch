+// HLSL translation of gpu_gl_postfx.c FS_SMAA_WEIGHTS (see gpu_gl12.h).
+cbuffer PSU : register(b1) {
+    float4 u_rt;
+};
+Texture2D    u_edges      : register(t0);
+SamplerState u_edges_smp  : register(s0);
+Texture2D    u_area       : register(t1);
+SamplerState u_area_smp   : register(s1);
+Texture2D    u_search     : register(t2);
+SamplerState u_search_smp : register(s2);
+struct PSIn {
+    float4 pos  : SV_Position;
+    float2 v_uv : TEXCOORD0;
+};
+#define MAX_STEPS 16
+#define AREA_MAXD 16.0
+#define AREA_PX (1.0 / float2(160.0, 560.0))
+#define SEARCH_SIZE float2(66.0, 33.0)
+#define SEARCH_PACKED float2(64.0, 16.0)
+#define CORNER_NORM 0.25
+#define EDGES(uv) u_edges.SampleLevel(u_edges_smp, (uv), 0)
+#define EDGES_OFF(uv, o) u_edges.SampleLevel(u_edges_smp, (uv), 0, (o))
+float search_length(float2 e, float offset) {
+    float2 scale = SEARCH_SIZE * float2(0.5, -1.0);
+    float2 bias  = SEARCH_SIZE * float2(offset, 1.0);
+    scale += float2(-1.0, 1.0);
+    bias  += float2( 0.5, -0.5);
+    scale *= 1.0 / SEARCH_PACKED;
+    bias  *= 1.0 / SEARCH_PACKED;

+static unsigned x_CheckFramebufferStatus(unsigned target) {
+    const unsigned id = target == X_READ_FRAMEBUFFER ? S.read_fbo : S.draw_fbo;
+    if (id == 0) return X_FRAMEBUFFER_COMPLETE;
+    Fbo *f = T_fbo.get(id);
+    if (!f) return X_FRAMEBUFFER_INCOMPLETE_MISSING_ATTACHMENT;
+    Tex *t = T_tex.get(f->color);
+    if (!t || !t->res) return X_FRAMEBUFFER_INCOMPLETE_ATTACHMENT;
+    Rb *r = T_rb.get(f->ds);
+    if (f->ds && (!r || !r->res || r->w != t->w || r->h != t->h)) return X_FRAMEBUFFER_INCOMPLETE_ATTACHMENT;
+    return X_FRAMEBUFFER_COMPLETE;
+}
+static void x_BlitFramebuffer(int sx0, int sy0, int sx1, int sy1, int dx0, int dy0, int dx1, int dy1,
+                              unsigned mask, unsigned) {
+    if (!(mask & X_COLOR_BUFFER_BIT)) return;
+    Tex *src = fbo_color(S.read_fbo), *dst = fbo_color(S.draw_fbo);
+    if (!src || !dst || !src->res || !dst->res || src == dst) { set_error(X_INVALID_OPERATION); return; }
+    int w = sx1 - sx0, h = sy1 - sy0;
+    if (w <= 0 || h <= 0) return;
+    if (dx1 - dx0 != w || dy1 - dy0 != h) {
+        static int warned = 0;
+        if (!warned++) logf("scaled glBlitFramebuffer is not supported; copying unscaled");
+    }
+    /* Clip to both resources. */
+    if (sx0 < 0) { dx0 -= sx0; w += sx0; sx0 = 0; }
+    if (sy0 < 0) { dy0 -= sy0; h += sy0; sy0 = 0; }
+    if (dx0 < 0) { sx0 -= dx0; w += dx0; dx0 = 0; }
+    if (dy0 < 0) { sy0 -= dy0; h += dy0; dy0 = 0; }
+    w = std::min(w, std::min(src->w - sx0, dst->w - dx0));
+    h = std::min(h, std::min(src->h - sy0, dst->h - dy0));
+    if (w <= 0 || h <= 0) return;
+    open_list();
+    barrier(src->res, src->state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    barrier(dst->res, dst->state, D3D12_RESOURCE_STATE_COPY_DEST);
+    D3D12_TEXTURE_COPY_LOCATION d{}, s{};
+    d.pResource = dst->res; d.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    s.pResource = src->res; s.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_BOX box{(UINT)sx0, (UINT)sy0, 0, (UINT)(sx0 + w), (UINT)(sy0 + h), 1};
+    if (src->fmt == dst->fmt) {
+        D->cl->CopyTextureRegion(&d, (UINT)dx0, (UINT)dy0, 0, &s, &box);
+        D->dirty = true;
+    } else {
+        set_error(X_INVALID_OPERATION);
+    }
+}

+/* Queries: two timestamp slots per query object, resolved as recorded. */
+static void x_GenQueries(int n, unsigned *out) {
+    for (int i = 0; i < n; i++) {
+        out[i] = T_q.gen();
+        Query *q = T_q.get(out[i]);
+        if (D->qslot_next + 2 <= GL12_QUERY_SLOTS) {
+            q->slot0 = D->qslot_next++;
+            q->slot1 = D->qslot_next++;
+        }
+    }
+}
+static void x_DeleteQueries(int n, const unsigned *ids) { for (int i = 0; i < n; i++) T_q.del(ids[i]); }
+static void stamp(int slot) {
+    open_list();
+    D->cl->EndQuery(D->qheap, D3D12_QUERY_TYPE_TIMESTAMP, (UINT)slot);
+    D->cl->ResolveQueryData(D->qheap, D3D12_QUERY_TYPE_TIMESTAMP, (UINT)slot, 1, D->qrb, (UINT64)slot * 8);
+}
+static void x_BeginQuery(unsigned target, unsigned id) {
+    Query *q = T_q.get(id);
+    if (!q || q->slot0 < 0 || target != X_TIME_ELAPSED) return;
+    q->target = target; q->ended = false;
+    stamp(q->slot0);
+    S.active_query[0] = id;
+}
+static void x_EndQuery(unsigned target) {
+    if (target != X_TIME_ELAPSED) return;
+    Query *q = T_q.get(S.active_query[0]);
+    S.active_query[0] = 0;
+    if (!q || q->slot1 < 0) return;
+    stamp(q->slot1);
+    q->fence = D->fence_next;
+    q->ended = true;
+}
+static void x_QueryCounter(unsigned id, unsigned target) {
+    Query *q = T_q.get(id);
+    if (!q || q->slot0 < 0 || target != X_TIMESTAMP) return;
+    q->target = target;
+    stamp(q->slot0);
+    q->fence = D->fence_next;
+    q->ended = true;
+}
+static bool query_ready(Query *q) {
+    return q && q->ended && D->fence->GetCompletedValue() >= q->fence;
+}
+static void x_GetQueryObjectui64v(unsigned id, unsigned pname, uint64_t *out) {
+    Query *q = T_q.get(id);
+    if (!out) return;
+    *out = 0;
+    if (!q || !q->ended) return;
+    if (pname == X_QUERY_RESULT_AVAILABLE) { *out = query_ready(q) ? 1 : 0; return; }
+    if (!query_ready(q)) {
+        if (q->fence > D->fence_submitted) submit();
+        wait_value(q->fence);
+    }
+    const double ns = 1.0e9 / (double)D->ts_freq;
+    if (q->target == X_TIME_ELAPSED) {
+        const uint64_t a = D->qrb_cpu[q->slot0], b = D->qrb_cpu[q->slot1];
+        *out = b > a ? (uint64_t)((double)(b - a) * ns) : 0;
+    } else {
+        *out = (uint64_t)((double)D->qrb_cpu[q->slot0] * ns);
+    }
+}
+static void x_GetQueryObjectiv(unsigned id, unsigned pname, int *out) {
+    uint64_t v = 0;
+    x_GetQueryObjectui64v(id, pname, &v);
+    if (out) *out = (int)v;
+}

+    float3 d = T(-1,  0), e = T(0,  0), f = T(1,  0);
+    float3 g = T(-1,  1), h = T(0,  1), k = T(1,  1);
+    float3 mn = min(min(min(d, e), min(f, b)), h);
+    mn += min(mn, min(min(a, c), min(g, k)));
+    float3 mxc = max(max(max(d, e), max(f, b)), h);
+    mxc += max(mxc, max(max(a, c), max(g, k)));

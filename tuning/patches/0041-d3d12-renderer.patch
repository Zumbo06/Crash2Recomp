+    if (!sh) return;
+    sh->def = find_def(sh->src, sh->type);
+    sh->ok = sh->def != nullptr;
+    if (!sh->ok) {
+        sh->log = "no Direct3D 12 translation for this GLSL source (hash " +
+                  std::to_string((unsigned long long)fnv1a(sh->src.data(), sh->src.size())) +
+                  "): gpu_gl12_shaders.h is out of date";
+        logf("%s", sh->log.c_str());
+    }

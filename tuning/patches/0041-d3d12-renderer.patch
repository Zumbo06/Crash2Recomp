+    pr->linked = false;
+    if (!pr->vdef || !pr->fdef) { pr->log = "missing shader translation"; return; }
+    pr->vsb = compile_hlsl(pr->vdef->name, pr->vdef->hlsl, "vs_5_0");
+    pr->psb = compile_hlsl(pr->fdef->name, pr->fdef->hlsl, "ps_5_0");
+    if (!pr->vsb || !pr->psb) { pr->log = "HLSL compile failed"; return; }
+    pr->unis.clear(); pr->vcb.clear(); pr->pcb.clear(); pr->slot_used = 0;
+    if (!reflect_stage(pr, pr->vsb, 0) || !reflect_stage(pr, pr->psb, 1)) {
+        pr->log = "shader reflection failed";
+        return;
+    }
+    pr->linked = true;

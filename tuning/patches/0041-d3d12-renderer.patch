+static void x_ShaderSource(unsigned s, int n, const char *const *str, const int *len) {
+    Shader *sh = T_sh.get(s);
+    if (!sh) return;
+    sh->src.clear();
+    for (int i = 0; i < n; i++) {
+        if (len && len[i] >= 0) sh->src.append(str[i], (size_t)len[i]);

+// HLSL translation of gpu_gl_postfx.c FS_BLOOM_PRE (see gpu_gl12.h).
+cbuffer PSU : register(b1) {
+    float2 u_texel;
+    float  u_threshold;
+};
+Texture2D    u_src     : register(t0);
+SamplerState u_src_smp : register(s0);
+struct PSIn {
+    float4 pos  : SV_Position;
+    float2 v_uv : TEXCOORD0;
+};

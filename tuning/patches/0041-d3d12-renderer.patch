+float4 main(PSIn i) : SV_Target0 {
+    float2 v_uv = i.v_uv;
+    float2 fc = i.pos.xy;
+    float3 c = u_src.SampleLevel(u_src_smp, v_uv, 0).rgb;
+    const float3 W = float3(0.2126, 0.7152, 0.0722);
+    if (u_bloom_amt > 0.0)
+        c = sqrt(c * c + u_bloom.SampleLevel(u_bloom_smp, v_uv, 0).rgb * u_bloom_amt);

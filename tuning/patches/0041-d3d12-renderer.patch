+/* PSX_GL12_DUMP: write framebuffer 0 as a top-down PPM, for comparing the
+ * presented image against the OpenGL renderer. Development only: it waits
+ * for the GPU every frame. */
+static void dump_fb0(void) {
+    Tex *t = &D->fb0;
+    if (!t->res || t->w <= 0 || t->h <= 0) return;
+    const UINT pitch = record_readback(t, 0, 0, t->w, t->h, &D->rb_tmp, &D->rb_tmp_size);
+    if (!pitch) return;
+    finish();

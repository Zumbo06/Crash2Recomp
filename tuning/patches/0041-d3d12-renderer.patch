+// HLSL translation of gpu_gl_postfx.c FS_COMPOSITE (see gpu_gl12.h).
+cbuffer PSU : register(b1) {
+    float  u_bloom_amt;
+    float4 u_grade0;   // brightness, contrast, saturation, 1/gamma
+    float4 u_grade1;   // temperature, vignette, grain, dither
+    float2 u_size;     // lw, lh
+    float  u_seed;
+};
+Texture2D    u_src       : register(t0);
+SamplerState u_src_smp   : register(s0);
+Texture2D    u_bloom     : register(t1);
+SamplerState u_bloom_smp : register(s1);
+struct PSIn {
+    float4 pos  : SV_Position;
+    float2 v_uv : TEXCOORD0;
+};
+float hash12(float2 p) {
+    float3 p3 = frac(float3(p.xyx) * 0.1031);
+    p3 += dot(p3, p3.yzx + 33.33);
+    return frac((p3.x + p3.y) * p3.z);

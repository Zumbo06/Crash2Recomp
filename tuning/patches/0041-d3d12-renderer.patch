+template <class T> struct Table {
+    std::vector<T *> v{nullptr};
+    unsigned gen() { v.push_back(new T()); return (unsigned)v.size() - 1; }
+    T *get(unsigned id) { return (id && id < v.size()) ? v[id] : nullptr; }
+    void del(unsigned id) { if (id && id < v.size() && v[id]) { delete v[id]; v[id] = nullptr; } }
+};

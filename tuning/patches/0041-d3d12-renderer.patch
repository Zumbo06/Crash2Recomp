+    float4 off = u_rt.xyxy * float4(1.0, 0.0, 0.0, 1.0) + tc.xyxy;
+    float4 a;
+    a.x = u_blend.SampleLevel(u_blend_smp, off.xy, 0).a;
+    a.y = u_blend.SampleLevel(u_blend_smp, off.zw, 0).g;
+    a.wz = u_blend.SampleLevel(u_blend_smp, tc, 0).xz;
+    if (dot(a, float4(1.0, 1.0, 1.0, 1.0)) < 1e-5)
+        return u_color.SampleLevel(u_color_smp, tc, 0);

+    o.v_uv = i.a_uv; o.v_uv_p = i.a_uv; o.v_col = i.a_col;
+    o.v_persp = (i.a_q > 0.0) ? 1 : 0;
+    o.v_tpage = int2(i.a_tpage + 0.5); o.v_clut = int2(i.a_clut + 0.5);
+    o.v_depth = int(i.a_depth + 0.5); o.v_raw = int(i.a_raw + 0.5);
+    o.v_semi = int(i.a_semi + 0.5);
+    o.v_limits = int4(floor(i.a_limits + 0.5));
+    float xb = i.a_pos.x;
+    if (u_xscale < 0.0) {
+        float s = -u_xscale; float h = u_xhalf / s;
+        float l = u_xcenter - h, r = u_xcenter + h;
+        if (xb < l) xb = l + (xb - l) * s; else if (xb > r) xb = r + (xb - r) * s;
+    } else xb = (xb - u_xcenter) * u_xscale + u_xcenter;
+    float w = (i.a_q > 0.0) ? (1.0 / i.a_q) : 1.0;
+    float2 ndc = float2((xb + u_shift + u_xoff) / u_xhalf - 1.0, (i.a_pos.y + u_shift) / 256.0 - 1.0);
+    o.pos = float4(ndc * w, 0.0, w);
+    o.pos.y = -o.pos.y;
+    return o;
+}

+static void x_DeleteRenderbuffers(int n, const unsigned *ids) {
+    for (int i = 0; i < n; i++) {
+        Rb *r = T_rb.get(ids[i]);
+        if (r) { defer_release(r->res); r->res = nullptr; D->dsv.release(r->dsv); }

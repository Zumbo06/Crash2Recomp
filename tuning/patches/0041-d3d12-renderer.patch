+    {"glGetQueryObjectiv", (void *)x_GetQueryObjectiv},
+    {"glFenceSync", (void *)x_FenceSync},
+    {"glClientWaitSync", (void *)x_ClientWaitSync},
+    {"glDeleteSync", (void *)x_DeleteSync},
+    {"glMapBufferRange", (void *)x_MapBufferRange},
+    {"glUnmapBuffer", (void *)x_UnmapBuffer},

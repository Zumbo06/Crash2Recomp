+    float4 o1 = u_rt.xyxy * float4( 1.0, 0.0, 0.0,  1.0) + v_uv.xyxy;
+    float4 o2 = u_rt.xyxy * float4(-2.0, 0.0, 0.0, -2.0) + v_uv.xyxy;
+    const float3 W = float3(0.2126, 0.7152, 0.0722);
+    float Lc = L(v_uv);
+    float Ll = L(o0.xy);
+    float Lt = L(o0.zw);

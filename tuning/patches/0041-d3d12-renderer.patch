+    float3 ne = TEX(v_uv + float2( 1.0, -1.0) * u_texel).rgb;
+    float3 sw = TEX(v_uv + float2(-1.0,  1.0) * u_texel).rgb;
+    float3 se = TEX(v_uv + float2( 1.0,  1.0) * u_texel).rgb;
+    float4 m  = TEX(v_uv);
+    float lnw = dot(nw, W), lne = dot(ne, W), lsw = dot(sw, W), lse = dot(se, W);
+    float lm = dot(m.rgb, W);
+    float lmin = min(lm, min(min(lnw, lne), min(lsw, lse)));
+    float lmax = max(lm, max(max(lnw, lne), max(lsw, lse)));
+    if (lmax - lmin < max(0.0312, lmax * 0.125)) return m;

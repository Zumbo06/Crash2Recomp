+#define glFinish            gl12_Finish
+#define glFlush             gl12_Flush
+#define glGetError          gl12_GetError
+#define glGetIntegerv       gl12_GetIntegerv
+#define glGetString         gl12_GetString
+
+#undef  SDL_GL_GetProcAddress
+#define SDL_GL_GetProcAddress   gl12_GetProcAddress
+#undef  SDL_GL_CreateContext
+#define SDL_GL_CreateContext(w) ((SDL_GLContext)gl12_CreateContext(w))
+#undef  SDL_GL_MakeCurrent
+#define SDL_GL_MakeCurrent(w, c) gl12_MakeCurrent((w), (void *)(c))
+#undef  SDL_GL_DeleteContext
+#define SDL_GL_DeleteContext(c) gl12_DeleteContext((void *)(c))
+#undef  SDL_GL_SetSwapInterval
+#define SDL_GL_SetSwapInterval  gl12_SetSwapInterval
+#undef  SDL_GL_SetAttribute
+#define SDL_GL_SetAttribute(a, v) gl12_SetAttribute((int)(a), (v))
+#undef  SDL_GL_SwapWindow
+#define SDL_GL_SwapWindow       gl12_SwapWindow
+#undef  SDL_GL_GetDrawableSize
+#define SDL_GL_GetDrawableSize  gl12_GetDrawableSize
+#endif
+
+#endif /* PSX_GPU_GL12_H */

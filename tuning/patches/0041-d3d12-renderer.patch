+/* gpu_gl12.h - the OpenGL subset gpu_gl_renderer.c uses, implemented on
+ * Direct3D 12 (gpu_gl12.cpp).
+ *
+ * The D3D12 renderer is not a second renderer. It is gpu_gl_renderer.c and
+ * gpu_gl_postfx.c compiled a second time (gpu_gl_renderer_d3d12.c) with
+ * PSX_GL_ON_D3D12 defined, so every GL call - the GL 1.1 entry points below,
+ * the modern ones fetched through SDL_GL_GetProcAddress, and the handful of
+ * SDL_GL_* context calls - lands here instead of in the GL driver. VRAM
+ * coherency, batching, the native-wide compositor, frame interpolation,
+ * hold-last, 24-bit FMV, the OSD and post-processing are therefore the same
+ * code on both APIs, and stay the same as the GL side changes: parity by
+ * construction. Only this layer and the shader translations are D3D12-specific.
+ *
+ * Conventions the layer keeps so the renderer's GL assumptions hold:
+ *   - Row r of a GL framebuffer (counted from the bottom, GL style) is row r
+ *     of the D3D12 resource. Vertex shaders negate clip-space y to match, so
+ *     viewports, scissors, blits, texel fetches, gl_FragCoord and readbacks
+ *     all use the same numbers on both APIs.
+ *   - Framebuffer 0 is an offscreen texture sized to the window, in the same
+ *     row convention; SwapWindow draws it into the swap chain flipped. That
+ *     makes "read the default framebuffer" (hold-last) an ordinary copy.
+ *   - GLSL is not compiled. Each GLSL source the renderer submits is matched by
+ *     hash to a hand-written HLSL translation (gpu_gl12_shaders.h); an unknown
+ *     source fails to compile, so a GLSL change that was not mirrored fails
+ *     renderer init cleanly - and the runtime falls back - instead of drawing
+ *     wrong. HLSL is compiled at startup through d3dcompiler_47.dll.
+ */
+#ifndef PSX_GPU_GL12_H
+#define PSX_GPU_GL12_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct SDL_Window;
+
+/* ---- GL 1.1 entry points ------------------------------------------------ */
+void          gl12_Viewport(int x, int y, int w, int h);
+void          gl12_Scissor(int x, int y, int w, int h);
+void          gl12_Enable(unsigned cap);
+void          gl12_Disable(unsigned cap);
+void          gl12_ClearColor(float r, float g, float b, float a);
+void          gl12_ClearStencil(int s);
+void          gl12_Clear(unsigned mask);
+void          gl12_ColorMask(unsigned char r, unsigned char g, unsigned char b, unsigned char a);
+void          gl12_StencilMask(unsigned mask);
+void          gl12_StencilFunc(unsigned func, int ref, unsigned mask);
+void          gl12_StencilOp(unsigned sfail, unsigned dpfail, unsigned dppass);
+void          gl12_BlendFunc(unsigned src, unsigned dst);
+void          gl12_LineWidth(float w);
+void          gl12_PixelStorei(unsigned pname, int param);
+void          gl12_GenTextures(int n, unsigned *out);
+void          gl12_DeleteTextures(int n, const unsigned *ids);
+void          gl12_BindTexture(unsigned target, unsigned id);
+void          gl12_TexParameteri(unsigned target, unsigned pname, int param);
+void          gl12_TexImage2D(unsigned target, int level, int internal, int w, int h,
+                              int border, unsigned fmt, unsigned type, const void *data);
+void          gl12_TexSubImage2D(unsigned target, int level, int x, int y, int w, int h,
+                                 unsigned fmt, unsigned type, const void *data);
+void          gl12_CopyTexSubImage2D(unsigned target, int level, int xoff, int yoff,
+                                     int x, int y, int w, int h);
+void          gl12_ReadPixels(int x, int y, int w, int h, unsigned fmt, unsigned type,
+                              void *out);
+void          gl12_ReadBuffer(unsigned mode);
+void          gl12_DrawArrays(unsigned mode, int first, int count);
+void          gl12_Finish(void);
+void          gl12_Flush(void);
+unsigned      gl12_GetError(void);
+void          gl12_GetIntegerv(unsigned pname, int *out);
+const unsigned char *gl12_GetString(unsigned name);
+
+/* ---- SDL_GL_* ------------------------------------------------------------ */
+void         *gl12_GetProcAddress(const char *name);
+void         *gl12_CreateContext(struct SDL_Window *win);
+int           gl12_MakeCurrent(struct SDL_Window *win, void *ctx);   /* 0 = ok */
+void          gl12_DeleteContext(void *ctx);
+int           gl12_SetSwapInterval(int interval);                    /* 0 = ok */
+int           gl12_SetAttribute(int attr, int value);

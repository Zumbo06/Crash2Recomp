+    float2 v_uv = i.v_uv;
+    float3 c = u_src.SampleLevel(u_src_smp, v_uv + u_texel * float2(-1.0, -1.0), 0).rgb
+             + u_src.SampleLevel(u_src_smp, v_uv + u_texel * float2( 1.0, -1.0), 0).rgb
+             + u_src.SampleLevel(u_src_smp, v_uv + u_texel * float2(-1.0,  1.0), 0).rgb
+             + u_src.SampleLevel(u_src_smp, v_uv + u_texel * float2( 1.0,  1.0), 0).rgb;
+    c *= 0.25; c *= c;
+    float th = u_threshold * u_threshold, knee = th * 0.5 + 1e-4;
+    float br = max(c.r, max(c.g, c.b));
+    float soft = clamp(br - th + knee, 0.0, 2.0 * knee);
+    soft = soft * soft / (4.0 * knee);
+    return float4(c * (max(soft, br - th) / max(br, 1e-4)), 1.0);

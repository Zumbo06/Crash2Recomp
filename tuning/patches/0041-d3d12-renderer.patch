+/* ---- device-level state ------------------------------------------------- */
+struct CpuHeap {
+    ID3D12DescriptorHeap *heap = nullptr;
+    UINT inc = 0;
+    D3D12_CPU_DESCRIPTOR_HANDLE base{};
+    std::vector<int> free_list;
+    int next = 0, cap = 0;
+    bool init(ID3D12Device *dev, D3D12_DESCRIPTOR_HEAP_TYPE t, int n) {
+        D3D12_DESCRIPTOR_HEAP_DESC d{};
+        d.Type = t; d.NumDescriptors = (UINT)n;
+        if (FAILED(dev->CreateDescriptorHeap(&d, IID_PPV_ARGS(&heap)))) return false;
+        inc = dev->GetDescriptorHandleIncrementSize(t);
+        base = heap->GetCPUDescriptorHandleForHeapStart();
+        cap = n;
+        return true;
+    }
+    int alloc() {
+        if (!free_list.empty()) { int s = free_list.back(); free_list.pop_back(); return s; }
+        return next < cap ? next++ : -1;
+    }
+    void release(int s) { if (s >= 0) free_list.push_back(s); }
+    D3D12_CPU_DESCRIPTOR_HANDLE at(int s) const {
+        D3D12_CPU_DESCRIPTOR_HANDLE h = base; h.ptr += (SIZE_T)s * inc; return h;
+    }
+};

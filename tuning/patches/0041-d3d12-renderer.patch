+"""Generate runtime/src/gpu_gl12_shaders.h: GLSL hash -> HLSL translation.
+
+The D3D12 renderer (gpu_gl12.cpp) receives the renderer's GLSL sources through
+glShaderSource and looks each one up here by the FNV-1a 64 hash of its exact
+text. Every GLSL program in gpu_gl_renderer.c and gpu_gl_postfx.c needs a
+hand-written NAME.hlsl next to this script. Run after changing either side:
+
+    python gen_gl12_shaders.py          regenerate the header
+    python gen_gl12_shaders.py --check  exit 1 if the header is stale
+
+A GLSL edit without a matching HLSL edit leaves a hash the table does not
+know; the D3D12 renderer then fails to initialise (and the runtime falls back)
+instead of drawing with a stale translation.
+"""
+from __future__ import annotations
+
+import re
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+SRC = HERE.parent
+OUT = SRC / "gpu_gl12_shaders.h"
+
+SOURCES = {
+    "gpu_gl_renderer.c": ["PRESENT_VS", "PRESENT_FS", "INTERP_FS", "GEO_VS", "GEO_FS",
+                          "TEX_VS", "TEX_FS", "BLIT_VS", "BLIT_FS", "PACK_VS",
+                          "PACK_FS", "STENCIL_FS"],
+    "gpu_gl_postfx.c": ["VS_ROWS", "VS_WINDOW", "FS_FXAA", "FS_CAS", "FS_SMAA_EDGE",
+                        "FS_SMAA_WEIGHTS", "FS_SMAA_BLEND", "FS_BLOOM_PRE",
+                        "FS_BLOOM_DOWN", "FS_BLOOM_UP", "FS_COMPOSITE"],
+}
+
+ESCAPES = {"n": "\n", "t": "\t", "r": "\r", "\\": "\\", "\"": "\"", "'": "'", "0": "\0",
+           "a": "\a", "b": "\b", "f": "\f", "v": "\v", "?": "?"}
+
+
+def c_string_initializer(text: str, name: str) -> str:
+    """The value of `static const char *NAME = "..." "...";` exactly as the
+    compiler builds it: adjacent literals joined, comments between them
+    skipped, escapes decoded."""
+    m = re.search(r"static\s+const\s+char\s*\*\s*" + re.escape(name) + r"\s*=", text)
+    if not m:
+        raise SystemExit(f"{name}: definition not found")
+    i = m.end()
+    out: list[str] = []
+    while i < len(text):
+        c = text[i]
+        if c.isspace():
+            i += 1
+        elif text.startswith("/*", i):
+            i = text.index("*/", i) + 2
+        elif text.startswith("//", i):
+            i = text.index("\n", i) + 1
+        elif c == '"':
+            i += 1
+            while text[i] != '"':
+                if text[i] == "\\":
+                    e = text[i + 1]
+                    if e in ESCAPES:
+                        out.append(ESCAPES[e])
+                        i += 2
+                    else:
+                        raise SystemExit(f"{name}: unsupported escape \\{e}")
+                else:
+                    out.append(text[i])
+                    i += 1
+            i += 1
+        elif c == ";":
+            return "".join(out)
+        else:
+            raise SystemExit(f"{name}: unexpected {c!r} in initializer")
+    raise SystemExit(f"{name}: unterminated initializer")
+
+
+def fnv1a64(data: bytes) -> int:
+    h = 1469598103934665603
+    for b in data:
+        h ^= b
+        h = (h * 1099511628211) & 0xFFFFFFFFFFFFFFFF
+    return h
+
+
+def c_literal(s: str) -> str:
+    lines = s.split("\n")
+    parts = []
+    for n, line in enumerate(lines):
+        if n == len(lines) - 1 and line == "":
+            break
+        esc = line.replace("\\", "\\\\").replace("\"", "\\\"")
+        parts.append(f'        "{esc}\\n"')
+    return "\n".join(parts) if parts else '        ""'
+
+
+def build() -> str:
+    entries = []
+    for fname, names in SOURCES.items():
+        text = (SRC / fname).read_text(encoding="utf-8")
+        for name in names:
+            glsl = c_string_initializer(text, name)
+            hlsl_path = HERE / f"{name}.hlsl"
+            if not hlsl_path.is_file():
+                raise SystemExit(f"{name}: missing {hlsl_path.name}")
+            hlsl = hlsl_path.read_text(encoding="utf-8").replace("\r\n", "\n")
+            stage = 0 if (name.endswith("_VS") or name.startswith("VS_")) else 1
+            entries.append((name, fnv1a64(glsl.encode("utf-8")), stage, hlsl))
+    body = []
+    for name, h, stage, hlsl in entries:
+        body.append(f'    {{ "{name}", 0x{h:016x}ull, {stage},\n{c_literal(hlsl)} }},')
+    return (
+        "/* gpu_gl12_shaders.h - generated by gl12_hlsl/gen_gl12_shaders.py; do not edit.\n"
+        " *\n"
+        " * HLSL translations of the renderer's GLSL, keyed by the FNV-1a 64 hash of\n"
+        " * the GLSL text (see gpu_gl12.h). stage: 0 vertex, 1 pixel. */\n"
+        "#ifndef PSX_GPU_GL12_SHADERS_H\n"
+        "#define PSX_GPU_GL12_SHADERS_H\n\n"
+        "#include <stddef.h>\n#include <stdint.h>\n\n"
+        "typedef struct {\n"
+        "    const char *name;\n"
+        "    uint64_t    glsl_hash;\n"
+        "    int         stage;\n"
+        "    const char *hlsl;\n"
+        "} Gl12ShaderDef;\n\n"
+        "static const Gl12ShaderDef GL12_SHADERS[] = {\n"
+        + "\n".join(body) +
+        "\n};\n\n"
+        "#define GL12_SHADER_COUNT (sizeof(GL12_SHADERS) / sizeof(GL12_SHADERS[0]))\n\n"
+        "#endif\n"
+    )
+
+
+def main() -> int:
+    header = build()
+    if "--check" in sys.argv:
+        current = OUT.read_text(encoding="utf-8") if OUT.is_file() else ""
+        if current != header:
+            print(f"{OUT.name} is stale: run gen_gl12_shaders.py")
+            return 1
+        print(f"{OUT.name} is up to date")
+        return 0
+    OUT.write_bytes(header.encode("utf-8"))
+    print(f"wrote {OUT} ({len(header)} bytes)")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

+        float aspect = u_size.x / max(u_size.y, 1.0);
+        float2 d = (v_uv - 0.5) * float2(aspect, 1.0);
+        float r = length(d) / length(float2(0.5 * aspect, 0.5));
+        c *= 1.0 - u_grade1.y * smoothstep(0.45, 1.0, r);
+    }
+    if (u_grade1.z > 0.0) {
+        float n = hash12(fc + u_seed) - 0.5;
+        c += n * u_grade1.z * 0.18 * (1.0 - 0.6 * clamp(dot(c, W), 0.0, 1.0));

+/* Fences. */
+static void *x_FenceSync(unsigned, unsigned) {
+    Sync *s = new Sync();
+    s->value = D->open ? D->fence_next : D->fence_submitted;
+    return s;
+}
+static unsigned x_ClientWaitSync(void *p, unsigned flags, uint64_t timeout_ns) {
+    Sync *s = (Sync *)p;
+    if (!s) return X_WAIT_FAILED;
+    if (s->value > D->fence_submitted && (flags & X_SYNC_FLUSH_COMMANDS_BIT)) submit();
+    if (D->fence->GetCompletedValue() >= s->value) return X_ALREADY_SIGNALED;
+    if (timeout_ns == 0) return X_TIMEOUT_EXPIRED;
+    if (s->value > D->fence_submitted) submit();
+    D->fence->SetEventOnCompletion(s->value, D->event);
+    DWORD ms = timeout_ns >= 0xFFFFFFFFull * 1000000ull ? INFINITE : (DWORD)(timeout_ns / 1000000ull);
+    DWORD r = WaitForSingleObject(D->event, ms);
+    return r == WAIT_OBJECT_0 ? X_CONDITION_SATISFIED : X_TIMEOUT_EXPIRED;
+}
+static void x_DeleteSync(void *p) { delete (Sync *)p; }

+/* ======================================================================== */
+/* ---- GL 1.1 entry points ----------------------------------------------- */
+/* ======================================================================== */
+void gl12_Viewport(int x, int y, int w, int h) { S.vp[0] = x; S.vp[1] = y; S.vp[2] = w; S.vp[3] = h; }
+void gl12_Scissor(int x, int y, int w, int h) { S.sc[0] = x; S.sc[1] = y; S.sc[2] = w; S.sc[3] = h; }
+void gl12_Enable(unsigned cap) {
+    if (cap == X_BLEND) S.blend = true;
+    else if (cap == X_SCISSOR_TEST) S.scissor = true;
+    else if (cap == X_STENCIL_TEST) S.stencil = true;
+}
+void gl12_Disable(unsigned cap) {
+    if (cap == X_BLEND) S.blend = false;
+    else if (cap == X_SCISSOR_TEST) S.scissor = false;
+    else if (cap == X_STENCIL_TEST) S.stencil = false;
+}
+void gl12_ClearColor(float r, float g, float b, float a) {
+    S.clear_color[0] = r; S.clear_color[1] = g; S.clear_color[2] = b; S.clear_color[3] = a;
+}
+void gl12_ClearStencil(int s) { S.clear_stencil = s; }
+void gl12_Clear(unsigned mask) {
+    if (!D) return;
+    Tex *ct = fbo_color(S.draw_fbo);
+    Rb *ds = fbo_ds(S.draw_fbo);
+    D3D12_RECT r;
+    if (S.scissor) {
+        r.left = std::max(0, S.sc[0]); r.top = std::max(0, S.sc[1]);
+        r.right = S.sc[0] + S.sc[2]; r.bottom = S.sc[1] + S.sc[3];
+    } else {
+        r.left = 0; r.top = 0; r.right = 1 << 16; r.bottom = 1 << 16;
+    }
+    open_list();
+    if ((mask & X_COLOR_BUFFER_BIT) && ct && ct->res) {
+        D3D12_RECT c = r;
+        c.right = std::min<LONG>(c.right, ct->w); c.bottom = std::min<LONG>(c.bottom, ct->h);
+        if (c.right > c.left && c.bottom > c.top) {
+            barrier(ct->res, ct->state, D3D12_RESOURCE_STATE_RENDER_TARGET);
+            D->cl->ClearRenderTargetView(D->rtv.at(tex_rtv(ct)), S.clear_color, 1, &c);
+            D->dirty = true;
+        }
+    }
+    if ((mask & X_STENCIL_BUFFER_BIT) && ds && ds->res) {
+        D3D12_RECT c = r;
+        c.right = std::min<LONG>(c.right, ds->w); c.bottom = std::min<LONG>(c.bottom, ds->h);
+        if (c.right > c.left && c.bottom > c.top) {
+            barrier(ds->res, ds->state, D3D12_RESOURCE_STATE_DEPTH_WRITE);
+            D->cl->ClearDepthStencilView(D->dsv.at(ds->dsv), D3D12_CLEAR_FLAG_STENCIL, 1.0f,
+                                         (UINT8)(S.clear_stencil & 0xFF), 1, &c);
+            D->dirty = true;
+        }
+    }
+}
+void gl12_ColorMask(unsigned char r, unsigned char g, unsigned char b, unsigned char a) {
+    S.cmask[0] = r != 0; S.cmask[1] = g != 0; S.cmask[2] = b != 0; S.cmask[3] = a != 0;
+}
+void gl12_StencilMask(unsigned mask) { S.swritemask = mask; }
+void gl12_StencilFunc(unsigned func, int ref, unsigned mask) { S.sfunc = func; S.sref = ref; S.sreadmask = mask; }
+void gl12_StencilOp(unsigned a, unsigned b, unsigned c) { S.sfail = a; S.sdpfail = b; S.sdppass = c; }
+void gl12_BlendFunc(unsigned src, unsigned dst) { S.bsrc = S.bsrca = src; S.bdst = S.bdsta = dst; }
+void gl12_LineWidth(float w) { S.line_width = w; }
+void gl12_PixelStorei(unsigned pname, int param) {
+    switch (pname) {
+    case X_UNPACK_ALIGNMENT: S.unpack_align = param; break;
+    case X_UNPACK_ROW_LENGTH: S.unpack_row = param; break;
+    case X_PACK_ALIGNMENT: S.pack_align = param; break;
+    case X_PACK_ROW_LENGTH: S.pack_row = param; break;
+    default: break;
+    }
+}
+void gl12_GenTextures(int n, unsigned *out) { for (int i = 0; i < n; i++) out[i] = T_tex.gen(); }
+void gl12_DeleteTextures(int n, const unsigned *ids) {
+    for (int i = 0; i < n; i++) {
+        Tex *t = T_tex.get(ids[i]);
+        if (t && D) tex_free(t);
+        for (unsigned &u : S.units) if (u == ids[i]) u = 0;
+        T_tex.del(ids[i]);
+    }
+}
+void gl12_BindTexture(unsigned, unsigned id) { S.units[S.unit] = id; }
+void gl12_TexParameteri(unsigned, unsigned pname, int param) {
+    Tex *t = T_tex.get(S.units[S.unit]);
+    if (!t) return;
+    if (pname == X_TEXTURE_MIN_FILTER) t->min_linear = param == (int)X_LINEAR;
+    else if (pname == X_TEXTURE_MAG_FILTER) t->mag_linear = param == (int)X_LINEAR;
+}
+void gl12_TexImage2D(unsigned, int, int internal, int w, int h, int, unsigned fmt, unsigned type,
+                     const void *data) {
+    Tex *t = T_tex.get(S.units[S.unit]);
+    if (!t || !D) { set_error(X_INVALID_OPERATION); return; }
+    const FmtInfo fi = fmt_for_internal(internal, fmt);
+    if (fi.dxgi == DXGI_FORMAT_UNKNOWN) { set_error(X_INVALID_ENUM); return; }
+    if (!(t->res && t->w == w && t->h == h && t->fmt == fi.dxgi)) {
+        if (!tex_alloc(t, w, h, fi.dxgi, fi.is_int)) return;
+    }
+    if (data) tex_upload(t, 0, 0, w, h, fmt, type, data);
+}
+void gl12_TexSubImage2D(unsigned, int, int x, int y, int w, int h, unsigned fmt, unsigned type,
+                        const void *data) {
+    Tex *t = T_tex.get(S.units[S.unit]);
+    if (!t || !t->res || !D) { set_error(X_INVALID_OPERATION); return; }
+    tex_upload(t, x, y, w, h, fmt, type, data);
+}
+void gl12_CopyTexSubImage2D(unsigned, int, int xoff, int yoff, int x, int y, int w, int h) {
+    Tex *dst = T_tex.get(S.units[S.unit]);
+    Tex *src = D ? fbo_color(S.read_fbo) : nullptr;
+    if (!dst || !dst->res || !src || !src->res || dst == src) { set_error(X_INVALID_OPERATION); return; }
+    if (x < 0) { xoff -= x; w += x; x = 0; }
+    if (y < 0) { yoff -= y; h += y; y = 0; }
+    w = std::min(w, std::min(src->w - x, dst->w - xoff));
+    h = std::min(h, std::min(src->h - y, dst->h - yoff));
+    if (w <= 0 || h <= 0 || src->fmt != dst->fmt) return;
+    open_list();
+    barrier(src->res, src->state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    barrier(dst->res, dst->state, D3D12_RESOURCE_STATE_COPY_DEST);
+    D3D12_TEXTURE_COPY_LOCATION d{}, s{};
+    d.pResource = dst->res; d.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    s.pResource = src->res; s.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_BOX box{(UINT)x, (UINT)y, 0, (UINT)(x + w), (UINT)(y + h), 1};
+    D->cl->CopyTextureRegion(&d, (UINT)xoff, (UINT)yoff, 0, &s, &box);
+    D->dirty = true;
+}
+void gl12_ReadPixels(int x, int y, int w, int h, unsigned fmt, unsigned type, void *out) {
+    if (!D || w <= 0 || h <= 0) return;
+    Tex *src = fbo_color(S.read_fbo);
+    if (!src || !src->res) { set_error(X_INVALID_OPERATION); return; }
+    if (x < 0 || y < 0 || x + w > src->w || y + h > src->h) { set_error(X_INVALID_VALUE); return; }
+    if (S.pack_buffer) {
+        Buf *b = T_buf.get(S.pack_buffer);
+        if (!b) { set_error(X_INVALID_OPERATION); return; }
+        b->rb_pitch = record_readback(src, x, y, w, h, &b->rb, &b->rb_size);
+        b->rb_w = w; b->rb_h = h; b->rb_src = src->fmt; b->rb_fmt = fmt; b->rb_type = type;
+        b->rb_fence = D->fence_next;
+        b->rb_pending = true;
+        return;
+    }
+    const UINT pitch = record_readback(src, x, y, w, h, &D->rb_tmp, &D->rb_tmp_size);
+    if (!pitch) return;
+    finish();
+    void *p = nullptr;
+    D3D12_RANGE r{0, D->rb_tmp_size};
+    if (FAILED(D->rb_tmp->Map(0, &r, &p))) return;
+    unpack_rows((const uint8_t *)p, pitch, src->fmt, w, h, fmt, type, (uint8_t *)out);
+    D3D12_RANGE none{0, 0};
+    D->rb_tmp->Unmap(0, &none);
+}
+void gl12_ReadBuffer(unsigned) {}
+void gl12_DrawArrays(unsigned mode, int first, int count) { if (D) draw(mode, first, count); }
+void gl12_Finish(void) { if (D) finish(); }
+void gl12_Flush(void) { if (D) submit(); }
+unsigned gl12_GetError(void) { unsigned e = g_gl_error; g_gl_error = X_NO_ERROR; return e; }
+void gl12_GetIntegerv(unsigned pname, int *out) {
+    if (!out) return;
+    if (pname == X_MAX_TEXTURE_SIZE || pname == X_MAX_RENDERBUFFER_SIZE) *out = 16384;
+    else *out = 0;
+}
+const unsigned char *gl12_GetString(unsigned name) {
+    static char version[256];
+    if (name == X_VERSION) {
+        std::snprintf(version, sizeof(version), "Direct3D 12 (psxrecomp gl12)");
+        return (const unsigned char *)version;
+    }
+    if (name == X_RENDERER) return (const unsigned char *)"Direct3D 12";
+    if (name == X_VENDOR) return (const unsigned char *)"psxrecomp";
+    return (const unsigned char *)"";
+}

+/* gpu_gl12.cpp - the OpenGL subset the renderer uses, on Direct3D 12.
+ * See gpu_gl12.h for why this exists and the conventions it keeps.
+ *
+ * One device, one direct queue, one command list recording at a time. Work is
+ * submitted at SwapWindow, glFlush/glFinish, and whenever the CPU needs a
+ * result (glReadPixels into client memory, a mapped pixel-pack buffer, a query
+ * result, glClientWaitSync with the flush bit) - the same points a GL driver
+ * would flush at. Upload memory, shader-visible descriptors and deleted
+ * resources are recycled by fence, so nothing the GPU may still read is
+ * reused early.
+ *
+ * GL objects are small structs in handle tables indexed by their GL name.
+ * Pipeline state objects are built on demand from the GL state at draw time
+ * and cached. Every texture has one tracked resource state; transitions are
+ * issued immediately before the operation that needs them.
+ *
+ * Built by MinGW clang: WIDL_EXPLICIT_AGGREGATE_RETURNS selects the correct
+ * ABI for the COM methods that return structs by value. */
+
+#define PSX_GL12_IMPL 1
+#define WIDL_EXPLICIT_AGGREGATE_RETURNS 1
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN 1
+#endif

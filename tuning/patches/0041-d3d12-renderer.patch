+/* ---- fences and submission ---------------------------------------------- */
+void wait_value(uint64_t v) {
+    if (!D || !v) return;
+    if (D->fence->GetCompletedValue() >= v) return;
+    D->fence->SetEventOnCompletion(v, D->event);
+    WaitForSingleObject(D->event, INFINITE);
+}
+
+void recycle() {
+    const uint64_t done = D->fence->GetCompletedValue();
+    for (size_t i = 0; i < D->chunk_pending.size();) {
+        Chunk *c = D->chunk_pending[i];
+        if (c->fence <= done) {
+            c->used = 0;
+            D->chunk_free.push_back(c);
+            D->chunk_pending.erase(D->chunk_pending.begin() + (long)i);
+        } else i++;
+    }
+    for (size_t i = 0; i < D->desc_pending.size();) {
+        if (D->desc_pending[i].first <= done) {
+            D->desc_free.push_back(D->desc_pending[i].second);
+            D->desc_pending.erase(D->desc_pending.begin() + (long)i);
+        } else i++;
+    }
+    for (size_t i = 0; i < D->dead.size();) {
+        if (D->dead[i].first <= done) {
+            D->dead[i].second->Release();
+            D->dead.erase(D->dead.begin() + (long)i);
+        } else i++;
+    }
+}
+
+/* Release a resource once every submission that could use it has finished. */
+void defer_release(IUnknown *u) {
+    if (!u) return;
+    D->dead.push_back({D->fence_next, u});
+}
+
+void open_list() {
+    if (D->open) return;
+    D->alloc_cur = (D->alloc_cur + 1) % GL12_ALLOCATORS;
+    wait_value(D->alloc_fence[D->alloc_cur]);
+    recycle();
+    D->alloc[D->alloc_cur]->Reset();
+    D->cl->Reset(D->alloc[D->alloc_cur], nullptr);
+    ID3D12DescriptorHeap *heaps[2] = {D->gsrv, D->gsmp};
+    D->cl->SetDescriptorHeaps(2, heaps);
+    D->cl->SetGraphicsRootSignature(D->root);
+    D->open = true;
+    D->dirty = false;
+}
+
+void print_debug_messages() {
+    if (!D->iq) return;
+    const UINT64 n = D->iq->GetNumStoredMessages();
+    for (UINT64 i = 0; i < n; i++) {
+        SIZE_T len = 0;
+        if (FAILED(D->iq->GetMessage(i, nullptr, &len)) || len == 0) continue;
+        std::vector<uint8_t> buf(len);
+        D3D12_MESSAGE *m = (D3D12_MESSAGE *)buf.data();
+        if (SUCCEEDED(D->iq->GetMessage(i, m, &len)))
+            logf("debug layer (severity %d, id %d): %s", (int)m->Severity, (int)m->ID,
+                 m->pDescription ? m->pDescription : "");
+    }
+    D->iq->ClearStoredMessages();
+}
+
+/* Close and execute the open list. Returns the fence value it signals. */
+uint64_t submit() {
+    if (!D->open) return D->fence_submitted;
+    D->cl->Close();
+    ID3D12CommandList *lists[1] = {D->cl};
+    D->queue->ExecuteCommandLists(1, lists);
+    const uint64_t v = D->fence_next++;
+    D->queue->Signal(D->fence, v);
+    D->alloc_fence[D->alloc_cur] = v;
+    D->fence_submitted = v;
+    for (Chunk *c : D->chunk_now) { c->fence = v; D->chunk_pending.push_back(c); }
+    D->chunk_now.clear();
+    for (int b : D->desc_blocks_now) D->desc_pending.push_back({v, b});
+    D->desc_blocks_now.clear();
+    D->desc_block = -1;
+    D->open = false;
+    print_debug_messages();
+    return v;
+}
+
+void finish() {
+    submit();
+    wait_value(D->fence_submitted);
+    recycle();
+}
+
+/* ---- upload memory ------------------------------------------------------ */
+Upload upload_alloc(size_t size, size_t align) {
+    Chunk *c = D->chunk_now.empty() ? nullptr : D->chunk_now.back();
+    size_t off = c ? align_up(c->used, align) : 0;
+    if (!c || off + size > c->size) {
+        c = nullptr;
+        for (size_t i = 0; i < D->chunk_free.size(); i++) {
+            if (D->chunk_free[i]->size >= size) {
+                c = D->chunk_free[i];
+                D->chunk_free.erase(D->chunk_free.begin() + (long)i);
+                break;
+            }
+        }
+        if (!c) {
+            c = new Chunk();
+            c->size = std::max<size_t>(GL12_CHUNK, align_up(size, 65536));
+            D3D12_HEAP_PROPERTIES hp{}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+            D3D12_RESOURCE_DESC rd{};
+            rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+            rd.Width = c->size; rd.Height = 1; rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+            rd.SampleDesc.Count = 1; rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+            HRESULT hr = D->dev->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &rd,
+                D3D12_RESOURCE_STATE_GENERIC_READ, nullptr, IID_PPV_ARGS(&c->res));
+            if (FAILED(hr)) { fail_text("upload heap allocation failed", hr); delete c; return Upload{nullptr, 0, nullptr, 0}; }
+            D3D12_RANGE none{0, 0};
+            c->res->Map(0, &none, (void **)&c->cpu);
+            c->gpu = c->res->GetGPUVirtualAddress();
+        }
+        c->used = 0;
+        D->chunk_now.push_back(c);
+        off = 0;
+    }
+    c->used = off + size;
+    return Upload{c->cpu + off, c->gpu + off, c->res, off};
+}
+
+/* ---- shader-visible descriptors ----------------------------------------- */
+int gpu_desc_alloc(int n) {
+    if (D->desc_block < 0 || D->desc_used + n > GL12_DESC_BLOCK) {
+        if (D->desc_free.empty()) {
+            recycle();
+            if (D->desc_free.empty()) {
+                /* Every block is still in flight: drain and try again. */
+                finish();
+                open_list();
+            }
+        }
+        if (D->desc_free.empty()) return -1;
+        D->desc_block = D->desc_free.back();
+        D->desc_free.pop_back();
+        D->desc_blocks_now.push_back(D->desc_block);
+        D->desc_used = 0;
+    }
+    int idx = D->desc_block * GL12_DESC_BLOCK + D->desc_used;
+    D->desc_used += n;
+    return idx;
+}
+
+/* ---- resource states ---------------------------------------------------- */
+void barrier(ID3D12Resource *r, D3D12_RESOURCE_STATES &cur, D3D12_RESOURCE_STATES want) {
+    if (!r || cur == want) return;
+    D3D12_RESOURCE_BARRIER b{};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = r;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = cur;
+    b.Transition.StateAfter = want;
+    D->cl->ResourceBarrier(1, &b);
+    cur = want;
+}
+
+const D3D12_RESOURCE_STATES SRV_STATE =
+    (D3D12_RESOURCE_STATES)(D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE |
+                            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+
+/* ---- formats ------------------------------------------------------------ */
+struct FmtInfo { DXGI_FORMAT dxgi; int bpp; bool is_int; };
+
+FmtInfo fmt_for_internal(int internal, unsigned fmt) {
+    switch ((unsigned)internal) {
+    case X_RGBA8: case X_RGBA: return {DXGI_FORMAT_R8G8B8A8_UNORM, 4, false};
+    case X_R16UI: return {DXGI_FORMAT_R16_UINT, 2, true};
+    case X_RG8: case X_RG: return {DXGI_FORMAT_R8G8_UNORM, 2, false};
+    case X_R8: case X_RED: return {DXGI_FORMAT_R8_UNORM, 1, false};
+    case X_RGBA16F: return {DXGI_FORMAT_R16G16B16A16_FLOAT, 8, false};
+    default: break;
+    }
+    (void)fmt;
+    return {DXGI_FORMAT_UNKNOWN, 0, false};
+}
+
+int dxgi_bpp(DXGI_FORMAT f) {
+    switch (f) {
+    case DXGI_FORMAT_R8G8B8A8_UNORM: return 4;
+    case DXGI_FORMAT_R16_UINT: return 2;
+    case DXGI_FORMAT_R8G8_UNORM: return 2;
+    case DXGI_FORMAT_R8_UNORM: return 1;
+    case DXGI_FORMAT_R16G16B16A16_FLOAT: return 8;
+    default: return 4;
+    }
+}
+
+/* Bytes per pixel of client-side data in a GL format/type. */
+int client_bpp(unsigned fmt, unsigned type) {
+    int comps = 4;
+    switch (fmt) {
+    case X_RED: case X_RED_INTEGER: comps = 1; break;
+    case X_RG: comps = 2; break;
+    case X_RGB: comps = 3; break;
+    default: comps = 4; break;
+    }
+    int size = (type == X_UNSIGNED_SHORT || type == X_HALF_FLOAT) ? 2 : (type == X_FLOAT ? 4 : 1);
+    return comps * size;
+}
+
+/* ---- textures ----------------------------------------------------------- */
+void tex_free(Tex *t) {
+    if (!t) return;
+    if (t->res) defer_release(t->res);
+    t->res = nullptr;
+    if (t->srv >= 0) { D->srv.release(t->srv); t->srv = -1; }
+    if (t->rtv >= 0) { D->rtv.release(t->rtv); t->rtv = -1; }
+    t->w = t->h = 0;
+}
+
+bool tex_alloc(Tex *t, int w, int h, DXGI_FORMAT fmt, bool is_int) {
+    tex_free(t);
+    if (w <= 0 || h <= 0 || w > 16384 || h > 16384) { set_error(X_INVALID_VALUE); return false; }
+    D3D12_HEAP_PROPERTIES hp{}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd{};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    rd.Width = (UINT64)w; rd.Height = (UINT)h; rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+    rd.Format = fmt; rd.SampleDesc.Count = 1; rd.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    HRESULT hr = D->dev->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &rd,
+        D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(&t->res));
+    if (FAILED(hr)) { set_error(X_OUT_OF_MEMORY); fail_text("texture allocation failed", hr); t->res = nullptr; return false; }
+    t->state = D3D12_RESOURCE_STATE_COMMON;
+    t->fmt = fmt; t->w = w; t->h = h; t->is_int = is_int;
+    t->srv = D->srv.alloc();
+    D3D12_SHADER_RESOURCE_VIEW_DESC sd{};
+    sd.Format = fmt;
+    sd.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sd.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    sd.Texture2D.MipLevels = 1;
+    D->dev->CreateShaderResourceView(t->res, &sd, D->srv.at(t->srv));
+    return true;
+}
+
+int tex_rtv(Tex *t) {
+    if (t->rtv >= 0) return t->rtv;
+    t->rtv = D->rtv.alloc();
+    D->dev->CreateRenderTargetView(t->res, nullptr, D->rtv.at(t->rtv));
+    return t->rtv;
+}
+
+/* Copy client rows into a texture region through the upload heap. */
+void tex_upload(Tex *t, int x, int y, int w, int h, unsigned fmt, unsigned type, const void *data) {
+    if (!t || !t->res || !data || w <= 0 || h <= 0) return;
+    if (x < 0 || y < 0 || x + w > t->w || y + h > t->h) { set_error(X_INVALID_VALUE); return; }
+    const int dbpp = dxgi_bpp(t->fmt);
+    const int sbpp = client_bpp(fmt, type);
+    const size_t srow_px = S.unpack_row > 0 ? (size_t)S.unpack_row : (size_t)w;
+    const size_t sstride = align_up(srow_px * (size_t)sbpp, (size_t)std::max(1, S.unpack_align));
+    const UINT pitch = (UINT)align_up((size_t)w * dbpp, D3D12_TEXTURE_DATA_PITCH_ALIGNMENT);
+    open_list();
+    Upload u = upload_alloc((size_t)pitch * h, D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT);
+    if (!u.cpu) return;
+    const uint8_t *src = (const uint8_t *)data;
+    const bool swizzle = (fmt == X_BGRA && t->fmt == DXGI_FORMAT_R8G8B8A8_UNORM);
+    for (int row = 0; row < h; row++) {
+        const uint8_t *s = src + (size_t)row * sstride;
+        uint8_t *d = u.cpu + (size_t)row * pitch;
+        if (swizzle) {
+            for (int i = 0; i < w; i++) {
+                d[i * 4 + 0] = s[i * 4 + 2];
+                d[i * 4 + 1] = s[i * 4 + 1];
+                d[i * 4 + 2] = s[i * 4 + 0];
+                d[i * 4 + 3] = s[i * 4 + 3];
+            }
+        } else if (sbpp == dbpp) {
+            std::memcpy(d, s, (size_t)w * dbpp);
+        } else {
+            std::memset(d, 0, (size_t)w * dbpp);
+        }
+    }
+    barrier(t->res, t->state, D3D12_RESOURCE_STATE_COPY_DEST);
+    D3D12_TEXTURE_COPY_LOCATION dst{}, srcl{};
+    dst.pResource = t->res; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX; dst.SubresourceIndex = 0;
+    srcl.pResource = u.res; srcl.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    srcl.PlacedFootprint.Offset = u.offset;
+    srcl.PlacedFootprint.Footprint.Format = t->fmt;
+    srcl.PlacedFootprint.Footprint.Width = (UINT)w;
+    srcl.PlacedFootprint.Footprint.Height = (UINT)h;
+    srcl.PlacedFootprint.Footprint.Depth = 1;
+    srcl.PlacedFootprint.Footprint.RowPitch = pitch;
+    D->cl->CopyTextureRegion(&dst, (UINT)x, (UINT)y, 0, &srcl, nullptr);
+    D->dirty = true;
+}
+
+/* ---- framebuffers ------------------------------------------------------- */
+Tex *fbo_color(unsigned fbo) {
+    if (fbo == 0) return &D->fb0;
+    Fbo *f = T_fbo.get(fbo);
+    return f ? T_tex.get(f->color) : nullptr;
+}
+
+Rb *fbo_ds(unsigned fbo) {
+    if (fbo == 0) return nullptr;
+    Fbo *f = T_fbo.get(fbo);
+    return f ? T_rb.get(f->ds) : nullptr;
+}
+
+void fb0_ensure(int w, int h) {
+    if (w < 1) w = 1;
+    if (h < 1) h = 1;
+    if (D->fb0.res && D->fb0.w == w && D->fb0.h == h) return;
+    tex_alloc(&D->fb0, w, h, DXGI_FORMAT_R8G8B8A8_UNORM, false);
+}
+
+/* ---- readback ----------------------------------------------------------- */
+/* Record a copy of (x,y,w,h) of src into a readback resource; returns pitch. */
+UINT record_readback(Tex *src, int x, int y, int w, int h, ID3D12Resource **rb, size_t *rb_size) {
+    const int bpp = dxgi_bpp(src->fmt);
+    const UINT pitch = (UINT)align_up((size_t)w * bpp, D3D12_TEXTURE_DATA_PITCH_ALIGNMENT);
+    const size_t need = (size_t)pitch * h;
+    if (!*rb || *rb_size < need) {
+        if (*rb) defer_release(*rb);
+        *rb = nullptr;
+        D3D12_HEAP_PROPERTIES hp{}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC rd{};
+        rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        rd.Width = need; rd.Height = 1; rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+        rd.SampleDesc.Count = 1; rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        HRESULT hr = D->dev->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &rd,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(rb));
+        if (FAILED(hr)) { fail_text("readback allocation failed", hr); *rb = nullptr; return 0; }
+        *rb_size = need;
+    }
+    open_list();
+    barrier(src->res, src->state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    D3D12_TEXTURE_COPY_LOCATION dst{}, s{};
+    dst.pResource = *rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Offset = 0;
+    dst.PlacedFootprint.Footprint.Format = src->fmt;
+    dst.PlacedFootprint.Footprint.Width = (UINT)w;
+    dst.PlacedFootprint.Footprint.Height = (UINT)h;
+    dst.PlacedFootprint.Footprint.Depth = 1;
+    dst.PlacedFootprint.Footprint.RowPitch = pitch;
+    s.pResource = src->res; s.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX; s.SubresourceIndex = 0;
+    D3D12_BOX box{(UINT)x, (UINT)y, 0, (UINT)(x + w), (UINT)(y + h), 1};
+    D->cl->CopyTextureRegion(&dst, 0, 0, 0, &s, &box);
+    D->dirty = true;
+    return pitch;
+}
+
+/* Convert mapped readback rows to GL client layout. */
+void unpack_rows(const uint8_t *src, UINT pitch, DXGI_FORMAT sf, int w, int h,
+                 unsigned fmt, unsigned type, uint8_t *out) {
+    const int dbpp = client_bpp(fmt, type);
+    const size_t row_px = S.pack_row > 0 ? (size_t)S.pack_row : (size_t)w;
+    const size_t stride = align_up(row_px * (size_t)dbpp, (size_t)std::max(1, S.pack_align));
+    const int sbpp = dxgi_bpp(sf);
+    for (int row = 0; row < h; row++) {
+        const uint8_t *s = src + (size_t)row * pitch;
+        uint8_t *d = out + (size_t)row * stride;
+        if (sf == DXGI_FORMAT_R8G8B8A8_UNORM && fmt == X_BGRA) {
+            for (int i = 0; i < w; i++) {
+                d[i * 4 + 0] = s[i * 4 + 2]; d[i * 4 + 1] = s[i * 4 + 1];
+                d[i * 4 + 2] = s[i * 4 + 0]; d[i * 4 + 3] = s[i * 4 + 3];
+            }
+        } else if (sf == DXGI_FORMAT_R8G8B8A8_UNORM && fmt == X_RGB) {
+            for (int i = 0; i < w; i++) {
+                d[i * 3 + 0] = s[i * 4 + 0]; d[i * 3 + 1] = s[i * 4 + 1]; d[i * 3 + 2] = s[i * 4 + 2];
+            }
+        } else {
+            std::memcpy(d, s, (size_t)w * (size_t)std::min(sbpp, dbpp));
+        }
+    }
+}
+
+/* ---- shaders ------------------------------------------------------------ */
+const Gl12ShaderDef *find_def(const std::string &src, unsigned type) {
+    const uint64_t h = fnv1a(src.data(), src.size());
+    for (size_t i = 0; i < GL12_SHADER_COUNT; i++) {
+        const Gl12ShaderDef &d = GL12_SHADERS[i];
+        if (d.glsl_hash == h && d.stage == (type == X_VERTEX_SHADER ? 0 : 1)) return &d;
+    }
+    return nullptr;
+}
+
+std::unordered_map<std::string, ID3DBlob *> g_blobs;
+
+ID3DBlob *compile_hlsl(const char *name, const char *src, const char *profile) {
+    const std::string key = std::string(name) + "|" + profile;
+    auto it = g_blobs.find(key);
+    if (it != g_blobs.end()) return it->second;
+    const uint64_t h = fnv1a(src, std::strlen(src), fnv1a(profile, std::strlen(profile)));
+    char path[1024] = {0};
+    if (!D->cache_dir.empty())
+        std::snprintf(path, sizeof(path), "%sgl12_%s_%016llx.dxbc", D->cache_dir.c_str(), name,
+                      (unsigned long long)h);
+    ID3DBlob *blob = nullptr;
+    if (path[0]) {
+        if (FILE *f = std::fopen(path, "rb")) {
+            std::fseek(f, 0, SEEK_END);
+            const long n = std::ftell(f);
+            std::fseek(f, 0, SEEK_SET);
+            if (n > 0 && SUCCEEDED(D->create_blob((SIZE_T)n, &blob))) {
+                if (std::fread(blob->GetBufferPointer(), 1, (size_t)n, f) != (size_t)n) rel(blob);
+            }
+            std::fclose(f);
+        }
+    }
+    if (!blob) {
+        ID3DBlob *errs = nullptr;
+        HRESULT hr = D->compile(src, std::strlen(src), name, nullptr, nullptr, "main", profile,
+                                D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &blob, &errs);
+        if (FAILED(hr)) {
+            logf("HLSL %s (%s) failed: %s", name, profile,
+                 errs ? (const char *)errs->GetBufferPointer() : "?");
+            rel(errs);
+            return nullptr;
+        }
+        rel(errs);
+        if (path[0]) {
+            if (FILE *f = std::fopen(path, "wb")) {
+                std::fwrite(blob->GetBufferPointer(), 1, blob->GetBufferSize(), f);
+                std::fclose(f);
+            }
+        }
+    }
+    g_blobs[key] = blob;
+    return blob;
+}
+
+bool reflect_stage(Program *p, ID3DBlob *b, int stage) {
+    ID3D12ShaderReflection *r = nullptr;
+    if (FAILED(D->reflect(b->GetBufferPointer(), b->GetBufferSize(), IID_ID3D12ShaderReflection,
+                          (void **)&r)))
+        return false;
+    D3D12_SHADER_DESC sd{};
+    r->GetDesc(&sd);
+    for (UINT i = 0; i < sd.ConstantBuffers; i++) {
+        ID3D12ShaderReflectionConstantBuffer *cb = r->GetConstantBufferByIndex(i);
+        D3D12_SHADER_BUFFER_DESC bd{};
+        cb->GetDesc(&bd);
+        if (bd.Type != D3D_CT_CBUFFER) continue;
+        std::vector<uint8_t> &img = stage == 0 ? p->vcb : p->pcb;
+        img.assign(align_up(bd.Size, 256), 0);
+        for (UINT v = 0; v < bd.Variables; v++) {
+            D3D12_SHADER_VARIABLE_DESC vd{};
+            cb->GetVariableByIndex(v)->GetDesc(&vd);
+            Uni *u = nullptr;
+            for (Uni &x : p->unis) if (x.name == vd.Name) u = &x;
+            if (!u) { p->unis.push_back(Uni()); u = &p->unis.back(); u->name = vd.Name; }
+            if (stage == 0) { u->vs_off = (int)vd.StartOffset; u->vs_size = (int)vd.Size; }
+            else            { u->ps_off = (int)vd.StartOffset; u->ps_size = (int)vd.Size; }
+        }
+    }
+    for (UINT i = 0; i < sd.BoundResources; i++) {
+        D3D12_SHADER_INPUT_BIND_DESC bd{};
+        r->GetResourceBindingDesc(i, &bd);
+        if (bd.Type != D3D_SIT_TEXTURE || bd.BindPoint >= 4) continue;
+        Uni *u = nullptr;
+        for (Uni &x : p->unis) if (x.name == bd.Name) u = &x;
+        if (!u) { p->unis.push_back(Uni()); u = &p->unis.back(); u->name = bd.Name; }
+        u->slot = (int)bd.BindPoint;
+        p->slot_used |= 1u << bd.BindPoint;
+    }
+    r->Release();
+    return true;
+}
+
+void write_uniform(Program *p, int loc, const void *data, int bytes) {
+    if (!p || loc < 0 || loc >= (int)p->unis.size()) return;
+    Uni &u = p->unis[(size_t)loc];
+    if (u.vs_off >= 0 && (size_t)u.vs_off + (size_t)bytes <= p->vcb.size())
+        std::memcpy(&p->vcb[(size_t)u.vs_off], data, (size_t)std::min(bytes, u.vs_size));
+    if (u.ps_off >= 0 && (size_t)u.ps_off + (size_t)bytes <= p->pcb.size())
+        std::memcpy(&p->pcb[(size_t)u.ps_off], data, (size_t)std::min(bytes, u.ps_size));
+}
+
+/* ---- pipeline states ---------------------------------------------------- */
+D3D12_BLEND blend_factor(unsigned f, bool alpha) {
+    switch (f) {
+    case X_ZERO: return D3D12_BLEND_ZERO;
+    case X_ONE: return D3D12_BLEND_ONE;
+    case X_SRC_COLOR: return alpha ? D3D12_BLEND_SRC_ALPHA : D3D12_BLEND_SRC_COLOR;
+    case X_ONE_MINUS_SRC_COLOR: return alpha ? D3D12_BLEND_INV_SRC_ALPHA : D3D12_BLEND_INV_SRC_COLOR;
+    case X_SRC_ALPHA: return D3D12_BLEND_SRC_ALPHA;
+    case X_ONE_MINUS_SRC_ALPHA: return D3D12_BLEND_INV_SRC_ALPHA;
+    case X_DST_ALPHA: return D3D12_BLEND_DEST_ALPHA;
+    case X_ONE_MINUS_DST_ALPHA: return D3D12_BLEND_INV_DEST_ALPHA;
+    case X_DST_COLOR: return alpha ? D3D12_BLEND_DEST_ALPHA : D3D12_BLEND_DEST_COLOR;
+    case X_ONE_MINUS_DST_COLOR: return alpha ? D3D12_BLEND_INV_DEST_ALPHA : D3D12_BLEND_INV_DEST_COLOR;
+    case X_CONSTANT_COLOR: case X_CONSTANT_ALPHA: return D3D12_BLEND_BLEND_FACTOR;
+    case X_ONE_MINUS_CONSTANT_COLOR: case X_ONE_MINUS_CONSTANT_ALPHA: return D3D12_BLEND_INV_BLEND_FACTOR;
+    case X_SRC1_ALPHA: return D3D12_BLEND_SRC1_ALPHA;
+    case X_SRC1_COLOR: return alpha ? D3D12_BLEND_SRC1_ALPHA : D3D12_BLEND_SRC1_COLOR;
+    default: return D3D12_BLEND_ONE;
+    }
+}
+
+D3D12_BLEND_OP blend_op(unsigned e) {
+    switch (e) {
+    case X_FUNC_SUBTRACT: return D3D12_BLEND_OP_SUBTRACT;
+    case X_FUNC_REVERSE_SUBTRACT: return D3D12_BLEND_OP_REV_SUBTRACT;
+    case X_MIN: return D3D12_BLEND_OP_MIN;
+    case X_MAX: return D3D12_BLEND_OP_MAX;
+    default: return D3D12_BLEND_OP_ADD;
+    }
+}
+
+D3D12_COMPARISON_FUNC cmp_func(unsigned f) {
+    switch (f) {
+    case X_NEVER: return D3D12_COMPARISON_FUNC_NEVER;
+    case X_LESS: return D3D12_COMPARISON_FUNC_LESS;
+    case X_EQUAL: return D3D12_COMPARISON_FUNC_EQUAL;
+    case X_LEQUAL: return D3D12_COMPARISON_FUNC_LESS_EQUAL;
+    case X_GREATER: return D3D12_COMPARISON_FUNC_GREATER;
+    case X_NOTEQUAL: return D3D12_COMPARISON_FUNC_NOT_EQUAL;
+    case X_GEQUAL: return D3D12_COMPARISON_FUNC_GREATER_EQUAL;
+    default: return D3D12_COMPARISON_FUNC_ALWAYS;
+    }
+}
+
+D3D12_STENCIL_OP stencil_op(unsigned o) {
+    switch (o) {
+    case X_ZERO: return D3D12_STENCIL_OP_ZERO;
+    case X_REPLACE: return D3D12_STENCIL_OP_REPLACE;
+    case X_INCR: return D3D12_STENCIL_OP_INCR_SAT;
+    case X_DECR: return D3D12_STENCIL_OP_DECR_SAT;
+    case X_INVERT: return D3D12_STENCIL_OP_INVERT;
+    default: return D3D12_STENCIL_OP_KEEP;
+    }
+}
+
+DXGI_FORMAT attr_format(int size) {
+    switch (size) {
+    case 1: return DXGI_FORMAT_R32_FLOAT;
+    case 2: return DXGI_FORMAT_R32G32_FLOAT;
+    case 3: return DXGI_FORMAT_R32G32B32_FLOAT;
+    default: return DXGI_FORMAT_R32G32B32A32_FLOAT;
+    }
+}
+
+ID3D12PipelineState *get_pso(Program *p, Vao *vao, int topo, DXGI_FORMAT rtv_fmt, bool has_ds) {
+    PsoKey k;
+    std::memset(&k, 0, sizeof(k));
+    k.prog = p->id; k.topo = (uint32_t)topo; k.rtv = (uint32_t)rtv_fmt; k.ds = has_ds;
+    k.blend = S.blend;
+    if (S.blend) {
+        k.bsrc = S.bsrc; k.bdst = S.bdst; k.bsrca = S.bsrca; k.bdsta = S.bdsta;
+        k.beq = S.beq; k.beqa = S.beqa;
+    }
+    k.cmask = (S.cmask[0] ? 1u : 0u) | (S.cmask[1] ? 2u : 0u) | (S.cmask[2] ? 4u : 0u) | (S.cmask[3] ? 8u : 0u);
+    const bool st = S.stencil && has_ds;
+    k.st = st;
+    if (st) {
+        k.sfunc = S.sfunc; k.sread = S.sreadmask & 0xFF; k.swrite = S.swritemask & 0xFF;
+        k.sfail = S.sfail; k.sdpfail = S.sdpfail; k.sdppass = S.sdppass;
+    }
+    if (vao)
+        for (int i = 0; i < 16; i++)
+            if (vao->a[i].on) {
+                k.attrs[i][0] = (uint32_t)vao->a[i].size;
+                k.attrs[i][1] = (uint32_t)vao->a[i].offset;
+                k.attrs[i][2] = (uint32_t)vao->a[i].stride;
+            }
+    if (D->pso_last_ok && std::memcmp(&k, &D->pso_last, sizeof(k)) == 0) return D->pso_last_ps;
+    auto &bucket = D->pso[fnv1a(&k, sizeof(k))];
+    for (auto &e : bucket)
+        if (std::memcmp(&e.first, &k, sizeof(k)) == 0) {
+            D->pso_last = k; D->pso_last_ps = e.second; D->pso_last_ok = true;
+            return e.second;
+        }
+
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC d{};
+    d.pRootSignature = D->root;
+    d.VS = {p->vsb->GetBufferPointer(), p->vsb->GetBufferSize()};
+    d.PS = {p->psb->GetBufferPointer(), p->psb->GetBufferSize()};
+    if (topo == 2 && D->line_gs) d.GS = {D->line_gs->GetBufferPointer(), D->line_gs->GetBufferSize()};
+    D3D12_RENDER_TARGET_BLEND_DESC &b = d.BlendState.RenderTarget[0];
+    b.BlendEnable = S.blend ? TRUE : FALSE;
+    b.SrcBlend = blend_factor(S.bsrc, false);
+    b.DestBlend = blend_factor(S.bdst, false);
+    b.BlendOp = blend_op(S.beq);
+    b.SrcBlendAlpha = blend_factor(S.bsrca, true);
+    b.DestBlendAlpha = blend_factor(S.bdsta, true);
+    b.BlendOpAlpha = blend_op(S.beqa);
+    b.LogicOp = D3D12_LOGIC_OP_NOOP;
+    b.RenderTargetWriteMask = (UINT8)k.cmask;
+    d.SampleMask = 0xFFFFFFFFu;
+    d.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    d.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    d.RasterizerState.DepthClipEnable = TRUE;
+    d.DepthStencilState.DepthEnable = FALSE;
+    d.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ZERO;
+    d.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+    d.DepthStencilState.StencilEnable = st ? TRUE : FALSE;
+    d.DepthStencilState.StencilReadMask = (UINT8)k.sread;
+    d.DepthStencilState.StencilWriteMask = (UINT8)k.swrite;
+    D3D12_DEPTH_STENCILOP_DESC so{};
+    so.StencilFailOp = stencil_op(S.sfail);
+    so.StencilDepthFailOp = stencil_op(S.sdpfail);
+    so.StencilPassOp = stencil_op(S.sdppass);
+    so.StencilFunc = cmp_func(S.sfunc);
+    d.DepthStencilState.FrontFace = so;
+    d.DepthStencilState.BackFace = so;
+    D3D12_INPUT_ELEMENT_DESC elems[16];
+    UINT ne = 0;
+    if (vao)
+        for (int i = 0; i < 16; i++)
+            if (vao->a[i].on) {
+                D3D12_INPUT_ELEMENT_DESC &e = elems[ne++];
+                e.SemanticName = "ATTR";
+                e.SemanticIndex = (UINT)i;
+                e.Format = attr_format(vao->a[i].size);
+                e.InputSlot = 0;
+                e.AlignedByteOffset = (UINT)vao->a[i].offset;
+                e.InputSlotClass = D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA;
+                e.InstanceDataStepRate = 0;
+            }
+    d.InputLayout = {ne ? elems : nullptr, ne};
+    d.PrimitiveTopologyType = topo == 0 ? D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE
+                                        : D3D12_PRIMITIVE_TOPOLOGY_TYPE_LINE;
+    d.NumRenderTargets = 1;
+    d.RTVFormats[0] = rtv_fmt;
+    d.DSVFormat = has_ds ? DXGI_FORMAT_D24_UNORM_S8_UINT : DXGI_FORMAT_UNKNOWN;
+    d.SampleDesc.Count = 1;
+    ID3D12PipelineState *ps = nullptr;
+    HRESULT hr = D->dev->CreateGraphicsPipelineState(&d, IID_PPV_ARGS(&ps));
+    if (FAILED(hr)) {
+        logf("pipeline state for program %u (%s/%s) failed: 0x%08lX", p->id,
+             p->vdef ? p->vdef->name : "?", p->fdef ? p->fdef->name : "?", (unsigned long)hr);
+        ps = nullptr;
+    }
+    bucket.push_back({k, ps});
+    D->pso_last = k; D->pso_last_ps = ps; D->pso_last_ok = true;
+    return ps;
+}
+
+/* ---- the draw ----------------------------------------------------------- */
+void bind_target(Tex *ct, Rb *ds) {
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv = D->rtv.at(tex_rtv(ct));
+    barrier(ct->res, ct->state, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    if (ds) {
+        barrier(ds->res, ds->state, D3D12_RESOURCE_STATE_DEPTH_WRITE);
+        D3D12_CPU_DESCRIPTOR_HANDLE dsv = D->dsv.at(ds->dsv);
+        D->cl->OMSetRenderTargets(1, &rtv, FALSE, &dsv);
+    } else {
+        D->cl->OMSetRenderTargets(1, &rtv, FALSE, nullptr);
+    }
+}
+
+void set_view(Tex *ct) {
+    D3D12_VIEWPORT vp{(float)S.vp[0], (float)S.vp[1], (float)S.vp[2], (float)S.vp[3], 0.0f, 1.0f};
+    D->cl->RSSetViewports(1, &vp);
+    D3D12_RECT r;
+    if (S.scissor) {
+        r.left = std::max(0, S.sc[0]);
+        r.top = std::max(0, S.sc[1]);
+        r.right = std::min(ct->w, S.sc[0] + S.sc[2]);
+        r.bottom = std::min(ct->h, S.sc[1] + S.sc[3]);
+        if (r.right < r.left) r.right = r.left;
+        if (r.bottom < r.top) r.bottom = r.top;
+    } else {
+        r.left = 0; r.top = 0; r.right = ct->w; r.bottom = ct->h;
+    }
+    D->cl->RSSetScissorRects(1, &r);
+}
+
+void draw(unsigned mode, int first, int count) {
+    Program *p = T_prog.get(S.program);
+    if (!p || !p->linked || count <= 0) { set_error(X_INVALID_OPERATION); return; }
+    Tex *ct = fbo_color(S.draw_fbo);
+    if (!ct || !ct->res) { set_error(X_INVALID_OPERATION); return; }
+    Rb *ds = fbo_ds(S.draw_fbo);
+    Vao *vao = T_vao.get(S.vao);
+    int topo = mode == X_LINES ? ((S.line_width > 1.5f && D->line_gs) ? 2 : 1) : 0;
+    open_list();
+    ID3D12PipelineState *ps = get_pso(p, vao, topo, ct->fmt, ds != nullptr);
+    if (!ps) return;
+
+    /* Textures, samplers. */
+    int table = gpu_desc_alloc(4);
+    if (table < 0) { logf("out of shader-visible descriptors"); return; }
+    unsigned smp_bits = 0;
+    for (int slot = 0; slot < 4; slot++) {
+        D3D12_CPU_DESCRIPTOR_HANDLE srcd = D->srv.at(D->null_srv);
+        if (p->slot_used & (1u << slot)) {
+            const int unit = p->slot_unit[slot];
+            Tex *t = (unit >= 0 && unit < 8) ? T_tex.get(S.units[unit]) : nullptr;
+            if (t && t->res && t != ct) {
+                barrier(t->res, t->state, SRV_STATE);
+                srcd = D->srv.at(t->srv);
+                smp_bits |= (unsigned)((t->min_linear ? 1 : 0) | (t->mag_linear ? 2 : 0)) << (slot * 2);
+            } else if (t && t->is_int) {
+                srcd = D->srv.at(D->null_srv_uint);
+            }
+        }
+        D3D12_CPU_DESCRIPTOR_HANDLE dstd = D->gsrv->GetCPUDescriptorHandleForHeapStart();
+        dstd.ptr += (SIZE_T)(table + slot) * D->gsrv_inc;
+        D->dev->CopyDescriptorsSimple(1, dstd, srcd, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    }
+    bind_target(ct, ds);
+    set_view(ct);
+
+    D->cl->SetPipelineState(ps);
+    /* Constants. */
+    if (!p->vcb.empty()) {
+        Upload u = upload_alloc(p->vcb.size(), 256);
+        if (!u.cpu) return;
+        std::memcpy(u.cpu, p->vcb.data(), p->vcb.size());
+        D->cl->SetGraphicsRootConstantBufferView(0, u.gpu);
+    } else {
+        Upload u = upload_alloc(256, 256);
+        if (!u.cpu) return;
+        D->cl->SetGraphicsRootConstantBufferView(0, u.gpu);
+    }
+    if (!p->pcb.empty()) {
+        Upload u = upload_alloc(p->pcb.size(), 256);
+        if (!u.cpu) return;
+        std::memcpy(u.cpu, p->pcb.data(), p->pcb.size());
+        D->cl->SetGraphicsRootConstantBufferView(1, u.gpu);
+    } else {
+        Upload u = upload_alloc(256, 256);
+        if (!u.cpu) return;
+        D->cl->SetGraphicsRootConstantBufferView(1, u.gpu);
+    }
+    D3D12_GPU_DESCRIPTOR_HANDLE gt = D->gsrv->GetGPUDescriptorHandleForHeapStart();
+    gt.ptr += (UINT64)table * D->gsrv_inc;
+    D->cl->SetGraphicsRootDescriptorTable(2, gt);
+    D3D12_GPU_DESCRIPTOR_HANDLE gs = D->gsmp->GetGPUDescriptorHandleForHeapStart();
+    gs.ptr += (UINT64)smp_bits * 4 * D->gsmp_inc;
+    D->cl->SetGraphicsRootDescriptorTable(3, gs);
+    if (topo == 2) {
+        float lc[4] = {(float)S.vp[2], (float)S.vp[3], S.line_width, 0.0f};
+        D->cl->SetGraphicsRoot32BitConstants(4, 4, lc, 0);
+    }
+
+    /* Vertex data: the range this draw reads, from the VAO's buffer. */
+    if (vao) {
+        int stride = 0; unsigned bufid = 0;
+        for (int i = 0; i < 16; i++)
+            if (vao->a[i].on) { stride = vao->a[i].stride; bufid = vao->a[i].buffer; break; }
+        Buf *vb = T_buf.get(bufid);
+        if (stride > 0 && vb) {
+            const size_t start = (size_t)first * (size_t)stride;
+            const size_t bytes = (size_t)count * (size_t)stride;
+            if (start + bytes > vb->data.size()) { set_error(X_INVALID_OPERATION); return; }
+            Upload u = upload_alloc(bytes, 16);
+            if (!u.cpu) return;
+            std::memcpy(u.cpu, vb->data.data() + start, bytes);
+            D3D12_VERTEX_BUFFER_VIEW v{u.gpu, (UINT)bytes, (UINT)stride};
+            D->cl->IASetVertexBuffers(0, 1, &v);
+        }
+    }
+    D->cl->IASetPrimitiveTopology(topo == 0 ? D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST
+                                            : D3D_PRIMITIVE_TOPOLOGY_LINELIST);
+    if (S.blend) {
+        const bool alpha_const = S.bsrc == X_CONSTANT_ALPHA || S.bdst == X_CONSTANT_ALPHA ||
+                                 S.bsrc == X_ONE_MINUS_CONSTANT_ALPHA || S.bdst == X_ONE_MINUS_CONSTANT_ALPHA;
+        float f[4] = {S.bcolor[0], S.bcolor[1], S.bcolor[2], S.bcolor[3]};
+        if (alpha_const) f[0] = f[1] = f[2] = S.bcolor[3];
+        D->cl->OMSetBlendFactor(f);
+    }
+    if (S.stencil && ds) D->cl->OMSetStencilRef((UINT)(S.sref & 0xFF));
+    D->cl->DrawInstanced((UINT)count, 1, 0, 0);
+    D->dirty = true;
+}
+
+/* ---- built-in shaders --------------------------------------------------- */
+/* Wide lines the way GL rasterizes them without smoothing: a parallelogram
+ * widened along the MINOR axis by the line width (x-major lines grow in y,
+ * y-major lines in x), ending flush at the endpoints. */
+const char *LINE_GS =
+    "cbuffer LineCB : register(b2) { float2 vp_size; float line_w; float pad; };\n"
+    "struct V { float4 pos : SV_Position; noperspective float4 v_col : TEXCOORD0; };\n"
+    "[maxvertexcount(4)]\n"
+    "void main(line V v[2], inout TriangleStream<V> s) {\n"
+    "  float2 a = v[0].pos.xy / v[0].pos.w, b = v[1].pos.xy / v[1].pos.w;\n"
+    "  float2 d = (b - a) * vp_size;\n"
+    "  float2 off = abs(d.x) >= abs(d.y) ? float2(0.0, line_w / vp_size.y)\n"
+    "                                    : float2(line_w / vp_size.x, 0.0);\n"
+    "  V o;\n"
+    "  o = v[0]; o.pos = float4(a + off, 0.0, 1.0); s.Append(o);\n"
+    "  o = v[0]; o.pos = float4(a - off, 0.0, 1.0); s.Append(o);\n"
+    "  o = v[1]; o.pos = float4(b + off, 0.0, 1.0); s.Append(o);\n"
+    "  o = v[1]; o.pos = float4(b - off, 0.0, 1.0); s.Append(o);\n"
+    "}\n";
+
+/* Framebuffer 0 -> swap chain, flipped: FB0 row r is window row (H-1-r). */
+const char *FLIP_VS =
+    "float4 main(uint vid : SV_VertexID) : SV_Position {\n"
+    "  float2 p = float2((vid << 1) & 2, vid & 2);\n"
+    "  return float4(p * 2.0 - 1.0, 0.0, 1.0); }\n";
+const char *FLIP_PS =
+    "Texture2D fb : register(t0);\n"
+    "float4 main(float4 fc : SV_Position) : SV_Target0 {\n"
+    "  uint w, h; fb.GetDimensions(w, h);\n"
+    "  int2 p = int2(fc.xy);\n"
+    "  p.y = int(h) - 1 - p.y;\n"
+    "  p = clamp(p, int2(0, 0), int2(int(w) - 1, int(h) - 1));\n"
+    "  return float4(fb.Load(int3(p, 0)).rgb, 1.0); }\n";
+
+bool make_root() {
+    D3D12_DESCRIPTOR_RANGE srv{}, smp{};
+    srv.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV; srv.NumDescriptors = 4;
+    srv.BaseShaderRegister = 0; srv.OffsetInDescriptorsFromTableStart = 0;
+    smp.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SAMPLER; smp.NumDescriptors = 4;
+    smp.BaseShaderRegister = 0; smp.OffsetInDescriptorsFromTableStart = 0;
+    D3D12_ROOT_PARAMETER rp[5]{};
+    rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    rp[0].Descriptor.ShaderRegister = 0;
+    rp[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    rp[1].Descriptor.ShaderRegister = 1;
+    rp[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    rp[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    rp[2].DescriptorTable.NumDescriptorRanges = 1;
+    rp[2].DescriptorTable.pDescriptorRanges = &srv;
+    rp[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    rp[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    rp[3].DescriptorTable.NumDescriptorRanges = 1;
+    rp[3].DescriptorTable.pDescriptorRanges = &smp;
+    rp[3].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    rp[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    rp[4].Constants.ShaderRegister = 2;
+    rp[4].Constants.Num32BitValues = 4;
+    rp[4].ShaderVisibility = D3D12_SHADER_VISIBILITY_GEOMETRY;
+    D3D12_ROOT_SIGNATURE_DESC rd{};
+    rd.NumParameters = 5; rd.pParameters = rp;
+    rd.Flags = D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT;
+    ID3DBlob *blob = nullptr, *err = nullptr;
+    HRESULT hr = D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &blob, &err);
+    if (FAILED(hr)) { fail_text("root signature serialization failed", hr); rel(err); return false; }
+    hr = D->dev->CreateRootSignature(0, blob->GetBufferPointer(), blob->GetBufferSize(), IID_PPV_ARGS(&D->root));
+    rel(blob); rel(err);
+    if (FAILED(hr)) { fail_text("root signature creation failed", hr); return false; }
+    return true;
+}
+
+bool make_flip_pso() {
+    D->flip_vs = compile_hlsl("GL12_FLIP_VS", FLIP_VS, "vs_5_0");
+    D->flip_ps = compile_hlsl("GL12_FLIP_PS", FLIP_PS, "ps_5_0");
+    if (!D->flip_vs || !D->flip_ps) return false;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC d{};
+    d.pRootSignature = D->root;
+    d.VS = {D->flip_vs->GetBufferPointer(), D->flip_vs->GetBufferSize()};
+    d.PS = {D->flip_ps->GetBufferPointer(), D->flip_ps->GetBufferSize()};
+    d.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    d.SampleMask = 0xFFFFFFFFu;
+    d.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    d.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    d.RasterizerState.DepthClipEnable = TRUE;
+    d.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    d.NumRenderTargets = 1;
+    d.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+    d.SampleDesc.Count = 1;
+    HRESULT hr = D->dev->CreateGraphicsPipelineState(&d, IID_PPV_ARGS(&D->flip_pso));
+    if (FAILED(hr)) { fail_text("present pipeline creation failed", hr); return false; }
+    return true;
+}
+
+bool make_samplers() {
+    /* 256 tables of 4 samplers: two bits per slot, bit 0 = linear
+     * minification, bit 1 = linear magnification. All clamp to edge. */
+    D3D12_CPU_DESCRIPTOR_HANDLE h = D->gsmp->GetCPUDescriptorHandleForHeapStart();
+    for (unsigned t = 0; t < 256; t++)
+        for (unsigned slot = 0; slot < 4; slot++) {
+            const unsigned bits = (t >> (slot * 2)) & 3u;
+            D3D12_SAMPLER_DESC sd{};
+            const bool mn = bits & 1u, mg = bits & 2u;
+            sd.Filter = mn ? (mg ? D3D12_FILTER_MIN_MAG_MIP_LINEAR : D3D12_FILTER_MIN_LINEAR_MAG_MIP_POINT)
+                           : (mg ? D3D12_FILTER_MIN_POINT_MAG_LINEAR_MIP_POINT : D3D12_FILTER_MIN_MAG_MIP_POINT);
+            sd.AddressU = sd.AddressV = sd.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+            sd.MaxLOD = D3D12_FLOAT32_MAX;
+            sd.ComparisonFunc = D3D12_COMPARISON_FUNC_NEVER;
+            D3D12_CPU_DESCRIPTOR_HANDLE hh = h;
+            hh.ptr += (SIZE_T)(t * 4 + slot) * D->gsmp_inc;
+            D->dev->CreateSampler(&sd, hh);
+        }
+    return true;
+}
+
+bool swap_buffers_acquire() {
+    for (int i = 0; i < GL12_FRAMES; i++) {
+        if (FAILED(D->swap->GetBuffer((UINT)i, IID_PPV_ARGS(&D->bb[i])))) return false;
+        if (D->bb_rtv[i] < 0) D->bb_rtv[i] = D->rtv.alloc();
+        D->dev->CreateRenderTargetView(D->bb[i], nullptr, D->rtv.at(D->bb_rtv[i]));
+    }
+    return true;
+}
+
+void window_pixels(int *w, int *h) {
+    int ww = 0, hh = 0;
+    if (D && D->win) SDL_GetWindowSizeInPixels(D->win, &ww, &hh);
+    *w = ww; *h = hh;
+}
+
+void swap_resize_if_needed() {
+    int w = 0, h = 0;
+    window_pixels(&w, &h);
+    if (w <= 0 || h <= 0) return;
+    if ((UINT)w == D->sc_w && (UINT)h == D->sc_h) return;
+    finish();
+    for (int i = 0; i < GL12_FRAMES; i++) rel(D->bb[i]);
+    HRESULT hr = D->swap->ResizeBuffers(GL12_FRAMES, (UINT)w, (UINT)h, DXGI_FORMAT_R8G8B8A8_UNORM,
+                                        D->tearing ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0);
+    if (FAILED(hr)) { fail_text("swap chain resize failed", hr); return; }
+    D->sc_w = (UINT)w; D->sc_h = (UINT)h;
+    swap_buffers_acquire();
+}
+
+void destroy_all() {
+    if (!D) return;
+    if (D->queue && D->fence) {
+        if (D->open) submit();
+        wait_value(D->fence_submitted);
+    }
+    auto drop = [](auto &table) {
+        for (size_t i = 1; i < table.v.size(); i++) { delete table.v[i]; }
+        table.v.assign(1, nullptr);
+    };
+    for (size_t i = 1; i < T_tex.v.size(); i++) if (T_tex.v[i]) rel(T_tex.v[i]->res);
+    for (size_t i = 1; i < T_rb.v.size(); i++) if (T_rb.v[i]) rel(T_rb.v[i]->res);
+    for (size_t i = 1; i < T_buf.v.size(); i++) if (T_buf.v[i]) rel(T_buf.v[i]->rb);
+    drop(T_tex); drop(T_rb); drop(T_fbo); drop(T_buf); drop(T_vao); drop(T_sh); drop(T_prog); drop(T_q);
+    for (auto &kv : D->pso)
+        for (auto &e : kv.second)
+            if (e.second) e.second->Release();
+    D->pso.clear();
+    D->pso_last_ok = false;
+    for (auto &kv : g_blobs) if (kv.second) kv.second->Release();
+    g_blobs.clear();
+    for (auto &d : D->dead) d.second->Release();
+    D->dead.clear();
+    for (auto *c : D->chunk_free) { rel(c->res); delete c; }
+    for (auto *c : D->chunk_now) { rel(c->res); delete c; }
+    for (auto *c : D->chunk_pending) { rel(c->res); delete c; }
+    rel(D->fb0.res);
+    rel(D->rb_tmp);
+    rel(D->flip_pso); rel(D->qheap); rel(D->qrb);
+    for (int i = 0; i < GL12_FRAMES; i++) rel(D->bb[i]);
+    rel(D->swap);
+    rel(D->root); rel(D->gsrv); rel(D->gsmp);
+    rel(D->srv.heap); rel(D->rtv.heap); rel(D->dsv.heap);
+    rel(D->cl);
+    for (int i = 0; i < GL12_ALLOCATORS; i++) rel(D->alloc[i]);
+    rel(D->fence);
+    if (D->event) CloseHandle(D->event);
+    rel(D->iq);
+    rel(D->queue); rel(D->dev); rel(D->factory);
+    if (D->compiler) FreeLibrary(D->compiler);
+    delete D;
+    D = nullptr;
+    S = State();
+}

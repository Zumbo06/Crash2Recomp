+    unsigned long long s[6];
+    int base_k = 0, k = 0, code_ok = 0, added = 0;
+    crash2_wide_slst_stats(s, &base_k, &k, &code_ok, &added);
+    send_fmt("{\"id\":%d,\"ok\":true,\"base_k\":%d,\"k\":%d,\"code_ok\":%d,"
+             "\"added\":%d,\"built\":%llu,\"used\":%llu,\"mismatch\":%llu,"
+             "\"bad\":%llu,\"prim_skips\":%llu,\"added_max\":%llu}",
+             id, base_k, k, code_ok, added, s[0], s[1], s[2], s[3], s[4], s[5]);
+}

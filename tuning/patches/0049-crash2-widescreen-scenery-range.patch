+#ifndef C2SL_R32
+extern uint32_t psx_read_word(uint32_t a);
+extern uint16_t psx_read_half(uint32_t a);
+extern void     psx_write_half(uint32_t a, uint16_t v);
+extern uint32_t psx_mod_memory_alloc(uint32_t size, uint32_t alignment);

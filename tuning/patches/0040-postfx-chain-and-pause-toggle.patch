+/* gpu_gl_postfx.c - OpenGL output post-processing (see gpu_gl_postfx.h and
+ * gpu_postfx.h for the settings).
+ *
+ * Every pass is a full-screen triangle into an output-sized target, sampled
+ * top-row-first. Order:
+ *
+ *   in -> [FXAA | SMAA edges -> weights -> blend] -> [CAS] -> composite
+ *                                     \-> [bloom: prefilter, 5 down, 4 up] -/
+ *
+ * The composite adds bloom in (approximately) linear light, grades, applies
+ * vignette and grain, dithers to 8 bits and writes the window viewport. With
+ * the chain off none of this runs: gpu_gl_renderer.c draws straight to the
+ * window as it always did.
+ *
+ * FXAA is the classic reduction form (Lottes). CAS follows AMD FidelityFX
+ * Contrast Adaptive Sharpening (MIT). SMAA 1x is a GLSL rendering of the
+ * reference SMAA.hlsl (MIT; notice in gpu_smaa_tex.h), HIGH preset without
+ * diagonal detection: threshold 0.1, 16 search steps, corner rounding 25. */
+
+#include "gpu_gl_postfx.h"
+#include "gpu_postfx.h"
+#include "gpu_smaa_tex.h"
+
+#include "psx_sdl.h"
+#if defined(PSX_SDL3)
+#include <SDL3/SDL_opengl.h>
+#else
+#include <SDL_opengl.h>
+#endif
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <zlib.h>
+
+#ifndef APIENTRY
+#define APIENTRY
+#endif
+#ifndef GL_CLAMP_TO_EDGE
+#define GL_CLAMP_TO_EDGE 0x812F
+#endif
+#ifndef GL_RGBA8
+#define GL_RGBA8 0x8058
+#endif
+#define PFX_FRAGMENT_SHADER      0x8B30
+#define PFX_VERTEX_SHADER        0x8B31
+#define PFX_COMPILE_STATUS       0x8B81
+#define PFX_LINK_STATUS          0x8B82
+#define PFX_TEXTURE0             0x84C0
+#define PFX_FRAMEBUFFER          0x8D40
+#define PFX_COLOR_ATTACHMENT0    0x8CE0
+#define PFX_FRAMEBUFFER_COMPLETE 0x8CD5
+#define PFX_FUNC_ADD             0x8006
+#define PFX_RG                   0x8227
+#define PFX_RG8                  0x822B
+#define PFX_R8                   0x8229
+#define PFX_RED                  0x1903
+#define PFX_RGBA16F              0x881A
+#define PFX_HALF_FLOAT           0x140B
+
+typedef GLuint (APIENTRY *PFX_CreateShader)(GLenum);
+typedef void   (APIENTRY *PFX_ShaderSource)(GLuint, GLsizei, const char *const *, const GLint *);
+typedef void   (APIENTRY *PFX_CompileShader)(GLuint);
+typedef void   (APIENTRY *PFX_GetShaderiv)(GLuint, GLenum, GLint *);
+typedef void   (APIENTRY *PFX_GetShaderInfoLog)(GLuint, GLsizei, GLsizei *, char *);
+typedef void   (APIENTRY *PFX_DeleteShader)(GLuint);
+typedef GLuint (APIENTRY *PFX_CreateProgram)(void);
+typedef void   (APIENTRY *PFX_DeleteProgram)(GLuint);
+typedef void   (APIENTRY *PFX_AttachShader)(GLuint, GLuint);
+typedef void   (APIENTRY *PFX_LinkProgram)(GLuint);
+typedef void   (APIENTRY *PFX_GetProgramiv)(GLuint, GLenum, GLint *);
+typedef void   (APIENTRY *PFX_GetProgramInfoLog)(GLuint, GLsizei, GLsizei *, char *);
+typedef void   (APIENTRY *PFX_UseProgram)(GLuint);
+typedef GLint  (APIENTRY *PFX_GetUniformLocation)(GLuint, const char *);
+typedef void   (APIENTRY *PFX_Uniform1i)(GLint, GLint);
+typedef void   (APIENTRY *PFX_Uniform1f)(GLint, GLfloat);
+typedef void   (APIENTRY *PFX_Uniform2f)(GLint, GLfloat, GLfloat);
+typedef void   (APIENTRY *PFX_Uniform4f)(GLint, GLfloat, GLfloat, GLfloat, GLfloat);
+typedef void   (APIENTRY *PFX_GenVertexArrays)(GLsizei, GLuint *);
+typedef void   (APIENTRY *PFX_DeleteVertexArrays)(GLsizei, const GLuint *);
+typedef void   (APIENTRY *PFX_BindVertexArray)(GLuint);
+typedef void   (APIENTRY *PFX_ActiveTexture)(GLenum);
+typedef void   (APIENTRY *PFX_GenFramebuffers)(GLsizei, GLuint *);
+typedef void   (APIENTRY *PFX_DeleteFramebuffers)(GLsizei, const GLuint *);
+typedef void   (APIENTRY *PFX_BindFramebuffer)(GLenum, GLuint);
+typedef void   (APIENTRY *PFX_FramebufferTexture2D)(GLenum, GLenum, GLenum, GLuint, GLint);
+typedef GLenum (APIENTRY *PFX_CheckFramebufferStatus)(GLenum);
+typedef void   (APIENTRY *PFX_BlendEquationSeparate)(GLenum, GLenum);
+
+static PFX_CreateShader           f_CreateShader;
+static PFX_ShaderSource           f_ShaderSource;
+static PFX_CompileShader          f_CompileShader;
+static PFX_GetShaderiv            f_GetShaderiv;
+static PFX_GetShaderInfoLog       f_GetShaderInfoLog;
+static PFX_DeleteShader           f_DeleteShader;
+static PFX_CreateProgram          f_CreateProgram;
+static PFX_DeleteProgram          f_DeleteProgram;
+static PFX_AttachShader           f_AttachShader;
+static PFX_LinkProgram            f_LinkProgram;
+static PFX_GetProgramiv           f_GetProgramiv;
+static PFX_GetProgramInfoLog      f_GetProgramInfoLog;
+static PFX_UseProgram             f_UseProgram;
+static PFX_GetUniformLocation     f_GetUniformLocation;
+static PFX_Uniform1i              f_Uniform1i;
+static PFX_Uniform1f              f_Uniform1f;
+static PFX_Uniform2f              f_Uniform2f;
+static PFX_Uniform4f              f_Uniform4f;
+static PFX_GenVertexArrays        f_GenVertexArrays;
+static PFX_DeleteVertexArrays     f_DeleteVertexArrays;
+static PFX_BindVertexArray        f_BindVertexArray;
+static PFX_ActiveTexture          f_ActiveTexture;
+static PFX_GenFramebuffers        f_GenFramebuffers;
+static PFX_DeleteFramebuffers     f_DeleteFramebuffers;
+static PFX_BindFramebuffer        f_BindFramebuffer;
+static PFX_FramebufferTexture2D   f_FramebufferTexture2D;
+static PFX_CheckFramebufferStatus f_CheckFramebufferStatus;
+static PFX_BlendEquationSeparate  f_BlendEquationSeparate;
+
+/* ---- shaders ------------------------------------------------------------ */
+
+/* Full-screen triangle; v_uv is top-row-first in the target being drawn,
+ * because row 0 of an FBO sits at NDC y = -1. */
+static const char *VS_ROWS =
+    "#version 330\n"
+    "out vec2 v_uv;\n"
+    "void main(){ vec2 p = vec2((gl_VertexID<<1)&2, gl_VertexID&2);\n"
+    "  v_uv = p; gl_Position = vec4(p*2.0-1.0, 0.0, 1.0); }\n";
+/* Same triangle into the window: flip back to GL's bottom-up rows. */
+static const char *VS_WINDOW =
+    "#version 330\n"
+    "out vec2 v_uv;\n"
+    "void main(){ vec2 p = vec2((gl_VertexID<<1)&2, gl_VertexID&2);\n"
+    "  v_uv = vec2(p.x, 1.0 - p.y); gl_Position = vec4(p*2.0-1.0, 0.0, 1.0); }\n";
+
+static const char *FS_FXAA =
+    "#version 330\n"
+    "in vec2 v_uv; out vec4 frag;\n"
+    "uniform sampler2D u_src; uniform vec2 u_texel;\n"
+    "void main(){\n"
+    "  const vec3 W = vec3(0.299, 0.587, 0.114);\n"
+    "  vec3 nw = texture(u_src, v_uv + vec2(-1.0,-1.0)*u_texel).rgb;\n"
+    "  vec3 ne = texture(u_src, v_uv + vec2( 1.0,-1.0)*u_texel).rgb;\n"
+    "  vec3 sw = texture(u_src, v_uv + vec2(-1.0, 1.0)*u_texel).rgb;\n"
+    "  vec3 se = texture(u_src, v_uv + vec2( 1.0, 1.0)*u_texel).rgb;\n"
+    "  vec4 m  = texture(u_src, v_uv);\n"
+    "  float lnw = dot(nw, W), lne = dot(ne, W), lsw = dot(sw, W), lse = dot(se, W);\n"
+    "  float lm = dot(m.rgb, W);\n"
+    "  float lmin = min(lm, min(min(lnw, lne), min(lsw, lse)));\n"
+    "  float lmax = max(lm, max(max(lnw, lne), max(lsw, lse)));\n"
+    "  if (lmax - lmin < max(0.0312, lmax * 0.125)) { frag = m; return; }\n"
+    "  vec2 dir = vec2(-((lnw + lne) - (lsw + lse)), ((lnw + lsw) - (lne + lse)));\n"
+    "  float reduce = max((lnw + lne + lsw + lse) * (0.25 * 0.125), 1.0 / 128.0);\n"
+    "  float rcp_min = 1.0 / (min(abs(dir.x), abs(dir.y)) + reduce);\n"
+    "  dir = clamp(dir * rcp_min, vec2(-8.0), vec2(8.0)) * u_texel;\n"
+    "  vec3 a = 0.5 * (texture(u_src, v_uv + dir * (1.0/3.0 - 0.5)).rgb +\n"
+    "                  texture(u_src, v_uv + dir * (2.0/3.0 - 0.5)).rgb);\n"
+    "  vec3 b = a * 0.5 + 0.25 * (texture(u_src, v_uv - dir * 0.5).rgb +\n"
+    "                             texture(u_src, v_uv + dir * 0.5).rgb);\n"
+    "  float lb = dot(b, W);\n"
+    "  frag = vec4((lb < lmin || lb > lmax) ? a : b, m.a);\n"
+    "}\n";
+
+/* AMD FidelityFX CAS, no scaling: a 3x3 cross/box, the sharpening weight
+ * shaped by how far the local minimum/maximum sit from the signal limits. */
+static const char *FS_CAS =
+    "#version 330\n"
+    "out vec4 frag;\n"
+    "uniform sampler2D u_src; uniform float u_sharp;\n"
+    "void main(){\n"
+    "  ivec2 p = ivec2(gl_FragCoord.xy), mx = textureSize(u_src, 0) - 1;\n"
+    "#define T(dx,dy) texelFetch(u_src, clamp(p + ivec2(dx,dy), ivec2(0), mx), 0).rgb\n"
+    "  vec3 a = T(-1,-1), b = T(0,-1), c = T(1,-1);\n"
+    "  vec3 d = T(-1, 0), e = T(0, 0), f = T(1, 0);\n"
+    "  vec3 g = T(-1, 1), h = T(0, 1), i = T(1, 1);\n"
+    "  vec3 mn = min(min(min(d, e), min(f, b)), h);\n"
+    "  mn += min(mn, min(min(a, c), min(g, i)));\n"
+    "  vec3 mxc = max(max(max(d, e), max(f, b)), h);\n"
+    "  mxc += max(mxc, max(max(a, c), max(g, i)));\n"
+    "  vec3 amp = sqrt(clamp(min(mn, 2.0 - mxc) / max(mxc, vec3(1e-5)), 0.0, 1.0));\n"
+    "  vec3 w = amp * (-1.0 / mix(8.0, 5.0, u_sharp));\n"
+    "  vec3 o = (b*w + d*w + f*w + h*w + e) / (1.0 + 4.0*w);\n"
+    "  frag = vec4(clamp(o, 0.0, 1.0), 1.0);\n"
+    "}\n";
+
+static const char *FS_SMAA_EDGE =
+    "#version 330\n"
+    "in vec2 v_uv; out vec4 frag;\n"
+    "uniform sampler2D u_color; uniform vec4 u_rt;\n"
+    "void main(){\n"
+    "  vec4 o0 = u_rt.xyxy * vec4(-1.0, 0.0, 0.0, -1.0) + v_uv.xyxy;\n"
+    "  vec4 o1 = u_rt.xyxy * vec4( 1.0, 0.0, 0.0,  1.0) + v_uv.xyxy;\n"
+    "  vec4 o2 = u_rt.xyxy * vec4(-2.0, 0.0, 0.0, -2.0) + v_uv.xyxy;\n"
+    "  const vec3 W = vec3(0.2126, 0.7152, 0.0722);\n"
+    "  float L = dot(textureLod(u_color, v_uv, 0.0).rgb, W);\n"
+    "  float Ll = dot(textureLod(u_color, o0.xy, 0.0).rgb, W);\n"
+    "  float Lt = dot(textureLod(u_color, o0.zw, 0.0).rgb, W);\n"
+    "  vec4 delta; delta.xy = abs(L - vec2(Ll, Lt));\n"
+    "  vec2 edges = step(vec2(0.1), delta.xy);\n"
+    "  if (dot(edges, vec2(1.0)) == 0.0) discard;\n"
+    "  float Lr = dot(textureLod(u_color, o1.xy, 0.0).rgb, W);\n"
+    "  float Lb = dot(textureLod(u_color, o1.zw, 0.0).rgb, W);\n"
+    "  delta.zw = abs(L - vec2(Lr, Lb));\n"
+    "  vec2 maxd = max(delta.xy, delta.zw);\n"
+    "  float Lll = dot(textureLod(u_color, o2.xy, 0.0).rgb, W);\n"
+    "  float Ltt = dot(textureLod(u_color, o2.zw, 0.0).rgb, W);\n"
+    "  delta.zw = abs(vec2(Ll, Lt) - vec2(Lll, Ltt));\n"
+    "  maxd = max(maxd.xy, delta.zw);\n"
+    "  float fd = max(maxd.x, maxd.y);\n"
+    "  edges.xy *= step(fd, 2.0 * delta.xy);\n"
+    "  frag = vec4(edges, 0.0, 1.0);\n"
+    "}\n";
+
+static const char *FS_SMAA_WEIGHTS =
+    "#version 330\n"
+    "in vec2 v_uv; out vec4 frag;\n"
+    "uniform sampler2D u_edges; uniform sampler2D u_area; uniform sampler2D u_search;\n"
+    "uniform vec4 u_rt;\n"
+    "#define MAX_STEPS 16\n"
+    "#define AREA_MAXD 16.0\n"
+    "#define AREA_PX (1.0 / vec2(160.0, 560.0))\n"
+    "#define AREA_SUB (1.0 / 7.0)\n"
+    "#define SEARCH_SIZE vec2(66.0, 33.0)\n"
+    "#define SEARCH_PACKED vec2(64.0, 16.0)\n"
+    "#define CORNER_NORM 0.25\n"
+    "float search_length(vec2 e, float offset){\n"
+    "  vec2 scale = SEARCH_SIZE * vec2(0.5, -1.0);\n"
+    "  vec2 bias  = SEARCH_SIZE * vec2(offset, 1.0);\n"
+    "  scale += vec2(-1.0, 1.0);\n"
+    "  bias  += vec2( 0.5, -0.5);\n"
+    "  scale *= 1.0 / SEARCH_PACKED;\n"
+    "  bias  *= 1.0 / SEARCH_PACKED;\n"
+    "  return textureLod(u_search, scale * e + bias, 0.0).r;\n"
+    "}\n"
+    "float search_x_left(vec2 tc, float end){\n"
+    "  vec2 e = vec2(0.0, 1.0);\n"
+    "  while (tc.x > end && e.g > 0.8281 && e.r == 0.0) {\n"
+    "    e = textureLod(u_edges, tc, 0.0).rg;\n"
+    "    tc = -vec2(2.0, 0.0) * u_rt.xy + tc;\n"
+    "  }\n"
+    "  float off = -(255.0 / 127.0) * search_length(e, 0.0) + 3.25;\n"
+    "  return u_rt.x * off + tc.x;\n"
+    "}\n"
+    "float search_x_right(vec2 tc, float end){\n"
+    "  vec2 e = vec2(0.0, 1.0);\n"
+    "  while (tc.x < end && e.g > 0.8281 && e.r == 0.0) {\n"
+    "    e = textureLod(u_edges, tc, 0.0).rg;\n"
+    "    tc = vec2(2.0, 0.0) * u_rt.xy + tc;\n"
+    "  }\n"
+    "  float off = -(255.0 / 127.0) * search_length(e, 0.5) + 3.25;\n"
+    "  return -u_rt.x * off + tc.x;\n"
+    "}\n"
+    "float search_y_up(vec2 tc, float end){\n"
+    "  vec2 e = vec2(1.0, 0.0);\n"
+    "  while (tc.y > end && e.r > 0.8281 && e.g == 0.0) {\n"
+    "    e = textureLod(u_edges, tc, 0.0).rg;\n"
+    "    tc = -vec2(0.0, 2.0) * u_rt.xy + tc;\n"
+    "  }\n"
+    "  float off = -(255.0 / 127.0) * search_length(e.gr, 0.0) + 3.25;\n"
+    "  return u_rt.y * off + tc.y;\n"
+    "}\n"
+    "float search_y_down(vec2 tc, float end){\n"
+    "  vec2 e = vec2(1.0, 0.0);\n"
+    "  while (tc.y < end && e.r > 0.8281 && e.g == 0.0) {\n"
+    "    e = textureLod(u_edges, tc, 0.0).rg;\n"
+    "    tc = vec2(0.0, 2.0) * u_rt.xy + tc;\n"
+    "  }\n"
+    "  float off = -(255.0 / 127.0) * search_length(e.gr, 0.5) + 3.25;\n"
+    "  return -u_rt.y * off + tc.y;\n"
+    "}\n"
+    "vec2 area(vec2 dist, float e1, float e2){\n"
+    "  vec2 tc = vec2(AREA_MAXD) * round(4.0 * vec2(e1, e2)) + dist;\n"
+    "  tc = AREA_PX * tc + 0.5 * AREA_PX;\n"
+    "  return textureLod(u_area, tc, 0.0).rg;\n"
+    "}\n"
+    "void corner_h(inout vec2 w, vec4 tc, vec2 d){\n"
+    "  vec2 lr = step(d.xy, d.yx);\n"
+    "  vec2 r = (1.0 - CORNER_NORM) * lr; r /= lr.x + lr.y;\n"
+    "  vec2 f = vec2(1.0);\n"
+    "  f.x -= r.x * textureLodOffset(u_edges, tc.xy, 0.0, ivec2(0,  1)).r;\n"
+    "  f.x -= r.y * textureLodOffset(u_edges, tc.zw, 0.0, ivec2(1,  1)).r;\n"
+    "  f.y -= r.x * textureLodOffset(u_edges, tc.xy, 0.0, ivec2(0, -2)).r;\n"
+    "  f.y -= r.y * textureLodOffset(u_edges, tc.zw, 0.0, ivec2(1, -2)).r;\n"
+    "  w *= clamp(f, 0.0, 1.0);\n"
+    "}\n"
+    "void corner_v(inout vec2 w, vec4 tc, vec2 d){\n"
+    "  vec2 lr = step(d.xy, d.yx);\n"
+    "  vec2 r = (1.0 - CORNER_NORM) * lr; r /= lr.x + lr.y;\n"
+    "  vec2 f = vec2(1.0);\n"
+    "  f.x -= r.x * textureLodOffset(u_edges, tc.xy, 0.0, ivec2( 1, 0)).g;\n"
+    "  f.x -= r.y * textureLodOffset(u_edges, tc.zw, 0.0, ivec2( 1, 1)).g;\n"
+    "  f.y -= r.x * textureLodOffset(u_edges, tc.xy, 0.0, ivec2(-2, 0)).g;\n"
+    "  f.y -= r.y * textureLodOffset(u_edges, tc.zw, 0.0, ivec2(-2, 1)).g;\n"
+    "  w *= clamp(f, 0.0, 1.0);\n"
+    "}\n"
+    "void main(){\n"
+    "  vec2 tc = v_uv, pix = tc * u_rt.zw;\n"
+    "  vec4 o0 = u_rt.xyxy * vec4(-0.25, -0.125, 1.25, -0.125) + tc.xyxy;\n"
+    "  vec4 o1 = u_rt.xyxy * vec4(-0.125, -0.25, -0.125, 1.25) + tc.xyxy;\n"
+    "  vec4 o2 = u_rt.xxyy * vec4(-2.0, 2.0, -2.0, 2.0) * float(MAX_STEPS)\n"
+    "          + vec4(o0.xz, o1.yw);\n"
+    "  vec4 w = vec4(0.0);\n"
+    "  vec2 e = texture(u_edges, tc).rg;\n"
+    "  if (e.g > 0.0) {\n"
+    "    vec2 d; vec3 c;\n"
+    "    c.x = search_x_left(o0.xy, o2.x); c.y = o1.y; d.x = c.x;\n"
+    "    float e1 = textureLod(u_edges, c.xy, 0.0).r;\n"
+    "    c.z = search_x_right(o0.zw, o2.y); d.y = c.z;\n"
+    "    d = abs(round(u_rt.zz * d - pix.xx));\n"
+    "    float e2 = textureLodOffset(u_edges, c.zy, 0.0, ivec2(1, 0)).r;\n"
+    "    w.rg = area(sqrt(d), e1, e2);\n"
+    "    c.y = tc.y;\n"
+    "    corner_h(w.rg, c.xyzy, d);\n"
+    "  }\n"
+    "  if (e.r > 0.0) {\n"
+    "    vec2 d; vec3 c;\n"
+    "    c.y = search_y_up(o1.xy, o2.z); c.x = o0.x; d.x = c.y;\n"
+    "    float e1 = textureLod(u_edges, c.xy, 0.0).g;\n"
+    "    c.z = search_y_down(o1.zw, o2.w); d.y = c.z;\n"
+    "    d = abs(round(u_rt.ww * d - pix.yy));\n"
+    "    float e2 = textureLodOffset(u_edges, c.xz, 0.0, ivec2(0, 1)).g;\n"
+    "    w.ba = area(sqrt(d), e1, e2);\n"
+    "    c.x = tc.x;\n"
+    "    corner_v(w.ba, c.xyxz, d);\n"
+    "  }\n"
+    "  frag = w;\n"
+    "}\n";
+
+static const char *FS_SMAA_BLEND =
+    "#version 330\n"
+    "in vec2 v_uv; out vec4 frag;\n"
+    "uniform sampler2D u_color; uniform sampler2D u_blend; uniform vec4 u_rt;\n"
+    "void main(){\n"
+    "  vec2 tc = v_uv;\n"
+    "  vec4 off = u_rt.xyxy * vec4(1.0, 0.0, 0.0, 1.0) + tc.xyxy;\n"
+    "  vec4 a;\n"
+    "  a.x = texture(u_blend, off.xy).a;\n"
+    "  a.y = texture(u_blend, off.zw).g;\n"
+    "  a.wz = texture(u_blend, tc).xz;\n"
+    "  if (dot(a, vec4(1.0)) < 1e-5) { frag = textureLod(u_color, tc, 0.0); return; }\n"
+    "  bool h = max(a.x, a.z) > max(a.y, a.w);\n"
+    "  vec4 bo = h ? vec4(a.x, 0.0, a.z, 0.0) : vec4(0.0, a.y, 0.0, a.w);\n"
+    "  vec2 bw = h ? a.xz : a.yw;\n"
+    "  bw /= dot(bw, vec2(1.0));\n"
+    "  vec4 bc = bo * vec4(u_rt.xy, -u_rt.xy) + tc.xyxy;\n"
+    "  frag = bw.x * textureLod(u_color, bc.xy, 0.0) + bw.y * textureLod(u_color, bc.zw, 0.0);\n"
+    "}\n";
+
+/* Bloom works on colour squared - a cheap gamma-2 linearisation - so the
+ * glow adds like light rather than like paint. */
+static const char *FS_BLOOM_PRE =
+    "#version 330\n"
+    "in vec2 v_uv; out vec4 frag;\n"
+    "uniform sampler2D u_src; uniform vec2 u_texel; uniform float u_threshold;\n"
+    "void main(){\n"
+    "  vec3 c = texture(u_src, v_uv + u_texel * vec2(-1.0,-1.0)).rgb\n"
+    "         + texture(u_src, v_uv + u_texel * vec2( 1.0,-1.0)).rgb\n"
+    "         + texture(u_src, v_uv + u_texel * vec2(-1.0, 1.0)).rgb\n"
+    "         + texture(u_src, v_uv + u_texel * vec2( 1.0, 1.0)).rgb;\n"
+    "  c *= 0.25; c *= c;\n"
+    "  float th = u_threshold * u_threshold, knee = th * 0.5 + 1e-4;\n"
+    "  float br = max(c.r, max(c.g, c.b));\n"
+    "  float soft = clamp(br - th + knee, 0.0, 2.0 * knee);\n"
+    "  soft = soft * soft / (4.0 * knee);\n"
+    "  frag = vec4(c * (max(soft, br - th) / max(br, 1e-4)), 1.0);\n"
+    "}\n";
+
+static const char *FS_BLOOM_DOWN =
+    "#version 330\n"
+    "in vec2 v_uv; out vec4 frag;\n"
+    "uniform sampler2D u_src; uniform vec2 u_half;\n"
+    "void main(){\n"
+    "  vec3 s = texture(u_src, v_uv).rgb * 4.0\n"
+    "         + texture(u_src, v_uv - u_half).rgb\n"
+    "         + texture(u_src, v_uv + u_half).rgb\n"
+    "         + texture(u_src, v_uv + vec2(u_half.x, -u_half.y)).rgb\n"
+    "         + texture(u_src, v_uv - vec2(u_half.x, -u_half.y)).rgb;\n"
+    "  frag = vec4(s / 8.0, 1.0);\n"
+    "}\n";
+
+static const char *FS_BLOOM_UP =
+    "#version 330\n"
+    "in vec2 v_uv; out vec4 frag;\n"
+    "uniform sampler2D u_src; uniform vec2 u_half;\n"
+    "void main(){\n"
+    "  vec2 h = u_half;\n"
+    "  vec3 s = texture(u_src, v_uv + vec2(-h.x * 2.0, 0.0)).rgb\n"
+    "         + texture(u_src, v_uv + vec2(-h.x, h.y)).rgb * 2.0\n"
+    "         + texture(u_src, v_uv + vec2(0.0, h.y * 2.0)).rgb\n"
+    "         + texture(u_src, v_uv + vec2(h.x, h.y)).rgb * 2.0\n"
+    "         + texture(u_src, v_uv + vec2(h.x * 2.0, 0.0)).rgb\n"
+    "         + texture(u_src, v_uv + vec2(h.x, -h.y)).rgb * 2.0\n"
+    "         + texture(u_src, v_uv + vec2(0.0, -h.y * 2.0)).rgb\n"
+    "         + texture(u_src, v_uv + vec2(-h.x, -h.y)).rgb * 2.0;\n"
+    "  frag = vec4(s / 12.0, 1.0);\n"
+    "}\n";
+
+static const char *FS_COMPOSITE =
+    "#version 330\n"
+    "in vec2 v_uv; out vec4 frag;\n"
+    "uniform sampler2D u_src; uniform sampler2D u_bloom;\n"
+    "uniform float u_bloom_amt;\n"
+    "uniform vec4 u_grade0;   /* brightness, contrast, saturation, 1/gamma */\n"
+    "uniform vec4 u_grade1;   /* temperature, vignette, grain, dither */\n"
+    "uniform vec2 u_size;     /* lw, lh */\n"
+    "uniform float u_seed;\n"
+    "float hash12(vec2 p){ vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n"
+    "  p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }\n"
+    "void main(){\n"
+    "  vec3 c = texture(u_src, v_uv).rgb;\n"
+    "  const vec3 W = vec3(0.2126, 0.7152, 0.0722);\n"
+    "  if (u_bloom_amt > 0.0)\n"
+    "    c = sqrt(c * c + texture(u_bloom, v_uv).rgb * u_bloom_amt);\n"
+    "  c += u_grade0.x;\n"
+    "  c = (c - 0.5) * u_grade0.y + 0.5;\n"
+    "  c = mix(vec3(dot(c, W)), c, u_grade0.z);\n"
+    "  c = pow(max(c, vec3(0.0)), vec3(u_grade0.w));\n"
+    "  c *= vec3(1.0 + 0.12 * u_grade1.x, 1.0 + 0.02 * u_grade1.x, 1.0 - 0.12 * u_grade1.x);\n"
+    "  if (u_grade1.y > 0.0) {\n"
+    "    float aspect = u_size.x / max(u_size.y, 1.0);\n"
+    "    vec2 d = (v_uv - 0.5) * vec2(aspect, 1.0);\n"
+    "    float r = length(d) / length(vec2(0.5 * aspect, 0.5));\n"
+    "    c *= 1.0 - u_grade1.y * smoothstep(0.45, 1.0, r);\n"
+    "  }\n"
+    "  if (u_grade1.z > 0.0) {\n"
+    "    float n = hash12(gl_FragCoord.xy + u_seed) - 0.5;\n"
+    "    c += n * u_grade1.z * 0.18 * (1.0 - 0.6 * clamp(dot(c, W), 0.0, 1.0));\n"
+    "  }\n"
+    "  if (u_grade1.w > 0.0)\n"
+    "    c += (hash12(gl_FragCoord.xy * 1.37 + u_seed * 0.71 + 17.0) - 0.5) / 255.0;\n"
+    "  frag = vec4(clamp(c, 0.0, 1.0), 1.0);\n"
+    "}\n";

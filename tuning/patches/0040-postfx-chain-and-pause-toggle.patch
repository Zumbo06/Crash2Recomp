+/* gpu_gl_postfx.h - the OpenGL post-processing chain (gpu_gl_postfx.c).
+ *
+ * Used by gpu_gl_renderer.c around each draw of the game image:
+ *
+ *   fbo = glpfx_begin(lw, lh);   draw the image into fbo, ROW 0 = TOP
+ *   glpfx_end(lx, ly, lw, lh);   chain runs, result lands in the default
+ *                                framebuffer's (lx, ly, lw, lh) viewport
+ *
+ * All passes work top-row-first, the D3D convention, which is what SMAA's
+ * lookup textures and offsets are written for and what a D3D12 port reuses
+ * unchanged; the last pass flips to GL's bottom-up window. Needs the GL
+ * context current. glpfx_begin returns 0 when the chain is unavailable
+ * (shader or FBO failure, absurd size) and the caller draws directly. */
+#ifndef GPU_GL_POSTFX_H
+#define GPU_GL_POSTFX_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+unsigned glpfx_begin(int lw, int lh);
+void     glpfx_end(int lx, int ly, int lw, int lh);
+/* Drop every GL object (context teardown). Safe to call when never used. */
+void     glpfx_shutdown(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif

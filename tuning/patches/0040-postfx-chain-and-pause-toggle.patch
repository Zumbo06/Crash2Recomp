+/* ---- state -------------------------------------------------------------- */
+typedef struct { GLuint tex, fbo; int w, h; } Target;
+
+enum { P_FXAA, P_CAS, P_EDGE, P_WEIGHTS, P_BLEND, P_BPRE, P_BDOWN, P_BUP, P_COMP, P_COUNT };
+#define BLOOM_LEVELS 5
+
+static int     s_state = 0;          /* 0 untried, 1 ready, -1 failed */
+static GLuint  s_prog[P_COUNT];
+static GLuint  s_vao;
+static Target  s_in, s_pp[2], s_edges, s_weights, s_bloom[BLOOM_LEVELS];
+static int     s_nbloom;
+static GLuint  s_area_tex, s_search_tex;
+static int     s_w, s_h;
+static unsigned s_frame;
+
+static GLuint compile(GLenum type, const char *src) {
+    GLuint s = f_CreateShader(type);
+    f_ShaderSource(s, 1, &src, NULL);
+    f_CompileShader(s);
+    GLint ok = 0;
+    f_GetShaderiv(s, PFX_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char log[1024]; log[0] = 0;
+        f_GetShaderInfoLog(s, sizeof log, NULL, log);
+        fprintf(stdout, "psxrecomp: post-processing shader failed: %s\n", log);
+        f_DeleteShader(s);
+        return 0;
+    }
+    return s;
+}
+
+static GLuint link(const char *vs, const char *fs) {
+    GLuint v = compile(PFX_VERTEX_SHADER, vs), f = compile(PFX_FRAGMENT_SHADER, fs);
+    if (!v || !f) { if (v) f_DeleteShader(v); if (f) f_DeleteShader(f); return 0; }
+    GLuint p = f_CreateProgram();
+    f_AttachShader(p, v);
+    f_AttachShader(p, f);
+    f_LinkProgram(p);
+    f_DeleteShader(v);
+    f_DeleteShader(f);
+    GLint ok = 0;
+    f_GetProgramiv(p, PFX_LINK_STATUS, &ok);
+    if (!ok) {
+        char log[1024]; log[0] = 0;
+        f_GetProgramInfoLog(p, sizeof log, NULL, log);
+        fprintf(stdout, "psxrecomp: post-processing link failed: %s\n", log);
+        f_DeleteProgram(p);
+        return 0;
+    }
+    return p;
+}
+
+static int load(void) {
+    int ok = 1;
+#define L(p, n) do { p = (void *)SDL_GL_GetProcAddress(n); if (!p) ok = 0; } while (0)
+    L(f_CreateShader, "glCreateShader");   L(f_ShaderSource, "glShaderSource");
+    L(f_CompileShader, "glCompileShader"); L(f_GetShaderiv, "glGetShaderiv");
+    L(f_GetShaderInfoLog, "glGetShaderInfoLog"); L(f_DeleteShader, "glDeleteShader");
+    L(f_CreateProgram, "glCreateProgram"); L(f_DeleteProgram, "glDeleteProgram");
+    L(f_AttachShader, "glAttachShader");   L(f_LinkProgram, "glLinkProgram");
+    L(f_GetProgramiv, "glGetProgramiv");   L(f_GetProgramInfoLog, "glGetProgramInfoLog");
+    L(f_UseProgram, "glUseProgram");       L(f_GetUniformLocation, "glGetUniformLocation");
+    L(f_Uniform1i, "glUniform1i");         L(f_Uniform1f, "glUniform1f");
+    L(f_Uniform2f, "glUniform2f");         L(f_Uniform4f, "glUniform4f");
+    L(f_GenVertexArrays, "glGenVertexArrays"); L(f_DeleteVertexArrays, "glDeleteVertexArrays");
+    L(f_BindVertexArray, "glBindVertexArray"); L(f_ActiveTexture, "glActiveTexture");
+    L(f_GenFramebuffers, "glGenFramebuffers"); L(f_DeleteFramebuffers, "glDeleteFramebuffers");
+    L(f_BindFramebuffer, "glBindFramebuffer");
+    L(f_FramebufferTexture2D, "glFramebufferTexture2D");
+    L(f_CheckFramebufferStatus, "glCheckFramebufferStatus");
+    L(f_BlendEquationSeparate, "glBlendEquationSeparate");
+#undef L
+    return ok;
+}
+
+static int init(void) {
+    if (s_state) return s_state > 0;
+    s_state = -1;
+    if (!load()) {
+        fprintf(stdout, "psxrecomp: post-processing disabled: GL entry points missing\n");
+        return 0;
+    }
+    static const struct { int id; const char **vs, **fs; } progs[] = {
+        { P_FXAA,    &VS_ROWS,   &FS_FXAA },
+        { P_CAS,     &VS_ROWS,   &FS_CAS },
+        { P_EDGE,    &VS_ROWS,   &FS_SMAA_EDGE },
+        { P_WEIGHTS, &VS_ROWS,   &FS_SMAA_WEIGHTS },
+        { P_BLEND,   &VS_ROWS,   &FS_SMAA_BLEND },
+        { P_BPRE,    &VS_ROWS,   &FS_BLOOM_PRE },
+        { P_BDOWN,   &VS_ROWS,   &FS_BLOOM_DOWN },
+        { P_BUP,     &VS_ROWS,   &FS_BLOOM_UP },
+        { P_COMP,    &VS_WINDOW, &FS_COMPOSITE },
+    };
+    for (size_t i = 0; i < sizeof(progs) / sizeof(progs[0]); i++) {
+        s_prog[progs[i].id] = link(*progs[i].vs, *progs[i].fs);
+        if (!s_prog[progs[i].id]) {
+            fprintf(stdout, "psxrecomp: post-processing disabled: shader %d\n", progs[i].id);
+            glpfx_shutdown();
+            s_state = -1;
+            return 0;
+        }
+    }
+    f_GenVertexArrays(1, &s_vao);
+    s_state = 1;
+    fprintf(stdout, "psxrecomp: post-processing chain ready (OpenGL)\n");
+    return 1;
+}
+
+static void tex_params(GLint filter) {
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filter);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+}
+
+static void target_free(Target *t) {
+    if (t->fbo) f_DeleteFramebuffers(1, &t->fbo);
+    if (t->tex) glDeleteTextures(1, &t->tex);
+    memset(t, 0, sizeof(*t));
+}
+
+static int target_make(Target *t, int w, int h, GLint ifmt, GLenum fmt, GLenum type) {
+    if (t->tex && t->w == w && t->h == h) return 1;
+    target_free(t);
+    glGenTextures(1, &t->tex);
+    f_ActiveTexture(PFX_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, t->tex);
+    tex_params(GL_LINEAR);
+    glTexImage2D(GL_TEXTURE_2D, 0, ifmt, w, h, 0, fmt, type, NULL);
+    f_GenFramebuffers(1, &t->fbo);
+    f_BindFramebuffer(PFX_FRAMEBUFFER, t->fbo);
+    f_FramebufferTexture2D(PFX_FRAMEBUFFER, PFX_COLOR_ATTACHMENT0, GL_TEXTURE_2D, t->tex, 0);
+    const GLenum st = f_CheckFramebufferStatus(PFX_FRAMEBUFFER);
+    f_BindFramebuffer(PFX_FRAMEBUFFER, 0);
+    if (st != PFX_FRAMEBUFFER_COMPLETE) {
+        target_free(t);
+        return 0;
+    }
+    t->w = w; t->h = h;
+    return 1;
+}
+
+static int smaa_luts(void) {
+    if (s_area_tex && s_search_tex) return 1;
+    uLongf n = (uLongf)SMAA_AREATEX_W * SMAA_AREATEX_H * 2;
+    unsigned char *area = (unsigned char *)malloc(n);
+    if (!area) return 0;
+    if (uncompress(area, &n, smaa_area_tex_z, sizeof(smaa_area_tex_z)) != Z_OK ||
+        n != (uLongf)SMAA_AREATEX_W * SMAA_AREATEX_H * 2) {
+        free(area);
+        fprintf(stdout, "psxrecomp: SMAA area texture failed to inflate\n");
+        return 0;
+    }
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+    f_ActiveTexture(PFX_TEXTURE0);
+    glGenTextures(1, &s_area_tex);
+    glBindTexture(GL_TEXTURE_2D, s_area_tex);
+    tex_params(GL_LINEAR);
+    glTexImage2D(GL_TEXTURE_2D, 0, PFX_RG8, SMAA_AREATEX_W, SMAA_AREATEX_H, 0,
+                 PFX_RG, GL_UNSIGNED_BYTE, area);
+    glGenTextures(1, &s_search_tex);
+    glBindTexture(GL_TEXTURE_2D, s_search_tex);
+    tex_params(GL_NEAREST);
+    glTexImage2D(GL_TEXTURE_2D, 0, PFX_R8, SMAA_SEARCHTEX_W, SMAA_SEARCHTEX_H, 0,
+                 PFX_RED, GL_UNSIGNED_BYTE, smaa_search_tex);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    free(area);
+    return 1;
+}
+
+unsigned glpfx_begin(int lw, int lh) {
+    if (lw < 16 || lh < 16 || lw > 16384 || lh > 16384) return 0;
+    if (!init()) return 0;
+    if (!target_make(&s_in, lw, lh, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE)) return 0;
+    s_w = lw; s_h = lh;
+    return s_in.fbo;
+}
+
+/* Bind a target, program and up to three source textures for one pass. */
+static void pass_begin(const Target *dst, int prog) {
+    f_BindFramebuffer(PFX_FRAMEBUFFER, dst ? dst->fbo : 0);
+    if (dst) glViewport(0, 0, dst->w, dst->h);
+    f_UseProgram(s_prog[prog]);
+}
+
+static void bind_tex(int unit, GLuint tex, const char *name, int prog) {
+    f_ActiveTexture(PFX_TEXTURE0 + unit);
+    glBindTexture(GL_TEXTURE_2D, tex);
+    f_Uniform1i(f_GetUniformLocation(s_prog[prog], name), unit);
+}
+
+static void draw(void) {
+    f_BindVertexArray(s_vao);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+}
+
+static GLint U(int prog, const char *name) { return f_GetUniformLocation(s_prog[prog], name); }
+
+void glpfx_end(int lx, int ly, int lw, int lh) {
+    const PostFxSettings *s = postfx_settings();
+    if (s_state <= 0 || !s_in.fbo) return;
+    const int w = s_w, h = s_h;
+    const float rw = 1.0f / (float)w, rh = 1.0f / (float)h;
+
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_STENCIL_TEST);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_BLEND);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+
+    const Target *cur = &s_in;
+    int pp = 0;
+
+    /* Anti-aliasing. */
+    if (s->aa == POSTFX_AA_FXAA &&
+        target_make(&s_pp[pp], w, h, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE)) {
+        pass_begin(&s_pp[pp], P_FXAA);
+        bind_tex(0, cur->tex, "u_src", P_FXAA);
+        f_Uniform2f(U(P_FXAA, "u_texel"), rw, rh);
+        draw();
+        cur = &s_pp[pp]; pp ^= 1;
+    } else if (s->aa == POSTFX_AA_SMAA && smaa_luts() &&
+               target_make(&s_edges, w, h, PFX_RG8, PFX_RG, GL_UNSIGNED_BYTE) &&
+               target_make(&s_weights, w, h, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE) &&
+               target_make(&s_pp[pp], w, h, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE)) {
+        /* Edges: cleared first, the pass discards where there are none. */
+        pass_begin(&s_edges, P_EDGE);
+        glClearColor(0.f, 0.f, 0.f, 0.f);
+        glClear(GL_COLOR_BUFFER_BIT);
+        bind_tex(0, cur->tex, "u_color", P_EDGE);
+        f_Uniform4f(U(P_EDGE, "u_rt"), rw, rh, (float)w, (float)h);
+        draw();
+        pass_begin(&s_weights, P_WEIGHTS);
+        bind_tex(0, s_edges.tex, "u_edges", P_WEIGHTS);
+        bind_tex(1, s_area_tex, "u_area", P_WEIGHTS);
+        bind_tex(2, s_search_tex, "u_search", P_WEIGHTS);
+        f_Uniform4f(U(P_WEIGHTS, "u_rt"), rw, rh, (float)w, (float)h);
+        draw();
+        pass_begin(&s_pp[pp], P_BLEND);
+        bind_tex(0, cur->tex, "u_color", P_BLEND);
+        bind_tex(1, s_weights.tex, "u_blend", P_BLEND);
+        f_Uniform4f(U(P_BLEND, "u_rt"), rw, rh, (float)w, (float)h);
+        draw();
+        cur = &s_pp[pp]; pp ^= 1;
+    }
+
+    /* Sharpening. */
+    if (s->sharpen > 0.0f &&
+        target_make(&s_pp[pp], w, h, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE)) {
+        pass_begin(&s_pp[pp], P_CAS);
+        bind_tex(0, cur->tex, "u_src", P_CAS);
+        f_Uniform1f(U(P_CAS, "u_sharp"), s->sharpen);
+        draw();
+        cur = &s_pp[pp]; pp ^= 1;
+    }
+
+    /* Bloom: prefilter to half size, dual-filter down, then up additively. */
+    int bloom = 0;
+    if (s->bloom > 0.0f) {
+        int bw = w, bh = h;
+        s_nbloom = 0;
+        for (int i = 0; i < BLOOM_LEVELS; i++) {
+            bw = bw / 2; bh = bh / 2;
+            if (bw < 8 || bh < 8) break;
+            if (!target_make(&s_bloom[i], bw, bh, PFX_RGBA16F, GL_RGBA, PFX_HALF_FLOAT)) break;
+            s_nbloom = i + 1;
+        }
+        if (s_nbloom > 0) {
+            pass_begin(&s_bloom[0], P_BPRE);
+            bind_tex(0, cur->tex, "u_src", P_BPRE);
+            f_Uniform2f(U(P_BPRE, "u_texel"), rw, rh);
+            f_Uniform1f(U(P_BPRE, "u_threshold"), s->bloom_threshold);
+            draw();
+            for (int i = 1; i < s_nbloom; i++) {
+                pass_begin(&s_bloom[i], P_BDOWN);
+                bind_tex(0, s_bloom[i - 1].tex, "u_src", P_BDOWN);
+                f_Uniform2f(U(P_BDOWN, "u_half"), 0.5f / (float)s_bloom[i - 1].w,
+                            0.5f / (float)s_bloom[i - 1].h);
+                draw();
+            }
+            glEnable(GL_BLEND);
+            f_BlendEquationSeparate(PFX_FUNC_ADD, PFX_FUNC_ADD);
+            glBlendFunc(GL_ONE, GL_ONE);
+            for (int i = s_nbloom - 1; i > 0; i--) {
+                pass_begin(&s_bloom[i - 1], P_BUP);
+                bind_tex(0, s_bloom[i].tex, "u_src", P_BUP);
+                f_Uniform2f(U(P_BUP, "u_half"), 0.5f / (float)s_bloom[i].w,
+                            0.5f / (float)s_bloom[i].h);
+                draw();
+            }
+            glDisable(GL_BLEND);
+            bloom = 1;
+        }
+    }
+
+    /* Composite into the window. */
+    const int grade = s->brightness != 0.0f || s->contrast != 1.0f ||
+                      s->saturation != 1.0f || s->gamma != 1.0f || s->temperature != 0.0f;
+    f_BindFramebuffer(PFX_FRAMEBUFFER, 0);
+    glViewport(lx, ly, lw, lh);
+    f_UseProgram(s_prog[P_COMP]);
+    bind_tex(0, cur->tex, "u_src", P_COMP);
+    bind_tex(1, bloom ? s_bloom[0].tex : cur->tex, "u_bloom", P_COMP);
+    /* Every level adds its own copy of the thresholded light on the way up,
+     * so the sum is about s_nbloom times it: normalise, then cap full strength
+     * at a glow rather than a wash-out. */
+    f_Uniform1f(U(P_COMP, "u_bloom_amt"),
+                bloom ? s->bloom * 0.8f / (float)s_nbloom : 0.0f);
+    f_Uniform4f(U(P_COMP, "u_grade0"), s->brightness, s->contrast, s->saturation,
+                1.0f / (s->gamma > 0.05f ? s->gamma : 0.05f));
+    f_Uniform4f(U(P_COMP, "u_grade1"), s->temperature, s->vignette, s->grain,
+                (grade || bloom) ? 1.0f : 0.0f);
+    f_Uniform2f(U(P_COMP, "u_size"), (float)lw, (float)lh);
+    f_Uniform1f(U(P_COMP, "u_seed"), (float)(s_frame++ % 4096u) * 7.31f);
+    draw();
+
+    f_BindVertexArray(0);
+    f_UseProgram(0);
+    for (int unit = 2; unit >= 0; unit--) {
+        f_ActiveTexture(PFX_TEXTURE0 + unit);
+        glBindTexture(GL_TEXTURE_2D, 0);
+    }
+}
+
+void glpfx_shutdown(void) {
+    if (s_state == 0) return;
+    for (int i = 0; i < P_COUNT; i++)
+        if (s_prog[i] && f_DeleteProgram) { f_DeleteProgram(s_prog[i]); s_prog[i] = 0; }
+    if (s_vao && f_DeleteVertexArrays) { f_DeleteVertexArrays(1, &s_vao); s_vao = 0; }
+    if (f_DeleteFramebuffers) {
+        target_free(&s_in);
+        target_free(&s_pp[0]);
+        target_free(&s_pp[1]);
+        target_free(&s_edges);
+        target_free(&s_weights);
+        for (int i = 0; i < BLOOM_LEVELS; i++) target_free(&s_bloom[i]);
+    }
+    if (s_area_tex) { glDeleteTextures(1, &s_area_tex); s_area_tex = 0; }
+    if (s_search_tex) { glDeleteTextures(1, &s_search_tex); s_search_tex = 0; }
+    s_state = 0;
+}

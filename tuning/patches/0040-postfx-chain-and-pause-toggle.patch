+/* gpu_postfx.c - PSX_POSTFX parsing and the runtime on/off switch.
+ * See gpu_postfx.h. Renderer-independent: the GL chain lives in
+ * gpu_gl_postfx.c, and any other backend reads the same settings. */
+#include "gpu_postfx.h"
+
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static PostFxSettings s_settings;
+static int s_loaded = 0;
+static int s_enabled = 1;
+
+static void neutral(PostFxSettings *s) {
+    memset(s, 0, sizeof(*s));
+    s->aa = POSTFX_AA_OFF;
+    s->contrast = 1.0f;
+    s->saturation = 1.0f;
+    s->gamma = 1.0f;
+    s->bloom_threshold = 0.7f;
+}
+
+static float clampf(float v, float lo, float hi) {
+    return v < lo ? lo : (v > hi ? hi : v);
+}
+
+/* Integer percent -> float, clamped to the launcher's range first. */
+static float pct(const char *v, int lo, int hi) {
+    long n = strtol(v, NULL, 10);
+    if (n < lo) n = lo;
+    if (n > hi) n = hi;
+    return (float)n / 100.0f;
+}
+
+void postfx_parse(const char *text, PostFxSettings *out) {
+    neutral(out);
+    if (!text) return;
+    char buf[512];
+    snprintf(buf, sizeof(buf), "%s", text);
+    for (char *tok = strtok(buf, ";,"); tok; tok = strtok(NULL, ";,")) {
+        char *eq = strchr(tok, '=');
+        if (!eq) continue;
+        *eq = 0;
+        char *k = tok, *v = eq + 1;
+        while (*k && isspace((unsigned char)*k)) k++;
+        for (char *e = k + strlen(k); e > k && isspace((unsigned char)e[-1]); ) *--e = 0;
+        while (*v && isspace((unsigned char)*v)) v++;
+        if (!strcmp(k, "aa")) {
+            out->aa = !strncmp(v, "smaa", 4) ? POSTFX_AA_SMAA
+                    : !strncmp(v, "fxaa", 4) ? POSTFX_AA_FXAA : POSTFX_AA_OFF;
+        } else if (!strcmp(k, "sharpen")) {
+            out->sharpen = pct(v, 0, 100);
+        } else if (!strcmp(k, "brightness")) {
+            out->brightness = pct(v, -50, 50) * 0.5f;          /* +-0.25 */
+        } else if (!strcmp(k, "contrast")) {
+            out->contrast = pct(v, 50, 150);
+        } else if (!strcmp(k, "saturation")) {
+            out->saturation = pct(v, 0, 200);
+        } else if (!strcmp(k, "gamma")) {
+            out->gamma = pct(v, 50, 200);
+        } else if (!strcmp(k, "temperature")) {
+            out->temperature = pct(v, -100, 100);
+        } else if (!strcmp(k, "bloom")) {
+            out->bloom = pct(v, 0, 100);
+        } else if (!strcmp(k, "bloom_threshold")) {
+            out->bloom_threshold = pct(v, 0, 100);
+        } else if (!strcmp(k, "vignette")) {
+            out->vignette = pct(v, 0, 100);
+        } else if (!strcmp(k, "grain")) {
+            out->grain = pct(v, 0, 100);
+        } else if (!strcmp(k, "dedither")) {
+            out->dedither = (v[0] == '1' || !strncmp(v, "on", 2) || !strncmp(v, "true", 4));
+        }
+    }
+    out->bloom_threshold = clampf(out->bloom_threshold, 0.0f, 1.0f);
+}
+
+const PostFxSettings *postfx_settings(void) {
+    if (!s_loaded) {
+        const char *env = getenv("PSX_POSTFX");
+        postfx_parse(env, &s_settings);
+        s_loaded = 1;
+        if (env && env[0]) {
+            const PostFxSettings *s = &s_settings;
+            fprintf(stdout,
+                "psxrecomp: post-processing: aa=%s sharpen=%.2f bloom=%.2f@%.2f "
+                "grade(b=%.2f c=%.2f s=%.2f g=%.2f t=%.2f) vignette=%.2f grain=%.2f "
+                "dedither=%d\n",
+                s->aa == POSTFX_AA_SMAA ? "smaa" : s->aa == POSTFX_AA_FXAA ? "fxaa" : "off",
+                s->sharpen, s->bloom, s->bloom_threshold, s->brightness, s->contrast,
+                s->saturation, s->gamma, s->temperature, s->vignette, s->grain,
+                s->dedither);
+        }
+    }
+    return &s_settings;
+}
+
+int postfx_chain_wanted(const PostFxSettings *s) {
+    return s->aa != POSTFX_AA_OFF || s->sharpen > 0.0f || s->bloom > 0.0f ||
+           s->brightness != 0.0f || s->contrast != 1.0f || s->saturation != 1.0f ||
+           s->gamma != 1.0f || s->temperature != 0.0f || s->vignette > 0.0f ||
+           s->grain > 0.0f;
+}
+
+int  postfx_enabled(void) { return s_enabled; }
+void postfx_set_enabled(int on) { s_enabled = on ? 1 : 0; }
+
+int postfx_active(void) {
+    return s_enabled && postfx_chain_wanted(postfx_settings());
+}
+
+int postfx_dedither_active(void) {
+    return s_enabled && postfx_settings()->dedither;
+}

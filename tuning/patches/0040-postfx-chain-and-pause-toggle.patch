+/* gpu_postfx.h - output post-processing settings, shared by the renderers.
+ *
+ * Post-processing runs on the finished game image at output resolution, after
+ * the present filter and before the host OSD / pause menu, which are drawn on
+ * top untouched. The chain, in order:
+ *
+ *   anti-aliasing   FXAA or SMAA 1x
+ *   sharpening      contrast-adaptive (after AMD FidelityFX CAS)
+ *   bloom           thresholded, dual-filter blur, added in linear light
+ *   grade           brightness, contrast, saturation, gamma, temperature
+ *   vignette, film grain, and an 8-bit output dither against banding
+ *
+ * plus one option that is not post-processing but lives with it: smoothing
+ * the dither patterns baked into the game's own textures (dedither), applied
+ * where textures are sampled.
+ *
+ * Settings come from PSX_POSTFX, written by the launcher as semicolon-
+ * separated key=value pairs in the launcher's own units (percent):
+ *
+ *   aa=off|fxaa|smaa  sharpen=0..100  brightness=-50..50  contrast=50..150
+ *   saturation=0..200  gamma=50..200  temperature=-100..100  bloom=0..100
+ *   bloom_threshold=0..100  vignette=0..100  grain=0..100  dedither=0|1
+ *
+ * Unknown keys are ignored and every value is clamped, so an older runtime
+ * reads a newer launcher's string safely. Missing keys are neutral. */
+#ifndef GPU_POSTFX_H
+#define GPU_POSTFX_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { POSTFX_AA_OFF = 0, POSTFX_AA_FXAA = 1, POSTFX_AA_SMAA = 2 };
+
+typedef struct {
+    int   aa;               /* POSTFX_AA_*                                  */
+    float sharpen;          /* 0..1                                         */
+    float brightness;       /* -0.25..0.25, added                           */
+    float contrast;         /* 0.5..1.5 around mid grey                     */
+    float saturation;       /* 0..2                                         */
+    float gamma;            /* 0.5..2, output = input^(1/gamma)             */
+    float temperature;      /* -1..1, warm positive                         */
+    float bloom;            /* 0..1 intensity                               */
+    float bloom_threshold;  /* 0..1 luminance where bloom starts            */
+    float vignette;         /* 0..1                                         */
+    float grain;            /* 0..1                                         */
+    int   dedither;         /* smooth baked texture dither                  */
+} PostFxSettings;
+
+/* Parse PSX_POSTFX once (later calls return the cached result). */
+const PostFxSettings *postfx_settings(void);
+
+/* Parse a settings string (exposed for tests); NULL gives the neutral set. */
+void postfx_parse(const char *text, PostFxSettings *out);
+
+/* 1 if any output pass is non-neutral (the chain has work to do). */
+int postfx_chain_wanted(const PostFxSettings *s);
+
+/* Runtime A/B switch (pause menu "POST FX"): 1 = on (default), 0 = bypass.
+ * Bypass skips the output chain and the texture dedither alike. */
+int  postfx_enabled(void);
+void postfx_set_enabled(int on);
+
+/* The chain is configured AND enabled right now. */
+int postfx_active(void);
+
+/* Texture dedither is configured AND enabled right now. */
+int postfx_dedither_active(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif

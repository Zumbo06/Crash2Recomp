+#define C2_60_GOOL_FLAG_SLOT 4u           /* below the caller's sp: its sp+60 */
+#define C2_60_CRASH          0x8005F38Cu  /* the crash object pointer */
+#define C2_60_PHYS_RET       0x8001C9ECu  /* physics returning into it */

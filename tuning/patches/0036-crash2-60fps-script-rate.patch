+/* The block edges inside the object update that the pacing needs. */
+static void c2_60_gool_edge(CPUState *cpu, uint32_t pc)
+{
+    if (!c2_60_gool_active) return;
+    if (pc == C2_60_CTX_RET_OBJS || pc == C2_60_CTX_RET_PHYS) {
+        c2_60_poke(C2_60_SCRIPT_TICKS,
+                   c2_60_gool_ticks < C2_60_TICK_CLAMP
+                       ? c2_60_gool_ticks : C2_60_TICK_CLAMP);
+        return;
+    }
+    const uint32_t obj = cpu->gpr[16];  /* s0: the object, all through 0x8001C718 */
+    if (pc == C2_60_PHYS_RET) {
+        if (!c2_60_gool_step) {
+            c2_60_ff_obj = obj;
+            c2_60_ff_bit = c2_60_peek(obj + C2_60_STATUS_A) & C2_60_FIRST_FRAME;
+        }
+        return;
+    }
+    /* C2_60_AFTER_FF_CLEAR - reached from both the animate and the idle path;
+     * only a physics-only field's animate path armed c2_60_ff_obj. */
+    if (c2_60_ff_obj && c2_60_ff_obj == obj) {
+        if (c2_60_ff_bit)
+            c2_60_poke(obj + C2_60_STATUS_A,
+                       c2_60_peek(obj + C2_60_STATUS_A) | C2_60_FIRST_FRAME);
+        c2_60_ff_obj = 0;
+    }
+}

+/* Once per outer loop, before any object runs: is this loop a script step? */
+static void c2_60_gool_loop(void)
+{
+    extern int psx_netplay_active(void);
+    if (c2_60_gool_enabled < 0) {
+        const char *e = getenv("PSX_CRASH2_60FPS_SCRIPT_RATE");
+        c2_60_gool_enabled = (e && e[0] == '0') ? 0 : 1;
+    }
+    if (c2_60_restored) {
+        /* RAM was replaced wholesale: nothing hidden or pending belongs to
+         * it, and the next loop starts a fresh step. */
+        c2_60_pad_hidden = 0;
+        c2_60_dc_valid = 0;
+        c2_60_ff_obj = 0;
+        c2_60_gool_since = 0;
+    }
+    /* Netplay rolls RAM back underneath this host-side count; keep the
+     * scripts per call there rather than let two peers disagree. */
+    const int active = c2_60_mode == 1 && c2_60_gool_enabled == 1 &&
+                       c2_60_gool_hooked && !psx_netplay_active();
+    const unsigned t = c2_60_last_frame_ticks;
+    int step = 1;
+    if (active && t != 0u) {
+        c2_60_gool_since += t;
+        if (c2_60_gool_since >= C2_60_STEP_TICKS) {
+            c2_60_gool_ticks = c2_60_gool_since;
+            c2_60_gool_since = 0;
+        } else {
+            step = 0;
+        }
+    } else {
+        c2_60_gool_since = 0;
+        c2_60_gool_ticks = t;
+    }
+    c2_60_gool_active = active;
+    c2_60_gool_step = step;
+    if (step) {
+        c2_60_gool_steps++;
+        c2_60_win_steps++;
+    } else {
+        c2_60_gool_fields++;
+    }
+
+    /* The finalizer advanced draw_count at the end of the loop just gone;
+     * on a physics-only field that advance is taken back, so the count moves
+     * once per script step. Only an advance of exactly one is ours to undo -
+     * a reset or a demo's own value is left as the guest set it. */
+    if (active) {
+        uint32_t dc = c2_60_peek(C2_60_DRAW_COUNT);
+        if (c2_60_dc_valid && !step && dc == c2_60_dc_last + 1u) {
+            c2_60_poke(C2_60_DRAW_COUNT, c2_60_dc_last);
+            dc = c2_60_dc_last;
+        }
+        c2_60_dc_last = dc;
+        c2_60_dc_valid = 1;
+    } else {
+        c2_60_dc_valid = 0;
+    }
+}

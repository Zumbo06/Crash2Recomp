+/* Guest memory through the host pointers, for the script-rate bookkeeping.
+ * These are the machine's own adjustments made from a hook, not guest stores:
+ * they have to land even in the load/store replay mode, where psx_write_word
+ * does not write, and must not enter the lockstep or data-shard recorders as
+ * guest traffic. Main RAM and the scratchpad - the flag goes wherever the
+ * stack is; anything else reads 0 and is not written. */
+static uint8_t *c2_60_ram(uint32_t address)
+{
+    extern uint8_t *memory_get_ram_ptr(void);
+    extern uint8_t *memory_get_scratchpad_ptr(void);
+    const uint32_t phys = address & 0x1FFFFFFFu;
+    if (address & 3u) return NULL;
+    if (phys <= 0x001FFFFCu) return memory_get_ram_ptr() + phys;
+    if (phys >= 0x1F800000u && phys <= 0x1F8003FCu)
+        return memory_get_scratchpad_ptr() + (phys - 0x1F800000u);
+    return NULL;
+}
+
+static uint32_t c2_60_peek(uint32_t address)
+{
+    const uint8_t *p = c2_60_ram(address);
+    uint32_t v = 0;
+    if (p) memcpy(&v, p, 4);
+    return v;
+}
+
+static void c2_60_poke(uint32_t address, uint32_t value)
+{
+    uint8_t *p = c2_60_ram(address);
+    if (p) memcpy(p, &value, 4);
+}

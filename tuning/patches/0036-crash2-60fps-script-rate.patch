+/* Hide the tapped bits for a physics-only field, or put them back just before
+ * the next read. The read (0x800158E0) copies tapped into tapped_prev (+48)
+ * and recomputes it, so restoring first is what lets a "tapped now or last
+ * time" test see what it saw at 30 Hz. A word the guest changed in between -
+ * a pad reset, a level load - is left alone. */
+static void c2_60_pad_edges(int step)
+{
+    if (!step) {
+        if (c2_60_pad_hidden) return;
+        uint32_t n = c2_60_peek(C2_60_PAD_COUNT);
+        if (n > C2_60_PAD_MAX) n = C2_60_PAD_MAX;
+        for (uint32_t i = 0; i < n; i++) {
+            const uint32_t pad = C2_60_PADS + i * C2_60_PAD_STRIDE;
+            c2_60_pad_tapped[i] = c2_60_peek(pad + C2_60_PAD_TAPPED);
+            c2_60_pad_held[i] = c2_60_peek(pad + C2_60_PAD_HELD);
+            c2_60_poke(pad + C2_60_PAD_TAPPED, 0u);
+        }
+        c2_60_pad_n = n;
+        c2_60_pad_hidden = 1;
+        return;
+    }
+    if (!c2_60_pad_hidden) return;
+    for (uint32_t i = 0; i < c2_60_pad_n; i++) {
+        const uint32_t pad = C2_60_PADS + i * C2_60_PAD_STRIDE;
+        if (c2_60_peek(pad + C2_60_PAD_TAPPED) == 0u &&
+            c2_60_peek(pad + C2_60_PAD_HELD) == c2_60_pad_held[i])
+            c2_60_poke(pad + C2_60_PAD_TAPPED, c2_60_pad_tapped[i]);
+    }
+    c2_60_pad_hidden = 0;
+}
+
+/* Entry to GoolObjectUpdate, before its first instruction: publish this call's
+ * flag. Written unconditionally - the patched function reads it on every call,
+ * in every mode - into the word that becomes sp+60 once the function has
+ * allocated its frame. Nothing runs in between: the first block is straight-
+ * line code whose only stores are the saved registers at sp+48..56. */
+static void c2_60_gool_entry(CPUState *cpu, uint32_t address)
+{
+    (void)address;
+    const uint32_t obj = cpu->gpr[4];
+    const uint32_t crash = c2_60_peek(C2_60_CRASH);
+    c2_60_gool_hooked = 1;
+    const int step = c2_60_gool_active ? c2_60_gool_step : 1;
+    c2_60_poke(cpu->gpr[29] - C2_60_GOOL_FLAG_SLOT,
+               step ? (crash ? crash : 1u) : 0u);
+    c2_60_ff_obj = 0;
+    /* Only the call that reaches the pad read: crash, and active (status 3). */
+    if (crash && obj == crash && c2_60_peek(obj + 4u) == 3u)
+        c2_60_pad_edges(step);
+}
+
+PSX_MOD_CONSTRUCTOR(c2_60_register_gool_entry)
+{
+    psx_mod_register_function_entry_plugin("crash2.native60.script_rate",
+                                           C2_60_GOOL_UPDATE, c2_60_gool_entry);
+}

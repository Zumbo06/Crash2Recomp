+/* SPU register catch-up (installed with spu_set_catchup).
+ *
+ * The SPU calls this before serving CURVOL / per-voice CURRENT volume and on
+ * KEYON/KEYOFF, so voice-allocation polling sees a live envelope instead of one
+ * up to a whole render block (~8 ms) stale. See the long note in spu.c: Crash 2
+ * picks free voices purely by reading CURVOL == 0, so a stale zero makes it key
+ * a second sound onto a voice it started microseconds earlier, truncating the
+ * first.
+ *
+ * Goes through the same gate as the mid-frame pump, so turbo mute and the
+ * discard-only sink keep their existing, user-validated semantics. */
+static void sdl_audio_catch_up(void) {
+    extern uint64_t psx_cycle_count;
+    static int in_catch_up = 0;
+    if (in_catch_up) return;   /* spu_render never reads registers; belt and braces */
+    /* Hot path: bail before touching the device or the bridge unless at least
+     * one whole output frame (768 guest cycles) is owed. Matches the frames
+     * computation in sdl_audio_pump exactly. */
+    if ((psx_cycle_count - s_audio_last_cycles) + s_audio_cycle_carry < 768u)
+        return;
+    in_catch_up = 1;
+    sdl_audio_pump_midframe();
+    in_catch_up = 0;
+}

+/* ---- guest-time catch-up ------------------------------------------------
+ *
+ * The SPU is pumped in blocks: the guest runs frozen while spu_render() emits
+ * ~8 ms of audio at once, so between pumps the envelope state is STALE by up
+ * to a whole block. That is invisible for output, and fatal for the registers
+ * the guest reads back to make decisions.
+ *
+ * Crash 2 (and the stock BIOS engine) allocate voices by polling CURVOL and
+ * taking any voice whose envelope reads 0 — measured: ~280k CURVOL reads and
+ * ZERO ENDX reads across a session, so CURVOL is the ONLY signal the game
+ * uses. Key a sound on, poll a few hundred cycles later, and our env_level is
+ * still exactly 0 because no render has happened yet; the game concludes the
+ * voice it just keyed is free and keys another sound onto it, truncating the
+ * first. On hardware the envelope has already advanced hundreds of samples.
+ *
+ * So: before serving any envelope-derived register, render up to the guest's
+ * current cycle. The host owns the cycle accounting and the output sink, so it
+ * installs the callback (main.cpp) rather than spu.c reaching for either.
+ *
+ * The callback MUST early-out when less than one output frame (768 guest
+ * cycles) is due — this runs on the CURVOL path, hundreds of thousands of
+ * times per session. */
+static void (*s_catchup_fn)(void) = NULL;
+
+void spu_set_catchup(void (*fn)(void)) { s_catchup_fn = fn; }
+
+static inline void spu_catch_up(void) {
+    if (s_catchup_fn) s_catchup_fn();
+}

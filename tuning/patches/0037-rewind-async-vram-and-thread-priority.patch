+/* The same picture capture_thumb() takes, built from a VRAM image instead of
+ * the renderer's CPU copy - which an asynchronous download leaves as stale as
+ * it was. Mirrors gpu_display_pixel_rgb, minus the optional screen colour LUT
+ * (a thumbnail, not the picture). Bytes are little-endian halfwords at any
+ * alignment. */
+static uint8_t rw_vram_byte(const uint8_t *v, uint32_t byte_x, uint32_t vy)
+{
+    return v[((size_t)(vy & 511u) * 1024u) * 2u + (byte_x & 2047u)];
+}
+
+static void thumb_from_vram(uint32_t *dst, const GpuDisplayInfo *di,
+                            const uint8_t *v)
+{
+    uint32_t dw, dh, x, y;
+    dw = di->width ? di->width : 320u;
+    dh = di->height ? di->height : 240u;
+    if (di->disabled) {
+        memset(dst, 0, (size_t)RW_THUMB_W * RW_THUMB_H * sizeof(uint32_t));
+        return;
+    }
+    for (y = 0; y < RW_THUMB_H; y++) {
+        uint32_t sy = y * dh / RW_THUMB_H;
+        uint32_t vy = (di->display_y + sy) & 511u;
+        for (x = 0; x < RW_THUMB_W; x++) {
+            uint32_t sx = x * dw / RW_THUMB_W;
+            uint32_t r, g, b;
+            if (di->depth24) {
+                uint32_t byte_x = ((di->display_x & 1023u) * 2u) + sx * 3u;
+                if (byte_x + 2u >= 2048u) {
+                    r = g = b = 0;
+                } else {
+                    r = rw_vram_byte(v, byte_x + 0u, vy);
+                    g = rw_vram_byte(v, byte_x + 1u, vy);
+                    b = rw_vram_byte(v, byte_x + 2u, vy);
+                }
+            } else {
+                uint32_t vx = (di->display_x + sx) & 1023u;
+                const uint8_t *p = v + ((size_t)vy * 1024u + vx) * 2u;
+                uint32_t c = (uint32_t)p[0] | ((uint32_t)p[1] << 8);
+                r = (c & 0x1Fu) << 3;
+                g = ((c >> 5) & 0x1Fu) << 3;
+                b = ((c >> 10) & 0x1Fu) << 3;
+            }
+            dst[y * RW_THUMB_W + x] = 0xFF000000u | (r << 16) | (g << 8) | b;
+        }
+    }

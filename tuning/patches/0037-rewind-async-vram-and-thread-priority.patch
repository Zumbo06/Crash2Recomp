+/* ---- asynchronous whole-VRAM download ------------------------------------ */
+/* ensure_cpu() is correct but synchronous: glReadPixels into client memory
+ * makes the CPU wait until the GPU has finished every queued command. A caller
+ * that only needs VRAM "as of now" some time later - the rewind ring, four
+ * times a second - paid that wait on the emulation thread every time, which
+ * is a missed field whenever the GPU had most of a frame queued.
+ *
+ * This queues the same pack + read into a pixel-pack buffer instead, fences
+ * it, and hands the bytes over once the fence has signalled. It deliberately
+ * leaves s_vram and s_gpu_dirty alone: the CPU copy is no more current than
+ * before, and the next real ensure_cpu() reads back as it always did. */
+static GLuint    s_rb_pbo;
+static PSXGLsync s_rb_fence;
+static int       s_rb_pending;
+
+static int glb_vram_readback_begin(void)
+{
+    extern int psx_netplay_active(void);
+    if (!p_glFenceSync || !p_glClientWaitSync || !p_glDeleteSync ||
+        !p_glMapBufferRange || !p_glUnmapBuffer)
+        return 0;
+    /* Nothing to wait for: the CPU copy is current (or authoritative), so the
+     * caller's gr_vram_transfer_out is a plain copy with no GPU round-trip. */
+    if (!s_raster_ok || !s_gpu_dirty || s_cpu_auth_dual || psx_netplay_active())
+        return 0;
+    if (s_rb_pending)
+        return 0;
+    flush_flat_batch();
+    flush_tex_batch();
+    flush_cpu_upload();
+    pack_flush();
+    if (!s_rb_pbo) {
+        p_glGenBuffers(1, &s_rb_pbo);
+        p_glBindBuffer(PSXGL_PIXEL_PACK_BUFFER, s_rb_pbo);
+        p_glBufferData(PSXGL_PIXEL_PACK_BUFFER,
+                       (ptrdiff_t)VRAM_W * VRAM_H * (ptrdiff_t)sizeof(uint16_t),
+                       NULL, PSXGL_STREAM_READ);
+    } else {
+        p_glBindBuffer(PSXGL_PIXEL_PACK_BUFFER, s_rb_pbo);
+    }
+    p_glBindFramebuffer(PSXGL_READ_FRAMEBUFFER, s_raw_fbo);
+    glReadPixels(0, 0, VRAM_W, VRAM_H, PSXGL_RED_INTEGER, GL_UNSIGNED_SHORT, (void *)0);
+    p_glBindFramebuffer(PSXGL_READ_FRAMEBUFFER, 0);
+    p_glBindBuffer(PSXGL_PIXEL_PACK_BUFFER, 0);
+    s_rb_fence = p_glFenceSync(PSXGL_SYNC_GPU_COMMANDS_DONE, 0);
+    if (!s_rb_fence)
+        return 0;
+    glFlush();   /* submit now, so a later zero-timeout poll can see it signal */
+    s_rb_pending = 1;
+    return 1;
+}
+
+static int glb_vram_readback_poll(uint16_t *dst, int block)
+{
+    if (!s_rb_pending)
+        return -1;
+    const GLenum r = p_glClientWaitSync(s_rb_fence, PSXGL_SYNC_FLUSH_COMMANDS_BIT,
+                                        block ? (GLuint64)5000000000ull : 0u);
+    if (r == PSXGL_TIMEOUT_EXPIRED && !block)
+        return 0;
+    p_glDeleteSync(s_rb_fence);
+    s_rb_fence = NULL;
+    s_rb_pending = 0;
+    if (r == PSXGL_WAIT_FAILED || !dst)
+        return dst ? -1 : 1;
+    int ok = 0;
+    p_glBindBuffer(PSXGL_PIXEL_PACK_BUFFER, s_rb_pbo);
+    const void *src = p_glMapBufferRange(PSXGL_PIXEL_PACK_BUFFER, 0,
+                                         (ptrdiff_t)VRAM_W * VRAM_H * (ptrdiff_t)sizeof(uint16_t),
+                                         PSXGL_MAP_READ_BIT);
+    if (src) {
+        memcpy(dst, src, (size_t)VRAM_W * VRAM_H * sizeof(uint16_t));
+        p_glUnmapBuffer(PSXGL_PIXEL_PACK_BUFFER);
+        ok = 1;
+    }
+    p_glBindBuffer(PSXGL_PIXEL_PACK_BUFFER, 0);
+    return ok ? 1 : -1;
+}

+#define C2_120_SND_MODE      0x8005EFD8u  /* libsnd tick mode; 5 = VSync */
+#define C2_120_SND_TICK      0x80054F04u
+#define C2_120_SND_NOP       0x80016EFCu  /* jr ra; nop - referenced nowhere */
+#define C2_120_VSYNC_CBS     0x8005DC78u  /* libetc's eight VSync callbacks */

+/* Use the same orderly teardown as closing the SDL window: flush cards, stop
+ * and join overlay compilation, close audio/controllers and notify netplay. */
+static void pause_menu_quit_game(void) {
+    std::fprintf(stdout, "psxrecomp: quit requested from pause menu\n");
+    std::fflush(stdout);
+    psx_crash_trace_set_exit_origin("pause_menu_quit");
+    shutdown_runtime();
+    std::exit(0);
+}

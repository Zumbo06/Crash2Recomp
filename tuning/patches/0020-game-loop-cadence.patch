--- /dev/null
+++ b/runtime/src/crash2_sim_tick.h
@@ -0,0 +1,23 @@
+/* SCUS-94154 main-loop cadence probe. Diagnostic only, no guest writes.
+ *
+ * Do not count the camera helper at 800200A8/RA 80022854 as a simulation
+ * tick: it runs twice per loop. Entry 80011848 is the outer game loop; a
+ * PC probe measured one visit for each displayed gameplay frame at stock
+ * speed. This is not proof that every subsystem simulates once. */
+static unsigned long long c2game_loop_steps;
+static int c2game_loop_verified = -1;
+
+unsigned long long crash2_sim_tick_count(void) { return c2game_loop_steps; }
+int crash2_sim_tick_verified(void) { return c2game_loop_verified; }
+
+static void crash2_sim_tick(CPUState *cpu, uint32_t pc)
+{
+    if (pc != 0x80011848u) return;
+    if (c2game_loop_verified < 0) {
+        c2game_loop_verified =
+            cpu->read_word(0x80011848u) == 0x3C028007u &&
+            cpu->read_word(0x8001184Cu) == 0x8C429944u &&
+            cpu->read_word(0x80011854u) == 0x30420800u;
+    }
+    if (c2game_loop_verified) c2game_loop_steps++;
+}

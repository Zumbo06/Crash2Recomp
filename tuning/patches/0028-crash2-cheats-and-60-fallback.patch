diff --git a/runtime/src/crash2_cheats.h b/runtime/src/crash2_cheats.h
new file mode 100644
index 0000000..dc7cce3
--- /dev/null
+++ b/runtime/src/crash2_cheats.h
@@ -0,0 +1,58 @@
+/* SCUS-94154-only, deliberately narrow gameplay assists.
+ * Called at the outer game-loop boundary, never from the rendering thread.
+ * No writes are made unless the exact game's loop signature is present.
+ */
+#ifndef CRASH2_CHEATS_H
+#define CRASH2_CHEATS_H
+
+#include <stdint.h>
+#include <stdlib.h>
+
+#define C2_CHEAT_LOOP_PC 0x80011848u
+#define C2_CHEAT_LIVES   0x8006CBD1u
+#define C2_CHEAT_AKU     0x8006CBD5u
+
+static int c2_cheats_initialized;
+static int c2_cheat_lives;
+static int c2_cheat_aku;
+
+static void c2_cheats_init(void)
+{
+    if (c2_cheats_initialized) return;
+    const char *lives = getenv("PSX_CRASH2_CHEAT_LIVES");
+    const char *aku = getenv("PSX_CRASH2_CHEAT_AKU");
+    c2_cheat_lives = lives && lives[0] == '1' && lives[1] == '\0';
+    c2_cheat_aku = aku && aku[0] == '1' && aku[1] == '\0';
+    c2_cheats_initialized = 1;
+}
+
+int crash2_cheat_lives_enabled(void) { c2_cheats_init(); return c2_cheat_lives; }
+int crash2_cheat_aku_enabled(void) { c2_cheats_init(); return c2_cheat_aku; }
+void crash2_cheat_set_lives(int on) { c2_cheats_init(); c2_cheat_lives = on != 0; }
+void crash2_cheat_set_aku(int on) { c2_cheats_init(); c2_cheat_aku = on != 0; }
+
+static void crash2_cheats_tick(CPUState *cpu, uint32_t pc)
+{
+    extern uint8_t psx_read_byte(uint32_t addr);
+    extern void psx_write_byte(uint32_t addr, uint8_t value);
+    if (pc != C2_CHEAT_LOOP_PC ||
+        cpu->read_word(C2_CHEAT_LOOP_PC) != 0x3C028007u ||
+        cpu->read_word(C2_CHEAT_LOOP_PC + 4u) != 0x8C429944u)
+        return;
+
+    c2_cheats_init();
+
+    /* 99 rather than an out-of-range sentinel keeps the game's UI and
+     * save-card format inside their normal two-digit range. Turning the cheat
+     * off leaves the current value; it does not erase lives legitimately
+     * earned while the cheat was active. */
+    if (c2_cheat_lives && psx_read_byte(C2_CHEAT_LIVES) < 99u)
+        psx_write_byte(C2_CHEAT_LIVES, 99u);
+
+    /* Never lower 3 (the game's temporary invincible-mask state). The global
+     * value is copied to the level's own shadow on transition. */
+    if (c2_cheat_aku && psx_read_byte(C2_CHEAT_AKU) < 2u)
+        psx_write_byte(C2_CHEAT_AKU, 2u);
+}
+
+#endif /* CRASH2_CHEATS_H */

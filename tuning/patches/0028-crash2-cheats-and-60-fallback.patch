diff --git a/runtime/src/debug_server.c b/runtime/src/debug_server.c
--- a/runtime/src/debug_server.c
+++ b/runtime/src/debug_server.c
@@ -8122,2 +8122,23 @@
              id, current == bypass ? "true" : "false", current);
 }
+
+/* Query or toggle the same assists the launcher and Home menu use. The
+ * response includes the actual global bytes so automation can distinguish an
+ * enabled flag from an effective write. Debugtools only. */
+static void handle_crash2_cheats(int id, const char *json)
+{
+    extern int crash2_cheat_lives_enabled(void);
+    extern int crash2_cheat_aku_enabled(void);
+    extern void crash2_cheat_set_lives(int on);
+    extern void crash2_cheat_set_aku(int on);
+    int lives = json_get_int(json, "lives", -1);
+    int aku = json_get_int(json, "aku", -1);
+    if (lives >= 0) crash2_cheat_set_lives(lives);
+    if (aku >= 0) crash2_cheat_set_aku(aku);
+    send_fmt("{\"id\":%d,\"ok\":true,\"lives\":%s,\"aku\":%s,"
+             "\"lives_value\":%u,\"aku_value\":%u}",
+             id, crash2_cheat_lives_enabled() ? "true" : "false",
+             crash2_cheat_aku_enabled() ? "true" : "false",
+             (unsigned)psx_read_byte(0x8006CBD1u),
+             (unsigned)psx_read_byte(0x8006CBD5u));
+}

+/* Native-wide surfaces are by far the largest allocations this renderer makes:
+ * at supersampling 5 a 682-px-wide surface is 3410x2560 RGBA8 plus a matching
+ * D24S8 renderbuffer — ~70 MB per surface, up to WIDE_MAX_SURF of them, built
+ * synchronously on first engage. Neither glTexImage2D nor glRenderbufferStorage
+ * reports failure through a return value, so an out-of-memory driver handed back
+ * object ids whose storage was never allocated and every later draw mirrored
+ * into them regardless. Check explicitly, and LATCH the failure: retrying a
+ * 70 MB allocation every frame is far worse than the degraded present the
+ * callers already handle (all of them treat 0 as "skip the wide mirror").
+ * wide_free_all() clears the latch, so a reconfigure at a smaller internal
+ * scale gets a fresh attempt. */
+#define PSXGL_MAX_RENDERBUFFER_SIZE 0x84E8
+static int s_wide_alloc_failed = 0;
+
+static void gl_drain_errors(void) {
+    /* Bounded: a lost context reports the same error forever. */
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; i++) { }
+}
+
+/* Reject dimensions the driver cannot represent before asking it to allocate
+ * them — an oversized request is the one failure mode that is cheap to predict.
+ */
+static int wide_dims_supported(int w, int h) {
+    GLint max_tex = 0, max_rb = 0;
+    gl_drain_errors();
+    glGetIntegerv(GL_MAX_TEXTURE_SIZE, &max_tex);
+    glGetIntegerv(PSXGL_MAX_RENDERBUFFER_SIZE, &max_rb);
+    /* GL_MAX_RENDERBUFFER_SIZE is FBO-era; on a driver that rejects the query
+     * fall back to the texture limit rather than treating 0 as "no limit". */
+    if (glGetError() != GL_NO_ERROR || max_rb <= 0) max_rb = max_tex;
+    if (max_tex > 0 && (w > max_tex || h > max_tex)) return 0;
+    if (max_rb  > 0 && (w > max_rb  || h > max_rb))  return 0;
+    return 1;
+}
+
+static void wide_alloc_fail(const char *what, int w, int h) {
+    if (!s_wide_alloc_failed)
+        fprintf(stdout,
+                "psxrecomp: native-wide %s allocation failed at %dx%d "
+                "(internal scale %dx); falling back to the canonical present. "
+                "Lower [video] supersampling to use native widescreen.\n",
+                what, w, h, s_scale);
+    s_wide_alloc_failed = 1;
+}
+

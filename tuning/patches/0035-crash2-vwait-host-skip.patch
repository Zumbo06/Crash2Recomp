+static void c2_60_vwait_skip(CPUState *cpu)
+{
+    extern uint64_t psx_cycle_count;
+    extern uint32_t psx_cycles_to_next_idle_event(void);
+    extern void psx_advance_cycles(uint32_t cycles);
+    extern uint32_t psx_read_word(uint32_t address);
+    extern void psx_write_word(uint32_t address, uint32_t value);
+    extern int psx_get_in_exception(void);
+    extern int g_psx_call_bail, g_precise_mode, g_ls_mode, g_ls_replay_active;
+    extern int psx_netplay_active(void);
+    extern int psx_selfcheck_enabled(void);
+
+    if (c2_60_vw_enabled < 0) {
+        const char *e = getenv("PSX_CRASH2_VWAIT_SKIP");
+        c2_60_vw_enabled = (e && e[0] == '0') ? 0 : 1;
+    }
+    /* Same exclusions as the generic skip: anything replaying, resimulating
+     * or comparing instruction streams must see every pass. And only while
+     * this mode has the clock raised on the verified revision. */
+    if (!c2_60_vw_enabled || c2_60_mode != 1 || !c2_60_gate_open ||
+        c2_60_cpu_now <= 100 || c2_60_verified != 1 ||
+        g_ls_replay_active || psx_get_in_exception() || g_psx_call_bail ||
+        g_precise_mode || g_ls_mode != 0 ||
+        psx_netplay_active() || psx_selfcheck_enabled()) {
+        c2_60_vw_n = 0;
+        c2_60_vw_cycle = 0;
+        return;
+    }
+
+    const uint64_t now = psx_cycle_count;
+    const uint32_t sp = cpu->gpr[29], a0 = cpu->gpr[4];
+    const uint32_t t = psx_read_word(sp + 16u);
+    const int32_t vcount = (int32_t)psx_read_word(C2_60_VCOUNT);
+
+    /* A pass continues the last one when it is the same call (sp, target),
+     * the counter went down by exactly one, and nothing long happened in
+     * between - an interrupt handler shows up as an outsized gap. */
+    const uint64_t q = now - c2_60_vw_cycle;
+    if (c2_60_vw_cycle != 0 && sp == c2_60_vw_sp && a0 == c2_60_vw_a0 &&
+        t == c2_60_vw_t - 1u && q > 0 && q <= C2_60_VW_MAX_Q) {
+        c2_60_vw_n++;
+        c2_60_vw_qsum += q;
+        if ((uint32_t)q > c2_60_vw_qmax) c2_60_vw_qmax = (uint32_t)q;
+    } else {
+        c2_60_vw_n = 0;
+        c2_60_vw_qsum = 0;
+        c2_60_vw_qmax = 0;
+    }
+    c2_60_vw_cycle = now;
+    c2_60_vw_sp = sp;
+    c2_60_vw_a0 = a0;
+    c2_60_vw_t = t;
+
+    /* v1 = -1 is the loop's own sentinel; the wait must still be pending; and
+     * enough clean passes must have been measured to trust the average. */
+    if (cpu->gpr[3] != 0xFFFFFFFFu || !(vcount < (int32_t)a0) ||
+        c2_60_vw_n < C2_60_VW_MIN_STREAK || c2_60_vw_qmax == 0)
+        return;
+    /* Only a genuinely idle pass: nothing pending that a check would deliver.
+     * The generic skip has the same precondition, but it runs INSIDE the
+     * interrupt check, before deliverability is evaluated; this runs just
+     * after it, so it must test it itself - or it could fast-forward over an
+     * interrupt that is raised but not yet taken, and delay the very VBlank
+     * the loop is waiting for. */
+    if ((i_stat & i_mask) != 0u || in_exception ||
+        (cpu->cop0[COP0_CAUSE] & cpu->cop0[COP0_SR] & 0x0300u) != 0u)
+        return;
+    /* Leave the counter at 2 or more, so the pass after a skip cannot be the
+     * one that reaches -1: the game's own timeout stays reachable. */
+    if ((int32_t)t < 4) return;
+
+    const uint32_t dist = psx_cycles_to_next_idle_event();
+    const uint64_t keep = (uint64_t)C2_60_VW_MARGIN * c2_60_vw_qmax;
+    if ((uint64_t)dist <= keep + c2_60_vw_qmax) return;
+
+    /* Passes that fit before the margin, costed at the measured average. The
+     * average is exact for the 2-pass rhythm the fractional clock produces,
+     * and advancing k * qsum / n never lands past dist - keep. */
+    uint64_t k = (((uint64_t)dist - keep) * c2_60_vw_n) / c2_60_vw_qsum;
+    if (k > (uint64_t)((int32_t)t - 2)) k = (uint64_t)((int32_t)t - 2);
+    if (k == 0) return;
+    const uint64_t adv = (k * c2_60_vw_qsum) / c2_60_vw_n;
+    if (adv == 0 || adv > C2_60_VW_MAX_SKIP) return;
+
+    psx_write_word(sp + 16u, t - (uint32_t)k);
+    psx_advance_cycles((uint32_t)adv);
+    c2_60_vw_skips++;
+    c2_60_vw_skipped += adv;
+
+    /* The next pass continues from here: counter k lower, clock adv later. */
+    c2_60_vw_t = t - (uint32_t)k;
+    c2_60_vw_cycle = psx_cycle_count;
+}

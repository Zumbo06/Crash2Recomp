+/* The reveal margins of the displayed band's BORDER rows: rows no clipped draw
+ * could reach since the last present. Crash 2 draws into 512x216 at y=12 of a
+ * 512x240 display (SetDefDrawEnv at 0x80016130), so the 12 scanlines above and
+ * below the picture are written only by fills and uploads. The wide mirror
+ * follows those only in part - never an upload, and a fill only while
+ * native-wide is active - so these margins could keep a white flash beside the
+ * canonical black long after it. Make them match the canonical frame: copy its
+ * outermost g_wide_off columns of those rows into each margin. Crash 2's border
+ * rows are one colour, so that carries the edge colour out. It is an unscaled
+ * copy between two framebuffers, like wide_blit_center, so it works the same
+ * through the Direct3D 12 layer. Nothing happens when nothing was drawn since
+ * the last present (a paused or repeated frame keeps its margins) or when what
+ * was drawn belongs to another band. */
+static void wide_fill_border_rows(GLuint wide_fbo, int base_x, int disp_y, int disp_h) {
+    if (g_wide_w <= 0 || g_wide_off <= 0) return;
+    int i = 0;
+    while (i < WIDE_MAX_SURF && !(s_wide_fbo[i] && s_wide_fbo[i] == wide_fbo)) i++;
+    if (i == WIDE_MAX_SURF) return;
+    const int y1 = s_wide_drawn_y1[i], y2 = s_wide_drawn_y2[i];
+    if (y1 > y2) return;
+    int b0 = disp_y, b1 = disp_y + disp_h;
+    if (b0 < 0) b0 = 0;
+    if (b1 > VRAM_H) b1 = VRAM_H;
+    if (b1 <= b0 || y2 < b0 || y1 >= b1) return;
+    s_wide_drawn_y1[i] = VRAM_H; s_wide_drawn_y2[i] = -1;
+    const int off = g_wide_off, native_w = g_wide_w - 2 * g_wide_off, S = s_scale;
+    if (native_w < off) return;
+    const int rows[2][2] = { { b0, y1 < b1 ? y1 : b1 }, { y2 + 1 > b0 ? y2 + 1 : b0, b1 } };
+    p_glBindFramebuffer(PSXGL_READ_FRAMEBUFFER, s_hr_fbo);
+    p_glBindFramebuffer(PSXGL_DRAW_FRAMEBUFFER, wide_fbo);
+    glDisable(GL_SCISSOR_TEST);
+    for (int r = 0; r < 2; r++) {
+        const int r0 = rows[r][0], r1 = rows[r][1];
+        if (r1 <= r0) continue;
+        p_glBlitFramebuffer(base_x * S, r0 * S, (base_x + off) * S, r1 * S,
+                            0, r0 * S, off * S, r1 * S,
+                            GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        p_glBlitFramebuffer((base_x + native_w - off) * S, r0 * S,
+                            (base_x + native_w) * S, r1 * S,
+                            (off + native_w) * S, r0 * S, (2 * off + native_w) * S, r1 * S,
+                            GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        s_wide_border_fills++;
+    }
+    p_glBindFramebuffer(PSXGL_READ_FRAMEBUFFER, 0);
+    p_glBindFramebuffer(PSXGL_DRAW_FRAMEBUFFER, 0);
+}

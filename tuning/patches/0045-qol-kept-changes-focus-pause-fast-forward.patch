+static void pause_menu_on_focus_lost(void) {
+    extern int fntrace_is_game_started(void);
+    if (!pause_on_focus_loss_enabled() || pause_menu_open) return;
+    /* Not during boot, not in netplay (the peer keeps running), and not over
+     * another modal - those are paused already. */
+    if (!fntrace_is_game_started() || psx_netplay_active()) return;
+    if (savestate_menu_open || psx_rewind_is_open()) return;
+    pause_menu_toggle(0);
+}

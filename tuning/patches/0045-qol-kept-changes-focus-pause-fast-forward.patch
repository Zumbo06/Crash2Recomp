+/* ---------------------------------------------------------------------
+ * In-game changes the launcher keeps
+ *
+ * The Home menu's display and assist rows, the F readout key and the volume
+ * keys change only the running game. With PSX_MENU_PREFS_FILE set - the
+ * launcher passes a path in its userdata folder - every value changed this
+ * session is written there as JSON, keyed by the launcher's own setting names,
+ * and the launcher folds it into its settings when the game exits. Only
+ * touched values are written, so one the player never changed cannot undo a
+ * launcher choice made while the game was running. Alt+Enter / Ctrl+F stay
+ * temporary: they flip the window without changing the configured mode.
+ *
+ * Written when the menu closes and on every orderly exit (shutdown_runtime),
+ * never from the frame path: a held volume key must not write a file per
+ * repeat.
+ * ------------------------------------------------------------------- */
+static unsigned s_menu_prefs_changed = 0;   /* MENU_PREF_* touched this session */
+static int      s_menu_prefs_dirty = 0;     /* changed since the last write */
+
+static const std::filesystem::path &menu_prefs_path(void) {
+    static int read = 0;
+    static std::filesystem::path path;
+    if (!read) {
+        read = 1;
+#if defined(_WIN32)
+        if (const wchar_t *e = _wgetenv(L"PSX_MENU_PREFS_FILE")) path = e;
+#else
+        if (const char *e = std::getenv("PSX_MENU_PREFS_FILE")) path = e;
+#endif
+    }
+    return path;
+}
+
+static void menu_prefs_note(unsigned bits) {
+    if (menu_prefs_path().empty()) return;
+    s_menu_prefs_changed |= bits;
+    s_menu_prefs_dirty = 1;
+}
+
+static void menu_prefs_write(void) {
+    if (!s_menu_prefs_dirty) return;
+    const std::filesystem::path &path = menu_prefs_path();
+    if (path.empty()) return;
+    static const char *const kFit[PSX_PAUSE_FIT_COUNT] = {
+        "letterbox", "stretch", "fill", "fit_width"   /* FIT_LABEL order */
+    };
+    static const char *const kAku[PSX_PAUSE_AKU_COUNT] = {
+        "off", "keep_masks", "no_damage"              /* C2_AKU_* order */
+    };
+    const unsigned c = s_menu_prefs_changed;
+    std::string json = "{\n";
+    char line[160];
+    if (c & MENU_PREF_ASPECT) {
+        const int i = pause_menu_aspect_index();
+        std::snprintf(line, sizeof(line), "  \"aspect\": \"%d:%d\",\n",
+                      kPauseAspect[i][0], kPauseAspect[i][1]);
+        json += line;
+    }
+    if (c & MENU_PREF_FIT) {
+        const int m = (g_present_fit_mode >= 0 &&
+                       g_present_fit_mode < PSX_PAUSE_FIT_COUNT)
+                      ? g_present_fit_mode : 0;
+        /* The fit took the framing over (pause_menu_apply_fit), so the dials
+         * it cleared are part of the change. */
+        std::snprintf(line, sizeof(line),
+                      "  \"scaling_mode\": \"%s\",\n"
+                      "  \"present_zoom\": -1,\n  \"present_stretch\": 0,\n",
+                      kFit[m]);
+        json += line;
+    }
+    if (c & MENU_PREF_WINDOW) {
+        std::snprintf(line, sizeof(line), "  \"fullscreen_mode\": %d,\n",
+                      (g_fullscreen >= 0 && g_fullscreen <= 2) ? g_fullscreen : 0);
+        json += line;
+    }
+    if (c & MENU_PREF_FPS) {
+        json += fps_osd_enabled() ? "  \"fps_overlay\": true,\n"
+                                  : "  \"fps_overlay\": false,\n";
+    }
+    if (c & MENU_PREF_POSTFX) {
+        json += postfx_enabled() ? "  \"postfx_enabled\": true,\n"
+                                 : "  \"postfx_enabled\": false,\n";
+    }
+    if (c & MENU_PREF_LIVES) {
+        json += crash2_cheat_lives_enabled()
+                    ? "  \"cheat_infinite_lives\": true,\n"
+                    : "  \"cheat_infinite_lives\": false,\n";
+    }
+    if (c & MENU_PREF_AKU) {
+        int a = crash2_cheat_aku_level();
+        if (a < 0 || a >= PSX_PAUSE_AKU_COUNT) a = 0;
+        std::snprintf(line, sizeof(line), "  \"cheat_aku_aku\": \"%s\",\n",
+                      kAku[a]);
+        json += line;
+    }
+    if (c & MENU_PREF_VOLUME) {
+        std::snprintf(line, sizeof(line), "  \"volume\": %d,\n",
+                      host_volume_get());
+        json += line;
+    }
+    if (json.size() >= 2 && json[json.size() - 2] == ',')
+        json.erase(json.size() - 2, 1);                  /* last comma */
+    json += "}\n";
+
+    /* Whole file or nothing: write beside it, then replace. */
+    std::filesystem::path tmp = path;
+    tmp += ".tmp";
+#if defined(_WIN32)
+    FILE *f = _wfopen(tmp.c_str(), L"wb");
+#else
+    FILE *f = std::fopen(tmp.c_str(), "wb");
+#endif
+    if (!f) return;
+    const bool wrote = std::fwrite(json.data(), 1, json.size(), f) == json.size();
+    const bool closed = std::fclose(f) == 0;
+    std::error_code ec;
+    if (!wrote || !closed) {
+        std::filesystem::remove(tmp, ec);
+        return;
+    }
+#if defined(_WIN32)
+    if (!MoveFileExW(tmp.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING)) {
+        std::filesystem::remove(tmp, ec);
+        return;
+    }
+#else
+    std::filesystem::rename(tmp, path, ec);
+    if (ec) return;
+#endif
+    s_menu_prefs_dirty = 0;
+}

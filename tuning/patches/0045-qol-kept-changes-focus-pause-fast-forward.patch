+
+/* PSX_PAUSE_ON_FOCUS_LOSS=1: the game pauses behind the Home menu when its
+ * window loses focus (alt-tab, a click elsewhere), instead of playing on
+ * unattended. It stays paused until the player resumes it. */
+static int pause_on_focus_loss_enabled(void) {
+    static int value = -1;
+    if (value < 0) {
+        const char *e = std::getenv("PSX_PAUSE_ON_FOCUS_LOSS");
+        value = (e && e[0] && e[0] != '0') ? 1 : 0;
+    }
+    return value;
+}

+ * it in its own list that the game's list holds (0: after the first). Then
+ * c2sl_corder holds them by that position, stably. */
+static int c2sl_candidates(const C2slEntry *e, int node, int k, int m, const C2slJoin *joins)
+{
+    static uint16_t start[C2SL_MAX_LIST + 1];
+    memset(c2sl_have, 0, sizeof c2sl_have);
+    for (int i = 0; i < m; ++i) {
+        const uint16_t key = c2sl_key(c2sl_game[i]);
+        c2sl_have[key >> 3] |= (uint8_t)(1u << (key & 7));
+        c2sl_pos[key] = (uint16_t)i;
+    }
+    int n = 0;
+    for (int j = 1; j <= k && n < C2SL_MAX_CAND; ++j) {
+        for (int side = -1; side <= 1 && n < C2SL_MAX_CAND; side += 2) {
+            int nn = 0;

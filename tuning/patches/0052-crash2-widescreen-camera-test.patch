+/* ---- the camera and the frame -------------------------------------------- *
+ * The world renderer feeds the GTE camera-relative vertices in world units
+ * with no translation, under the rotation 0x8004EF28 loaded from 0x80060774.
+ * So a point's screen position is the GTE's RTPS of (point - camera). The
+ * camera's position is at 0x800607F4 (24.8). */
+typedef struct {
+    int32_t r[9];        /* rotation, 4.12, row major */
+    int32_t ofx, ofy;    /* screen offsets, 16.16 */
+    int32_t h;           /* projection distance */
+    int32_t margin;      /* extra columns per side the frame shows (0: 4:3) */
+    int ok;              /* this model put the game's own list on screen */
+} C2wgCam;
+
+static C2wgCam c2wg_cam;                    /* as at the last world draw */
+
+static void c2wg_cam_from_gte(C2wgCam *c, const uint32_t *ctrl)
+{
+    for (int i = 0; i < 4; i++) {
+        c->r[2 * i] = (int16_t)ctrl[i];
+        c->r[2 * i + 1] = (int16_t)(ctrl[i] >> 16);
+    }
+    c->r[8] = (int16_t)ctrl[4];
+    c->ofx = (int32_t)ctrl[24];
+    c->ofy = (int32_t)ctrl[25];
+    c->h = (int32_t)(ctrl[26] & 0xFFFFu);
+}
+
+/* The camera's position in world units. The game shifts y unsigned
+ * (0x80018368), harmless there - the renderer keeps only an offset's low 16
+ * bits, the same either way - but a whole position needs the signed value:
+ * camera y is negative in some levels. */
+static void c2wg_cam_pos(int32_t *x, int32_t *y, int32_t *z)
+{
+    *x = (int32_t)C2WG_R32(C2WG_CAM_POS) >> 8;
+    *y = (int32_t)C2WG_R32(C2WG_CAM_POS + 4u) >> 8;
+    *z = (int32_t)C2WG_R32(C2WG_CAM_POS + 8u) >> 8;
+}
+
+/* RTPS of a camera-relative point, without the widescreen squash: 0 unless it
+ * is in front of the eye. */
+static int c2wg_project(const C2wgCam *c, int32_t x, int32_t y, int32_t z, int *sx, int *sy)
+{
+    const int64_t m3 = ((int64_t)c->r[6] * x + (int64_t)c->r[7] * y + (int64_t)c->r[8] * z) >> 12;
+    if (m3 <= 0) return 0;
+    int64_t m1 = ((int64_t)c->r[0] * x + (int64_t)c->r[1] * y + (int64_t)c->r[2] * z) >> 12;
+    int64_t m2 = ((int64_t)c->r[3] * x + (int64_t)c->r[4] * y + (int64_t)c->r[5] * z) >> 12;
+    if (m1 < -0x8000) m1 = -0x8000; else if (m1 > 0x7FFF) m1 = 0x7FFF;
+    if (m2 < -0x8000) m2 = -0x8000; else if (m2 > 0x7FFF) m2 = 0x7FFF;
+    const int64_t sz = m3 > 0xFFFF ? 0xFFFF : m3;
+    /* the GTE's division saturates at 0x1FFFF once H reaches 2 * SZ */
+    int64_t q = (int64_t)c->h >= sz * 2 ? 0x1FFFF : (((int64_t)c->h << 16) + sz / 2) / sz;
+    if (q > 0x1FFFF) q = 0x1FFFF;
+    int64_t px = ((int64_t)c->ofx + m1 * q) >> 16, py = ((int64_t)c->ofy + m2 * q) >> 16;
+    if (px < -1024) px = -1024; else if (px > 1023) px = 1023;
+    if (py < -1024) py = -1024; else if (py > 1023) py = 1023;
+    *sx = (int)px;
+    *sy = (int)py;
+    return 1;
+}
+
+/* How a polygon's corners fall against the frame (camera-relative, world
+ * units): C2WG_OUT behind the eye or wholly past one edge of the frame
+ * `margin` columns wider each side (plus C2WG_GUARD); C2WG_IN43 inside but
+ * never outside the 4:3 columns; C2WG_WIDE reaching into the extra ones. */
+#define C2WG_OUT  0
+#define C2WG_IN43 1
+#define C2WG_WIDE 2
+static int c2wg_classify(const C2wgCam *c, int32_t (*v)[3], int n, int margin)
+{
+    const int lo = -margin - C2WG_GUARD, hi = 512 + margin + C2WG_GUARD;
+    int front = 0, behind = 0, aside = 0;
+    int all_l = 1, all_r = 1, all_t = 1, all_b = 1;
+    for (int i = 0; i < n; i++) {
+        int sx, sy;
+        if (!c2wg_project(c, v[i][0], v[i][1], v[i][2], &sx, &sy)) { behind++; continue; }
+        front++;
+        if (sx >= lo) all_l = 0;
+        if (sx < hi) all_r = 0;
+        if (sy >= -C2WG_GUARD) all_t = 0;
+        if (sy < C2WG_FRAME_H + C2WG_GUARD) all_b = 0;
+        if (sx < 0 || sx >= 512) aside = 1;
+    }
+    if (!front) return C2WG_OUT;
+    /* Crossing the eye plane: the corners in front bound nothing. */
+    if (behind) return aside ? C2WG_WIDE : C2WG_IN43;
+    if (all_l || all_r || all_t || all_b) return C2WG_OUT;
+    return aside ? C2WG_WIDE : C2WG_IN43;
+}
+
+/* ---- the current zone's worlds, as the renderer reads them --------------- */
+typedef struct {
+    uint32_t vbase, tbase, qbase;    /* vertices: XY words below vbase, Z above */
+    int nv, nt, nq;
+    uint32_t ox, oy, oz;             /* world origin - camera, this frame */
+} C2wgWorld;
+
+/* The worlds of `zone` (its header records, as 0x80018344 fills them each
+ * frame); how many could be read (0 on any doubt). */
+static int c2wg_worlds(uint32_t zone, C2wgWorld *w, int max)
+{
+    const uint32_t h = c2wg_item(zone, 0u);
+    if (!h || !c2wg_ram(h, 4u + 48u * C2WG_MAX_WORLDS)) return 0;
+    const uint32_t n = C2WG_R32(h);
+    if (n < 1u || n > (uint32_t)max || n > C2WG_MAX_WORLDS) return 0;
+    for (uint32_t i = 0; i < n; i++) {
+        const uint32_t rec = h + 4u + 48u * i;
+        const uint32_t info = C2WG_R32(rec + 16u), tri = C2WG_R32(rec + 20u);
+        const uint32_t quad = C2WG_R32(rec + 24u), vert = C2WG_R32(rec + 28u);
+        if (!c2wg_ram(info, 28u)) return 0;
+        const int nv = (int)C2WG_R32(info + 16u), nt = (int)C2WG_R32(info + 20u);
+        const int nq = (int)C2WG_R32(info + 24u);
+        if (nv < 0 || nv > 4096 || nt < 0 || nt > 2048 || nq < 0 || nq > 2048) return 0;
+        if (!c2wg_ram(vert, 6u * (uint32_t)nv + 4u) || !c2wg_ram(tri, 6u * (uint32_t)nt + 4u) ||
+            !c2wg_ram(quad, 8u * (uint32_t)nq + 4u))
+            return 0;
+        w[i].vbase = vert + 4u * (uint32_t)nv;
+        w[i].tbase = tri + 4u * (uint32_t)nt;
+        w[i].qbase = quad;
+        w[i].nv = nv; w[i].nt = nt; w[i].nq = nq;
+        w[i].ox = C2WG_R32(rec + 4u);
+        w[i].oy = C2WG_R32(rec + 8u) & 0xFFFEu;    /* as the renderer packs it */
+        w[i].oz = C2WG_R32(rec + 12u);
+    }
+    return (int)n;
+}
+
+static uint32_t c2wg_f32(const uint8_t *ram, uint32_t a)
+{
+    uint32_t v;
+    memcpy(&v, ram + (a & 0x1FFFFFu), 4);
+    return v;
+}
+
+static uint16_t c2wg_f16(const uint8_t *ram, uint32_t a)
+{
+    uint16_t v;
+    memcpy(&v, ram + (a & 0x1FFFFFu), 2);
+    return v;
+}
+
+/* A polygon's corners as the renderer feeds them to the GTE (camera-relative,
+ * 16-bit): 3 or 4, or 0 if its id does not fit its world. Quads give all four
+ * vertex fields (one variant draws three of them: a superset is safe here). */
+static int c2wg_poly(const uint8_t *ram, const C2wgWorld *ws, int nw, uint16_t id, int32_t v[4][3])
+{
+    const int wi = id >> 13;
+    if (wi >= nw) return 0;
+    const C2wgWorld *w = &ws[wi];
+    const uint32_t idx = id & 0x7FFu;
+    uint32_t vi[4];
+    int n;
+    if (id & 0x1800u) {
+        if ((int)idx >= w->nq) return 0;
+        const uint32_t w0 = c2wg_f32(ram, w->qbase + 8u * idx), w1 = c2wg_f32(ram, w->qbase + 8u * idx + 4u);
+        vi[0] = w0 >> 20; vi[1] = (w0 >> 8) & 0xFFFu; vi[2] = w1 >> 20; vi[3] = (w1 >> 8) & 0xFFFu;
+        n = 4;
+    } else {
+        if ((int)idx >= w->nt) return 0;
+        const uint32_t w0 = c2wg_f32(ram, w->tbase - 4u - 4u * idx);
+        const uint32_t hw = c2wg_f16(ram, w->tbase + 2u * idx);
+        vi[0] = w0 >> 20; vi[1] = (w0 >> 8) & 0xFFFu; vi[2] = (hw >> 4) & 0xFFFu;
+        n = 3;
+    }
+    for (int k = 0; k < n; k++) {
+        if ((int)vi[k] >= w->nv) return 0;
+        const uint32_t xy = c2wg_f32(ram, w->vbase - 4u - 4u * vi[k]);
+        const uint32_t z = c2wg_f16(ram, w->vbase + 2u * vi[k]);
+        v[k][0] = (int16_t)(uint16_t)((xy & 0xFFF0u) + w->ox);
+        v[k][1] = (int16_t)(uint16_t)(((xy >> 16) & 0xFFF0u) + w->oy);
+        v[k][2] = (int16_t)(uint16_t)((z & 0xFFF0u) + w->oz);
+    }
+    return n;
+}
+
 #endif /* CRASH2_WIDE_GEOM_H */

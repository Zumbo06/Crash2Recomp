+/* SCUS-94154 only: where things are along Crash 2's camera paths, for the
+ * widescreen range hooks (crash2_wide_spawn.h, crash2_wide_slst.h). Read only:
+ * nothing here writes guest memory or makes the game load anything.
+ *
+ * Level data in memory (found in the executable, checked against every level
+ * file on the disc):
+ *
+ *   - An entry: 0x0100FFFF, EID, type, item count, then a pointer per item.
+ *     Zones are type 7, SLST entries type 4.
+ *   - A zone's item 0 is its header. Word 0 counts its worlds, 48 bytes each
+ *     from +4, each starting with the world's reference; the renderer's world
+ *     slots are copied from the CURRENT zone's (0x800608CC) every frame
+ *     (0x80011BBC..0x80011C80), and a polygon id's top three bits index them.
+ *     +0x184 is the item of its first camera path (three items per path),
+ *     +0x188 the number of camera items, +0x190 / +0x194 its neighbour zones
+ *     (count, references). Item 1 starts with the zone's origin (3 x int32).
+ *   - An entity's word +4 is its zone (filled at load; the camera code reads
+ *     it at 0x800265E4). Properties are found the way the accessor 0x80031AE8
+ *     finds them.
+ *   - A camera path: 0x04B its node points (int16 x,y,z from the zone's
+ *     origin), 0x029 its kind, 0x103 its SLST, 0x109 its links: a row per end
+ *     (the row's node 0 or the last), each record byte 0 = the end of the
+ *     next path the camera enters by (1 its start, else its end), byte 1 that
+ *     path's index, byte 2 its zone's slot in this zone's neighbour list
+ *     (0x800265B4..0x8002668C).
+ *   - An object (a draw-list value: entity index << 24 | id << 8 | zone slot)
+ *     is item index + [+0x184] + [+0x188] of that zone (func_80019098), id in
+ *     0x09F, position 0x04B in units of 4 from the zone's origin.
+ *   - A reference is an EID until the game resolves it in place to its 8-byte
+ *     record {entry, EID} (0x80014260). The record's entry word has bit 0 set
+ *     while the entry is not resident. EIDs are found as 0x80014B90 finds them.
+ *
+ * Kind 3 (and 8) paths look at the play from the side. On every one of them,
+ * across the game, objects appear and vanish where their offset along the
+ * path from the camera is 0.94 to 2.3 times their distance off it (median
+ * 1.1): the 4:3 frame's side edges. Every number above was checked on the
+ * disc: all 53,862 draw-list values resolve to their entity, all 3,837 camera
+ * links to a path. */
+
+#ifndef CRASH2_WIDE_GEOM_H
+#define CRASH2_WIDE_GEOM_H
+
+#include <math.h>
+
+#define C2WG_MAGIC      0x0100FFFFu
+#define C2WG_T_ZONE     7u
+#define C2WG_T_SLST     4u
+#define C2WG_NULL_REF   0x6396347Fu
+#define C2WG_HASH       0x80057590u   /* [ ] = the first record of each bucket  */
+#define C2WG_RECS       0x80057594u   /* [ ] = the records, 8 bytes {entry, EID} */
+#define C2WG_NSD        0x800575A0u   /* [[ ] + 1028] = how many records         */
+#define C2WG_ZONE       0x800608CCu   /* the camera's current zone               */
+#define C2WG_MAX_PTS    1024
+#define C2WG_MAX_NEIGH  16
+#define C2WG_MAX_WORLDS 8
+
+#ifndef C2WG_R32
+extern uint32_t psx_read_word(uint32_t a);
+extern uint16_t psx_read_half(uint32_t a);
+extern uint8_t  psx_read_byte(uint32_t a);
+#define C2WG_R32(a) psx_read_word(a)
+#define C2WG_R16(a) psx_read_half(a)
+#define C2WG_R8(a)  psx_read_byte(a)
+#endif
+
+typedef struct { float x, y, z; } C2wgVec;
+typedef struct { uint32_t data; unsigned flags, esize; int rows; } C2wgProp;
+
+static const uint32_t c2wg_words[][2] = {
+    /* EID lookup, bounded (0x80014B90) */
+    { 0x80014B94u, 0x8C427590u },  /* lw $v0, 0x7590($v0): bucket heads   */
+    { 0x80014B98u, 0x00041B42u },  /* srl $v1, $a0, 13                    */
+    { 0x80014B9Cu, 0x306303FCu },  /* andi $v1, $v1, 0x3FC                */
+    { 0x80014BC0u, 0x8C4275A0u },  /* lw $v0, 0x75A0($v0)                 */
+    { 0x80014BC8u, 0x8CC67594u },  /* lw $a2, 0x7594($a2): records        */
+    { 0x80014BCCu, 0x8C450404u },  /* lw $a1, 1028($v0): record count     */
+    /* references: EID (bit 0) replaced in place by the record; bit 0 of the
+     * record's entry word = not resident (0x80014260) */
+    { 0x80014298u, 0x30820001u },  /* andi $v0, $a0, 1                    */
+    { 0x800142B4u, 0xAE020000u },  /* sw $v0, 0($s0)                      */
+    { 0x800142CCu, 0x30820001u },  /* andi $v0, $a0, 1                    */
+    /* the renderer's world slots: the current zone's header worlds */
+    { 0x80011BC0u, 0x8C4208CCu },  /* lw $v0, 0x8CC($v0)                  */
+    { 0x80011BD0u, 0x8C460000u },  /* lw $a2, 0($v0): world count         */
+    { 0x80011BE0u, 0x2445002Cu },  /* addiu $a1, $v0, 44                  */
+    { 0x80011C78u, 0x24A50030u },  /* addiu $a1, $a1, 48                  */
+    { 0x80041FC4u, 0x3174E000u },  /* andi $s4, $t3, 0xE000: id -> world  */
+    /* neighbour zones at +0x190 / +0x194 */
+    { 0x80020628u, 0x8E820190u },  /* lw $v0, 400($s4)                    */
+    { 0x80020638u, 0x34130194u },  /* ori $s3, $zero, 0x194               */
+    /* camera links (0x109): entity +4 = zone, path = index*3 + [+0x184] */
+    { 0x800265B4u, 0x34050109u },  /* ori $a1, $zero, 0x109               */
+    { 0x800265E4u, 0x8C840004u },  /* lw $a0, 4($a0)                      */
+    { 0x800265ECu, 0x92220002u },  /* lbu $v0, 2($s1): zone slot          */
+    { 0x80026600u, 0x24420194u },  /* addiu $v0, $v0, 404                 */
+    { 0x80026614u, 0x92240001u },  /* lbu $a0, 1($s1): path index         */
+    { 0x80026618u, 0x8C650184u },  /* lw $a1, 388($v1)                    */
+    { 0x8002661Cu, 0x00041840u },  /* sll $v1, $a0, 1                     */
+    { 0x80026620u, 0x00641821u },  /* addu $v1, $v1, $a0                  */
+    { 0x8002664Cu, 0x92220000u },  /* lbu $v0, 0($s1): end entered by     */
+    /* an object's entity: index + [+0x184] + [+0x188] (func_80019098) */
+    { 0x800190E0u, 0x8C430184u },  /* lw $v1, 388($v0)                    */
+    { 0x800190E4u, 0x8C420188u },  /* lw $v0, 392($v0)                    */
+};
+
+static int c2wg_code_ok(void)
+{
+    for (size_t i = 0; i < sizeof(c2wg_words) / sizeof(c2wg_words[0]); ++i)
+        if (C2WG_R32(c2wg_words[i][0]) != c2wg_words[i][1]) return 0;
+    return 1;
+}
+
+static int c2wg_ram(uint32_t a, uint32_t n)
+{
+    return (a & 0xE0000000u) == 0x80000000u &&
+           (a & 0x1FFFFFFFu) < 0x200000u && n <= 0x200000u - (a & 0x1FFFFFFFu);
+}
+
+/* The entry a reference names, if it is resident; 0 otherwise. */
+static uint32_t c2wg_entry(uint32_t ref)
+{
+    if (ref == 0u || ref == C2WG_NULL_REF) return 0u;
+    uint32_t rec = ref;
+    if (ref & 1u) {
+        const uint32_t hash = C2WG_R32(C2WG_HASH), recs = C2WG_R32(C2WG_RECS);
+        const uint32_t nsd = C2WG_R32(C2WG_NSD);
+        if (!c2wg_ram(hash, 1024u) || !c2wg_ram(recs, 8u) || !c2wg_ram(nsd, 1032u)) return 0u;
+        const uint32_t count = C2WG_R32(nsd + 1028u);
+        rec = C2WG_R32(hash + ((ref >> 13) & 0x3FCu));
+        for (;;) {
+            if (rec < recs || (rec - recs) / 8u >= count || !c2wg_ram(rec, 8u)) return 0u;
+            if (C2WG_R32(rec + 4u) == ref) break;
+            rec += 8u;
+        }
+    }
+    if (!c2wg_ram(rec, 8u)) return 0u;
+    const uint32_t entry = C2WG_R32(rec);
+    if ((entry & 1u) || !c2wg_ram(entry, 16u) || C2WG_R32(entry) != C2WG_MAGIC ||
+        C2WG_R32(entry + 4u) != C2WG_R32(rec + 4u))
+        return 0u;
+    return entry;
+}
+
+/* The EID a reference names, resolved or not; 0 if it is not one. */
+static uint32_t c2wg_eid(uint32_t ref)
+{
+    if (ref & 1u) return ref;
+    return c2wg_ram(ref, 8u) ? C2WG_R32(ref + 4u) : 0u;
+}
+
+static uint32_t c2wg_typed(uint32_t entry, uint32_t type)
+{
+    return (c2wg_ram(entry, 16u) && C2WG_R32(entry) == C2WG_MAGIC &&
+            C2WG_R32(entry + 8u) == type) ? entry : 0u;
+}
+
+static uint32_t c2wg_item(uint32_t entry, uint32_t i)
+{
+    if (!c2wg_ram(entry, 16u)) return 0u;
+    const uint32_t n = C2WG_R32(entry + 12u);
+    if (n > 4096u || i >= n || !c2wg_ram(entry + 16u, 4u * (n + 1u))) return 0u;
+    const uint32_t it = C2WG_R32(entry + 16u + 4u * i);
+    return c2wg_ram(it, 16u) ? it : 0u;
+}
+
+/* A property, found as 0x80031AE8 finds it: binary search over the 8-byte
+ * headers at entity+16 (count at +12), along the +8 chain. */
+static int c2wg_prop(uint32_t ent, int id, C2wgProp *p)
+{
+    for (int depth = 0; ent != 0u && depth < 4; depth++) {
+        if (!c2wg_ram(ent, 16u)) return 0;
+        int lo = 0, hi = (int16_t)C2WG_R16(ent + 12u) - 1;
+        if (hi > 512) return 0;
+        while (lo <= hi) {
+            const int mid = (lo + hi) >> 1;
+            const uint32_t h = ent + 16u + (uint32_t)mid * 8u;
+            const int hid = (int16_t)C2WG_R16(h);
+            if (hid == id) {
+                p->data = ent + 12u + C2WG_R16(h + 2u);
+                p->flags = C2WG_R8(h + 4u);
+                p->esize = C2WG_R8(h + 5u);
+                p->rows = C2WG_R16(h + 6u);
+                return c2wg_ram(p->data, 4u) && p->rows >= 1 && p->rows <= 1024;
+            }
+            if (hid < id) lo = mid + 1; else hi = mid - 1;
+        }
+        ent = C2WG_R32(ent + 8u);
+    }
+    return 0;
+}
+
+/* Row r of a property: flag 0x40 = a count per row, else one for all; flag
+ * 0x20 = a node per row (*meta); values from the next 4-byte boundary. */
+static int c2wg_row(const C2wgProp *p, int r, uint32_t *vals, int *count, int *meta)
+{
+    if (r < 0 || r >= p->rows) return 0;
+    uint32_t q = p->data, counts = 0u, metas = 0u;
+    int common = 0;
+    if (p->flags & 0x40u) { counts = q; q += 2u * (uint32_t)p->rows; }
+    else { common = C2WG_R16(q); q += 2u; }
+    if (p->flags & 0x20u) { metas = q; q += 2u * (uint32_t)p->rows; }
+    q = (q + 3u) & ~3u;
+    uint32_t off = 0u;
+    for (int i = 0; i <= r; i++) {
+        const int c = counts ? (int)C2WG_R16(counts + 2u * (uint32_t)i) : common;
+        if (c < 0 || c > 4096) return 0;
+        if (i == r) {
+            *vals = q + off * p->esize;
+            *count = c;
+            if (meta) *meta = metas ? (int16_t)C2WG_R16(metas + 2u * (uint32_t)i) : 0;
+            return c2wg_ram(*vals, (uint32_t)c * p->esize + 4u);
+        }
+        off += (uint32_t)c;
+    }
+    return 0;
+}
+
+static uint32_t c2wg_zone_of(uint32_t ent)
+{
+    return c2wg_ram(ent, 8u) ? c2wg_typed(C2WG_R32(ent + 4u), C2WG_T_ZONE) : 0u;
+}
+
+static int c2wg_origin(uint32_t zone, C2wgVec *o)
+{
+    const uint32_t i1 = c2wg_item(zone, 1u);
+    if (!i1) return 0;
+    o->x = (float)(int32_t)C2WG_R32(i1);
+    o->y = (float)(int32_t)C2WG_R32(i1 + 4u);
+    o->z = (float)(int32_t)C2WG_R32(i1 + 8u);
+    return 1;
+}
+
+/* Slot `slot` of a zone's neighbour list, if that zone is resident. */
+static uint32_t c2wg_neighbour(uint32_t zone, unsigned slot)
+{
+    const uint32_t h = c2wg_item(zone, 0u);
+    if (!h || !c2wg_ram(h, 0x194u + 4u * C2WG_MAX_NEIGH)) return 0u;
+    const uint32_t n = C2WG_R32(h + 0x190u);
+    if (slot >= n || n > C2WG_MAX_NEIGH) return 0u;
+    return c2wg_typed(c2wg_entry(C2WG_R32(h + 0x194u + 4u * slot)), C2WG_T_ZONE);
+}
+
+/* World i of a zone, as an EID (0 if none). */
+static uint32_t c2wg_world(uint32_t zone, unsigned i)
+{
+    const uint32_t h = c2wg_item(zone, 0u);
+    if (!h) return 0u;
+    const uint32_t n = C2WG_R32(h);
+    if (i >= n || n > C2WG_MAX_WORLDS) return 0u;
+    return c2wg_eid(C2WG_R32(h + 4u + 48u * i));
+}
+
+/* A camera path's kind (0x029); -1 if it has none. */
+static int c2wg_kind(uint32_t cam)
+{
+    C2wgProp p;
+    uint32_t v;
+    int c;
+    if (!c2wg_prop(cam, 0x029, &p) || p.esize != 1u || !c2wg_row(&p, 0, &v, &c, NULL) || c < 1)
+        return -1;
+    return C2WG_R8(v);
+}
+
+static int c2wg_side_on(uint32_t cam)
+{
+    const int kind = c2wg_kind(cam);
+    return kind == 3 || kind == 8;
+}
+
+/* A camera path's node points, in world units; how many (0 on any doubt). */
+static int c2wg_path_points(uint32_t cam, C2wgVec *pts, int max)
+{
+    const uint32_t zone = c2wg_zone_of(cam);
+    C2wgVec o;
+    C2wgProp p;
+    uint32_t v;
+    int c;
+    if (!zone || !c2wg_origin(zone, &o) || !c2wg_prop(cam, 0x04B, &p) || p.esize != 6u ||
+        !c2wg_row(&p, 0, &v, &c, NULL) || c < 2 || c > max)
+        return 0;
+    for (int i = 0; i < c; i++) {
+        const uint32_t e = v + 6u * (uint32_t)i;
+        pts[i].x = o.x + (float)(int16_t)C2WG_R16(e);
+        pts[i].y = o.y + (float)(int16_t)C2WG_R16(e + 2u);
+        pts[i].z = o.z + (float)(int16_t)C2WG_R16(e + 4u);
+    }
+    return c;
+}
+
+/* Where the object a draw-list value names is, in world units. `zone` is the
+ * zone of the path whose list holds the value. */
+static int c2wg_object_pos(uint32_t zone, uint32_t value, C2wgVec *out)
+{
+    const uint32_t z = c2wg_neighbour(zone, value & 0xFFu);
+    const uint32_t h = c2wg_item(z, 0u);
+    if (!h) return 0;
+    const uint32_t ent = c2wg_item(z, (value >> 24) + C2WG_R32(h + 0x184u) + C2WG_R32(h + 0x188u));
+    C2wgProp p;
+    uint32_t v;
+    int c;
+    if (!ent || !c2wg_prop(ent, 0x09F, &p) || p.esize != 4u || !c2wg_row(&p, 0, &v, &c, NULL) ||
+        c < 1 || C2WG_R32(v) != ((value >> 8) & 0xFFFFu))
+        return 0;
+    C2wgVec o;
+    if (!c2wg_prop(ent, 0x04B, &p) || p.esize != 6u || !c2wg_row(&p, 0, &v, &c, NULL) || c < 1 ||
+        !c2wg_origin(z, &o))
+        return 0;
+    out->x = o.x + 4.0f * (float)(int16_t)C2WG_R16(v);
+    out->y = o.y + 4.0f * (float)(int16_t)C2WG_R16(v + 2u);
+    out->z = o.z + 4.0f * (float)(int16_t)C2WG_R16(v + 4u);
+    return 1;
+}
+
+/* How far along the path, ahead of or behind the camera at `node`, point p
+ * lies (*along, always >= 0) and the node spacing there. 0 unless p is where
+ * a side-on path's 4:3 frame has its edge: |along| between 0.5 and 4 times its
+ * distance off the path (the game: 0.94 to 2.3). Anything else appeared or
+ * vanished for another reason - behind something, out of the dark. */
+static int c2wg_edge(const C2wgVec *pts, int n, int node, const C2wgVec *p,
+                     float *along, float *step)
+{
+    if (node < 0 || node >= n || n < 2) return 0;
+    const int lo = node > 0 ? node - 1 : node, hi = node < n - 1 ? node + 1 : node;
+    float ux = pts[hi].x - pts[lo].x, uy = pts[hi].y - pts[lo].y, uz = pts[hi].z - pts[lo].z;
+    const float len = sqrtf(ux * ux + uy * uy + uz * uz);
+    if (!(len >= 1.0f)) return 0;
+    ux /= len; uy /= len; uz /= len;
+    const float dx = p->x - pts[node].x, dy = p->y - pts[node].y, dz = p->z - pts[node].z;
+    const float a = dx * ux + dy * uy + dz * uz;
+    const float off2 = dx * dx + dy * dy + dz * dz - a * a;
+    const float off = off2 > 0.0f ? sqrtf(off2) : 0.0f;
+    if (!(off >= 1.0f) || fabsf(a) < 0.5f * off || fabsf(a) > 4.0f * off) return 0;
+    *along = fabsf(a);
+    *step = len / (float)(hi - lo);
+    return 1;
+}
+
+/* The path joined to `cam` at its start (end 0) or its end (end 1), and
+ * whether walking on enters it at its start (*at_start). Only a single link:
+ * where the path forks, which way the camera goes is for the game to say. */
+static uint32_t c2wg_link(uint32_t cam, int end, int nodes, int *at_start)
+{
+    C2wgProp p;
+    const uint32_t zone = c2wg_zone_of(cam);
+    if (!zone || !c2wg_prop(cam, 0x109, &p) || p.esize != 4u || !(p.flags & 0x20u)) return 0u;
+    for (int r = 0; r < p.rows && r < 4; r++) {
+        uint32_t v;
+        int c, meta;
+        if (!c2wg_row(&p, r, &v, &c, &meta)) return 0u;
+        if (meta != (end ? nodes - 1 : 0)) continue;
+        if (c != 1) return 0u;
+        const uint32_t rec = C2WG_R32(v);
+        const uint32_t z = c2wg_neighbour(zone, (rec >> 16) & 0xFFu);
+        const uint32_t h = c2wg_item(z, 0u);
+        if (!h) return 0u;
+        const uint32_t path = c2wg_item(z, ((rec >> 8) & 0xFFu) * 3u + C2WG_R32(h + 0x184u));
+        C2wgProp q;
+        if (!path || c2wg_zone_of(path) != z || !c2wg_prop(path, 0x103, &q)) return 0u;
+        *at_start = (rec & 0xFFu) == 1u;
+        return path;
+    }
+    return 0u;
+}
+
+/* A camera path's SLST entry, if resident. */
+static uint32_t c2wg_slst_of(uint32_t cam)
+{
+    C2wgProp p;
+    uint32_t v;
+    int c;
+    if (!c2wg_prop(cam, 0x103, &p) || p.esize != 4u || !c2wg_row(&p, 0, &v, &c, NULL) || c < 1)
+        return 0u;
+    return c2wg_typed(c2wg_entry(C2WG_R32(v)), C2WG_T_SLST);
+}
+
+#endif /* CRASH2_WIDE_GEOM_H */

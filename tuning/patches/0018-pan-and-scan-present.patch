+/* Pan & Scan dial, live so the crop can be tuned by eye in one session instead
+ * of one game boot per value:
+ *   present_fit                    -> current zoom/pan
+ *   present_fit {"zoom":0..100}    -> 0 letterbox, 100 fills the screen;
+ *                                     -1 restores "follow the image-fit mode"
+ *   present_fit {"pan":N}          -> vertical pan in source scanlines of 240;
+ *                                     POSITIVE reveals more of the top
+ *   present_fit {"stretch":0..100} -> 0 keeps the shape exact, 100 fills the
+ *                                     canvas exactly; in between splits the
+ *                                     mismatch between distortion and bars
+ * Zoom alone never distorts; only the stretch dial does, and distort_pct in the
+ * reply says by how much. */
+static void handle_present_fit(int id, const char *json)
+{
+    int zoom    = json_get_int(json, "zoom", -1000);
+    int pan     = json_get_int(json, "pan", -1000);
+    int stretch = json_get_int(json, "stretch", -1000);
+    int crop    = json_get_int(json, "crop", -1000);
+    if (zoom    != -1000) gl_renderer_set_present_zoom(zoom);
+    if (pan     != -1000) gl_renderer_set_present_pan(pan);
+    if (stretch != -1000) gl_renderer_set_present_stretch(stretch);
+    /* Symmetric top/bottom overscan trim, live. Crash 2 leaves 12 undrawn
+     * scanlines at each end of its 240-line field, and those are black IMAGE,
+     * not letterboxing - only trimming the source removes them. Doing so also
+     * makes the drawn content wider relative to its height, so it needs less
+     * stretch to fill a 16:9 panel. */
+    if (crop != -1000) gl_renderer_set_overscan_crop(crop, crop, 0, 0);
+    /* Report the GAMEPLAY rect (force_4_3 = 0): that is the one the game is
+     * presented through once widescreen engages. A 4:3-presented frame (FMV,
+     * menus) uses the other branch and is never the interesting case here. */
+    int lx = 0, ly = 0, lw = 0, lh = 0, ww = 0, wh = 0, num = 4, den = 3;
+    gl_renderer_debug_present_rect(0, &lx, &ly, &lw, &lh, &ww, &wh, &num, &den);
+    /* crop_lines = scanlines of the 240-line source lost off EACH of top and
+     * bottom; negative means bars instead. distort_pct = how far the rect has
+     * been pushed off its true shape by the stretch dial, in percent (0 is
+     * geometrically exact; positive is horizontally wide). Both make the cost
+     * of a setting readable without eyeballing the window. */
+    const int crop_px = (lh - wh) / 2;
+    const int crop_v  = lh > 0 ? (crop_px * 240) / lh : 0;
+    int distort = 0;
+    if (lh > 0 && den > 0 && num > 0)
+        distort = (int)(((int64_t)lw * den * 100) / ((int64_t)lh * num)) - 100;
+    send_fmt("{\"id\":%d,\"ok\":true,\"zoom\":%d,\"pan\":%d,\"stretch\":%d,"
+             "\"drawable\":[%d,%d],\"rect\":[%d,%d,%d,%d],\"aspect\":[%d,%d],"
+             "\"crop_px_per_edge\":%d,\"crop_lines_per_edge\":%d,"
+             "\"distort_pct\":%d}",
+             id, gl_renderer_get_present_zoom(), gl_renderer_get_present_pan(),
+             gl_renderer_get_present_stretch(),
+             ww, wh, lx, ly, lw, lh, num, den, crop_px, crop_v, distort);
+}

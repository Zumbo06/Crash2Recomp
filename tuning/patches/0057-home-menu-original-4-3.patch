+/* ORIGINAL 4:3 takes the framing with it: letterbox (which clears zoom and
+ * stretch), no pan and no overscan crop - trimming the game's blank lines
+ * makes the kept band wider than 4:3 and narrows the bars. Presentation only,
+ * so it is safe from the pause loop; the aspect itself is staged as usual. */
+static void pause_menu_apply_original_framing(void) {
+    pause_menu_apply_fit(0);
+    gl_renderer_set_present_pan(0);
+    gl_renderer_set_overscan_crop(0, 0, 0, 0);

+/* ---- release cost counters (heartbeat "gl") ------------------------------
+ * frame_perf answers "where did this frame go" only in a debug-tools build,
+ * with a debug port and a TCP client. These answer the same question from the
+ * release build the player runs: every path below either grows with the
+ * internal scale S (full-surface work is S*S pixels) or makes the emulation
+ * thread wait for the GPU, which turns GPU time into lost VBlanks. Monotonic
+ * totals, bumped on the render thread only; the heartbeat thread reads them
+ * and the launcher / tuning/scripts/scale_bench.py take rates over a window,
+ * the same contract as the cadence counters. */
+typedef struct {
+    uint64_t presents;          /* frames that reached SwapWindow               */
+    uint64_t swap_us;           /* CPU time inside SwapWindow (GPU queue full,  */
+                                /* or vsync when it is on)                      */
+    uint64_t batches;           /* textured + flat batch draws                  */
+    uint64_t semi_isolated;     /* of which: one semi-transparent prim alone    */
+    uint64_t stencil_rebuilds;  /* mask stencil re-derived from alpha           */
+    uint64_t stencil_px;        /* hr-resolution pixels those rebuilds covered  */
+    uint64_t sync_reads;        /* ensure_cpu glReadPixels: waits for the GPU   */
+    uint64_t sync_skips;        /* guest reads that did not need to wait        */
+    uint64_t sync_us;           /* CPU time blocked in those reads              */
+    uint64_t hold_copies;       /* hold-last copies of the whole drawable       */
+    uint64_t hold_px;
+    uint64_t pack_px;           /* native pixels re-packed into the raw mirror  */
+    uint64_t mirror_passes;     /* native-wide mirror passes                    */
+    /* GPU timeline, only with PSX_GPU_PERF=1 in a release build (always on in
+     * debug-tools builds unless PSX_GL_PERF=0). TIME_ELAPSED counts idle gaps
+     * inside the bracket, so scene time near the frame time can also mean the
+     * GPU was waiting for the emulator; present time is submitted in one go
+     * and is tight. */
+    uint64_t gpu_frames;
+    uint64_t gpu_scene_us, gpu_present_us;
+    uint64_t gpu_scene_max_us;  /* worst frame of the last completed second     */
+} GlCost;
+static GlCost   s_gc;
+static uint64_t s_gc_scene_max_cur, s_gc_max_t0;
+
+static uint64_t gc_now_us(void) {
+    static uint64_t freq = 0;
+    if (!freq) { freq = SDL_GetPerformanceFrequency(); if (!freq) freq = 1; }
+    return (uint64_t)((double)SDL_GetPerformanceCounter() * 1.0e6 / (double)freq);
+}

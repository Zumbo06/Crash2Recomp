+/* The heartbeat's "gl" object: GlCost plus why textured batches were split
+ * (break_* in gpu_textured_triangle's reason order). Written from the
+ * heartbeat thread; every field is a monotonic total except scale, wide and
+ * gpu_scene_max_us. Returns the snprintf length, or 0 with "null" written
+ * when the GL pipeline is not running. */
+int gl_renderer_cost_json(char *out, size_t cap) {
+    if (!out || cap < 8) return 0;
+    if (!s_raster_ok) return snprintf(out, cap, "null");
+    const GlCost c = s_gc;
+    return snprintf(out, cap,
+        "{\"scale\":%d,\"wide\":%d,\"gpu_timed\":%d,"
+        "\"presents\":%llu,\"swap_us\":%llu,"
+        "\"batches\":%llu,\"semi_isolated\":%llu,"
+        "\"break_semi\":%llu,\"break_blend\":%llu,\"break_mask\":%llu,"
+        "\"break_filter\":%llu,\"break_gate\":%llu,\"break_twin\":%llu,"
+        "\"break_full\":%llu,"
+        "\"stencil_rebuilds\":%llu,\"stencil_px\":%llu,"
+        "\"sync_reads\":%llu,\"sync_skips\":%llu,\"sync_us\":%llu,"
+        "\"hold_copies\":%llu,\"hold_px\":%llu,\"pack_px\":%llu,"
+        "\"mirror_passes\":%llu,"
+        "\"gpu_frames\":%llu,\"gpu_scene_us\":%llu,\"gpu_present_us\":%llu,"
+        "\"gpu_scene_max_us\":%llu}",
+        s_scale, g_wide_w > 0 ? 1 : 0, s_pf_on,
+        (unsigned long long)c.presents, (unsigned long long)c.swap_us,
+        (unsigned long long)c.batches, (unsigned long long)c.semi_isolated,
+        (unsigned long long)s_batch_reason[0], (unsigned long long)s_batch_reason[1],
+        (unsigned long long)s_batch_reason[2], (unsigned long long)s_batch_reason[3],
+        (unsigned long long)s_batch_reason[4], (unsigned long long)s_batch_reason[5],
+        (unsigned long long)s_batch_reason[6],
+        (unsigned long long)c.stencil_rebuilds, (unsigned long long)c.stencil_px,
+        (unsigned long long)c.sync_reads, (unsigned long long)c.sync_skips,
+        (unsigned long long)c.sync_us,
+        (unsigned long long)c.hold_copies, (unsigned long long)c.hold_px,
+        (unsigned long long)c.pack_px, (unsigned long long)c.mirror_passes,
+        (unsigned long long)c.gpu_frames, (unsigned long long)c.gpu_scene_us,
+        (unsigned long long)c.gpu_present_us, (unsigned long long)c.gpu_scene_max_us);
+}

--- _build/psxrecomp-src/runtime/src/host_osd.c	2026-08-29 15:55:15.130241600 +0300
+++ _build/Crash2Recomp/psxrecomp/runtime/src/host_osd.c	2026-09-04 17:07:02.445217100 +0300
@@ -6,15 +6,27 @@
 #include "host_osd.h"
 #include "psx_rewind.h"
 #include "psx_savestate_menu.h"
+#include "psx_pause_menu.h"
 #include "psx_sdl.h"
 
 #include <stdio.h>
 #include <string.h>
 
-#if defined(RECOMP_LAUNCHER)
-#define HOST_OSD_VISUAL 1
-#else
+/* The visual OSD used to be gated on RECOMP_LAUNCHER, which meant a build made
+ * with PSX_RECOMP_UI=OFF silently lost every toast - including savestate
+ * feedback, so a quick save gave no indication it had happened.
+ *
+ * That gate was unnecessary: this file draws itself. It carries its own 8x8
+ * font and pixel buffers and includes nothing from recomp-ui, and BOTH present
+ * paths already consume it - host_osd_draw_sdl() for the SDL renderer, and
+ * gl_swap_with_osd() -> host_osd_image() for the OpenGL one. Only the producer
+ * was compiled out.
+ *
+ * Default on; define HOST_OSD_NO_VISUAL for a genuinely headless build. */
+#if defined(HOST_OSD_NO_VISUAL)
 #define HOST_OSD_VISUAL 0
+#else
+#define HOST_OSD_VISUAL 1
 #endif
 
 #define OSD_MAX_CHARS  64
@@ -169,6 +181,9 @@
 static SDL_Texture *s_sdl_ssm_tex;
 static int          s_sdl_ssm_tw;
 static int          s_sdl_ssm_th;
+static SDL_Texture *s_sdl_pm_tex;
+static int          s_sdl_pm_tw;
+static int          s_sdl_pm_th;
 static SDL_Renderer *s_sdl_ren;
 #endif
 
@@ -395,6 +410,7 @@
 int host_osd_needs_present(void) {
     if (psx_rewind_needs_present()) return 1;
     if (psx_savestate_menu_needs_present()) return 1;
+    if (psx_pause_menu_needs_present()) return 1;
 #if !HOST_OSD_VISUAL
     return 0;
 #else
@@ -512,6 +528,12 @@
             sdl_blit_argb(renderer, &s_sdl_ssm_tex, &s_sdl_ssm_tw,
                           &s_sdl_ssm_th, px, w, h, 0, 0, lw, lh);
         }
+        if (psx_pause_menu_overlay_image(&px, &w, &h) && px) {
+            int lw = 640, lh = 480;
+            sdl_logical_size(renderer, &lw, &lh);
+            sdl_blit_argb(renderer, &s_sdl_pm_tex, &s_sdl_pm_tw,
+                          &s_sdl_pm_th, px, w, h, 0, 0, lw, lh);
+        }
     }
 #else
     (void)renderer;

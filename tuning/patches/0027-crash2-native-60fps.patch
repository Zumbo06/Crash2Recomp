+/* SCUS-94154 CPU-only headroom. CPU charges are reduced while device
+ * intervals, VBlank, CD, SPU and timers stay on their original clock.
+ * Fractional carry keeps long-run guest time exact at a given percentage.
+ *
+ * Present in release as well as debugtools, because the native 60 FPS mode
+ * needs it in the build players actually run: at 100% the only cost is one
+ * predicted compare on a global that never changes while the mode is off. */
 uint32_t g_crash2_cpu_clock_pct = 100u;
-static uint32_t s_crash2_cpu_clock_remainder = 0u;
+/* 32.32 fixed point: 100/pct, and the fractional cycles not yet charged.
+ *
+ * This used to divide, and divide twice - `% pct` and `/ pct` on a 64-bit
+ * value, once per cycle charge, which is once per basic block of guest code.
+ * That was affordable while the scale existed only for short debugtools
+ * measurements. It is not affordable in the build players run, in a mode whose
+ * whole problem is host throughput. A reciprocal computed once when the
+ * percentage changes turns the hot path into a multiply and two shifts, and
+ * keeps the same exact long-run rate: the remainder still carries. */
+static uint64_t s_crash2_cpu_clock_recip = 1ull << 32;
+static uint64_t s_crash2_cpu_clock_frac = 0u;
 
 void psx_crash2_cpu_clock_set(uint32_t percent) {
+    if (percent == 0u) return;
     g_crash2_cpu_clock_pct = percent;
-    s_crash2_cpu_clock_remainder = 0u;
+    s_crash2_cpu_clock_recip = ((uint64_t)100u << 32) / percent;
+    s_crash2_cpu_clock_frac = 0u;
 }
 
 uint32_t psx_crash2_cpu_clock_charge(uint32_t cycles) {
-    uint32_t pct = g_crash2_cpu_clock_pct;
-    if (pct == 100u) return cycles;
-    uint64_t numerator = (uint64_t)cycles * 100u + s_crash2_cpu_clock_remainder;
-    s_crash2_cpu_clock_remainder = (uint32_t)(numerator % pct);
-    return (uint32_t)(numerator / pct);
+    if (g_crash2_cpu_clock_pct == 100u) return cycles;
+    uint64_t total = (uint64_t)cycles * s_crash2_cpu_clock_recip
+                     + s_crash2_cpu_clock_frac;
+    s_crash2_cpu_clock_frac = total & 0xFFFFFFFFull;
+    return (uint32_t)(total >> 32);
 }
 
 /* Native overlay DLLs batch their CPU charges before invoking this callback.

+/* The shipped SCUS-94154 native 60 FPS mode, live.
+ *
+ *   crash2_60fps                      -> current state and engine frame time
+ *   crash2_60fps {"enabled":1|0}      -> open/close the 30 Hz gate
+ *   crash2_60fps {"cpu_percent":100..150}
+ *
+ * Unlike the ablation probes below this one drives the same code path the
+ * launcher's setting does (crash2_60fps.h), so what is measured here is what
+ * a player gets. Turning it off restores the original comparison word and the
+ * 100% CPU clock together. */
+static void handle_crash2_60fps(int id, const char *json)
+{
+    extern void crash2_60fps_set_mode(int on);
+    extern void crash2_60fps_set_cpu_percent(int percent);
+    extern int crash2_60fps_mode(void);
+    extern int crash2_60fps_verified(void);
+    extern int crash2_60fps_cpu_percent(void);
+    extern unsigned long long crash2_60fps_open_count(void);
+    extern unsigned long long crash2_60fps_backoff_count(void);
+    extern unsigned crash2_60fps_loop_hz(void);
+    extern unsigned crash2_60fps_hold_pct(void);
+    extern unsigned crash2_60fps_suspended(void);
+    extern int crash2_60fps_gate_open(void);
+    extern unsigned crash2_60fps_frame_ticks(void);
+    int enabled = json_get_int(json, "enabled", -1);
+    int percent = json_get_int(json, "cpu_percent", -1);
+    if (percent >= 0 && (percent < 100 || percent > 150)) {
+        send_err(id, "cpu_percent must be 100..150");
+        return;
+    }
+    if (percent >= 0) crash2_60fps_set_cpu_percent(percent);
+    if (enabled >= 0) crash2_60fps_set_mode(enabled);
+    send_fmt("{\"id\":%d,\"ok\":true,\"enabled\":%s,\"verified\":%d,"
+             "\"gate_open\":%s,\"cpu_percent\":%d,\"loop_hz\":%u,"
+             "\"one_field_pct\":%u,\"demo_mode\":%u,"
+             "\"gate_opened\":%llu,\"backoffs\":%llu,"
+             "\"gate_instruction\":\"0x%08X\",\"game_frame_ticks\":%u}",
+             id, crash2_60fps_mode() ? "true" : "false",
+             crash2_60fps_verified(),
+             crash2_60fps_gate_open() ? "true" : "false",
+             crash2_60fps_cpu_percent(), crash2_60fps_loop_hz(),
+             crash2_60fps_hold_pct(), crash2_60fps_suspended(),
+             (unsigned long long)crash2_60fps_open_count(),
+             (unsigned long long)crash2_60fps_backoff_count(),
+             psx_read_word(0x8001685Cu), crash2_60fps_frame_ticks());
+}

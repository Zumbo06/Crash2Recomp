+/* frame_rates: the five cadences, separated, over one measured window.
+ *
+ * The existing FPS readout counts guest VBLANKS (main.cpp, "Count simulated
+ * vblanks rather than presents"), so it reports ~60 whether the game updates
+ * every VBlank or every other one. That is the question this answers, by never
+ * conflating the five things that all get called "FPS":
+ *
+ *   vblank_raise    guest VBlanks raised   (cycle-paced, 564480 cycles each)
+ *   vblank_deliver  ...actually taken by the guest as an exception
+ *   present_bodies  host present path runs (once per raised VBlank)
+ *   distinct_frames display base actually CHANGED - a new image was scanned out
+ *   host_swaps      SDL_GL_SwapWindow calls
+ *
+ * distinct_frames is the load-bearing one: a double-buffered title flips the
+ * display base to show the buffer it just finished, so this counts new images
+ * and not repeats. If it reads ~30 while vblank_raise reads ~60, the game
+ * renders every other VBlank.
+ *
+ *   frame_rates              -> rates since the baseline
+ *   frame_rates {"reset":1}  -> re-baseline now (call this, play, call again)
+ *
+ * Percentiles come from the GL perf ring and are 0 when it is off (always, in a
+ * release build). budget_ms defaults to the 59.94 Hz frame budget. */
+static uint64_t s_fr_base_ms = 0;
+static uint64_t s_fr_base_raise, s_fr_base_deliver, s_fr_base_present;
+static uint64_t s_fr_base_flip, s_fr_base_swap;
+
+static void frame_rates_baseline(void)
+{
+    extern uint64_t g_vblank_raise_count, g_vblank_deliver_count;
+    extern uint64_t g_display_flip_count;
+    s_fr_base_ms      = psx_host_mono_ms();
+    s_fr_base_raise   = g_vblank_raise_count;
+    s_fr_base_deliver = g_vblank_deliver_count;
+    s_fr_base_present = s_frame_count;
+    s_fr_base_flip    = g_display_flip_count;
+    s_fr_base_swap    = g_gl_swap_total;
+}
+
+static void handle_frame_rates(int id, const char *json)
+{
+    extern uint64_t g_vblank_raise_count, g_vblank_deliver_count;
+    extern uint64_t g_display_flip_count;
+    const double budget = (double)json_get_int(json, "budget_ms", 0);
+    if (json_get_int(json, "reset", 0) || s_fr_base_ms == 0) {
+        frame_rates_baseline();
+        send_fmt("{\"id\":%d,\"ok\":true,\"baseline\":true}", id);
+        return;
+    }
+    const uint64_t now = psx_host_mono_ms();
+    const double secs = (double)(now - s_fr_base_ms) / 1000.0;
+    if (secs <= 0.0) { send_err(id, "window too short; wait and retry"); return; }
+
+    const double raise_s   = (double)(g_vblank_raise_count   - s_fr_base_raise)   / secs;
+    const double deliver_s = (double)(g_vblank_deliver_count - s_fr_base_deliver) / secs;
+    const double present_s = (double)(s_frame_count          - s_fr_base_present) / secs;
+    const double flip_s    = (double)(g_display_flip_count   - s_fr_base_flip)    / secs;
+    const double swap_s    = (double)(g_gl_swap_total        - s_fr_base_swap)    / secs;
+
+    /* Default the deadline to 1.5x the frame period, not 1.0x. At exactly the
+     * period the host frame time IS the pacer period, so roughly half of a
+     * healthy run lands microseconds above it and "over budget" reads ~50% on a
+     * perfectly paced game (measured: 130/256 with p99 at 16.718 ms). A missed
+     * deadline worth reporting is one that cost a frame. */
+    double p[4] = {0,0,0,0};
+    const int psamples = gl_renderer_perf_percentiles(
+        -1, budget > 0.0 ? budget : (1.5 * 1000.0 / 59.94), p);
+
+    /* vblanks_per_frame is the whole answer in one number: 1.0 = the game put a
+     * new image up every VBlank, 2.0 = every other one. */
+    const double vpf = flip_s > 0.0 ? raise_s / flip_s : 0.0;
+
+    send_fmt("{\"id\":%d,\"ok\":true,\"seconds\":%.3f,"
+             "\"vblank_raise\":%.2f,\"vblank_deliver\":%.2f,"
+             "\"present_bodies\":%.2f,\"distinct_frames\":%.2f,"
+             "\"host_swaps\":%.2f,\"vblanks_per_frame\":%.3f,"
+             "\"speed\":%.3f,\"perf_samples\":%d,"
+             "\"frame_ms_p50\":%.3f,\"frame_ms_p95\":%.3f,"
+             "\"frame_ms_p99\":%.3f,\"over_budget\":%d}",
+             id, secs, raise_s, deliver_s, present_s, flip_s, swap_s, vpf,
+             raise_s / 59.94, psamples, p[0], p[1], p[2], (int)p[3]);
+}

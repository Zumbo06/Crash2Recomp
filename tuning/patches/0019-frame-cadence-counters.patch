+/* Distinct scanned-out frames: one per actual change of the display base.
+ *
+ * A double-buffered title flips this to show the buffer it just finished
+ * drawing, so a change here means "a NEW image reached the screen" - which is
+ * the one signal a static scene cannot fake. Counting presents or hashing
+ * pixels both answer a different question: the present path runs every VBlank
+ * whether or not the game drew anything, and identical pixels can follow a
+ * perfectly real update.
+ *
+ * Deliberately counts CHANGES, not writes: games re-send GP1(05h) with the same
+ * value, and that is not a new frame. Free in release - two compares and an
+ * increment, no allocation, no gating. */
+uint64_t g_display_flip_count = 0;
+
 static void gp1_display_area_start(uint32_t val) {
     /* GP1(05h): Start of display area in VRAM
      * bits 0-9: X (in halfwords, 0-1023)
      * bits 10-18: Y (0-511) */
-    display_area_x = val & 0x3FF;
-    display_area_y = (val >> 10) & 0x1FF;
+    const uint32_t nx = val & 0x3FF;
+    const uint32_t ny = (val >> 10) & 0x1FF;
+    if (nx != display_area_x || ny != display_area_y) g_display_flip_count++;
+    display_area_x = nx;
+    display_area_y = ny;
     ws_note_display_base(display_area_x);  /* learn the display buffer set (native-wide) */
 }
 

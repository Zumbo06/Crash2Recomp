+/* Frame-time percentiles over the same ring the averages come from.
+ *
+ * A single average hides exactly the thing that is worth knowing: an average of
+ * 16.6 ms is equally consistent with a steady 60 fps and with half the frames
+ * at 8 ms and half at 25 ms, and only the second is visible as stutter. p95/p99
+ * and a count of frames over the budget say which one you have.
+ *
+ * Kept OUT of gl_renderer_perf_aggregate's out[18]: that array is indexed
+ * positionally by handle_frame_perf, so widening it would silently renumber
+ * every field. Sorting a copy of at most GLPERF_RING doubles is cheap and only
+ * happens when a diagnostic asks.
+ *
+ * out[0]=p50 out[1]=p95 out[2]=p99 out[3]=frames over budget_ms. Returns the
+ * sample count, 0 if perf sampling is off (it is compiled out in release). */
+static int glperf_cmp_double(const void *a, const void *b) {
+    const double x = *(const double *)a, y = *(const double *)b;
+    return (x > y) - (x < y);
+}
+
+int gl_renderer_perf_percentiles(int wide_filter, double budget_ms, double out[4]) {
+    for (int i = 0; i < 4; i++) out[i] = 0.0;
+    if (!s_pf_on) return 0;
+    double v[GLPERF_RING];
+    int navail = (int)(s_pf_ring_seq < (uint64_t)GLPERF_RING ? s_pf_ring_seq : GLPERF_RING);
+    uint64_t start = s_pf_ring_seq - (uint64_t)navail;
+    int n = 0, over = 0;
+    for (int i = 0; i < navail; i++) {
+        const GlPerfSample *s = &s_pf_ring[(start + i) % GLPERF_RING];
+        if (wide_filter >= 0 && s->wide != wide_filter) continue;
+        if (budget_ms > 0.0 && s->total_ms > budget_ms) over++;
+        v[n++] = s->total_ms;
+    }
+    if (n <= 0) return 0;
+    qsort(v, (size_t)n, sizeof(double), glperf_cmp_double);
+    /* Nearest-rank: index = ceil(p*n) - 1, clamped. Exact for small n, which
+     * matters here because the ring holds only 256 frames (~4 s). */
+    const double pct[3] = { 0.50, 0.95, 0.99 };
+    for (int k = 0; k < 3; k++) {
+        int idx = (int)((pct[k] * (double)n) + 0.999999) - 1;
+        if (idx < 0) idx = 0;
+        if (idx >= n) idx = n - 1;
+        out[k] = v[idx];
+    }
+    out[3] = (double)over;
+    return n;
+}

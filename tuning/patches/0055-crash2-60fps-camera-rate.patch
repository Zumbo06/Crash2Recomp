+static void c2_60_cam_read(int32_t pose[C2_60_CAM_WORDS])
+{
+    for (uint32_t i = 0; i < C2_60_CAM_WORDS; i++)
+        pose[i] = (int32_t)c2_60_peek(C2_60_CAM_POSE + 4u * i);
+}
+
+/* Once per outer loop, before anything in it reads the camera: put the real
+ * pose back if the last field was drawn from another one, then take the pose
+ * the last camera update made into the history. */
+static void c2_60_cam_loop(void)
+{
+    if (c2_60_cam_enabled < 0) {
+        const char *e = getenv("PSX_CRASH2_60FPS_CAMERA_RATE");
+        c2_60_cam_enabled = (e && e[0] == '0') ? 0 : 1;
+    }
+    if (c2_60_restored) {
+        /* RAM was replaced: what it holds is the camera now, and nothing held
+         * here describes it. */
+        c2_60_cam_drawn = 0;
+        c2_60_cam_ran = 0;
+        c2_60_cam_hist = 0;
+        return;
+    }
+    int32_t pose[C2_60_CAM_WORDS];
+    if (c2_60_cam_drawn) {
+        c2_60_cam_drawn = 0;
+        c2_60_cam_read(pose);
+        int ours = 1;
+        for (uint32_t i = 0; i < C2_60_CAM_WORDS; i++)
+            if ((uint32_t)pose[i] != c2_60_cam_drawn_words[i]) ours = 0;
+        if (ours) {
+            for (uint32_t i = 0; i < C2_60_CAM_WORDS; i++)
+                c2_60_poke(C2_60_CAM_POSE + 4u * i, (uint32_t)c2_60_cam_cur[i]);
+        } else {
+            c2_60_cam_hist = 0;    /* moved by something else: that stands */
+        }
+    }
+    if (c2_60_cam_ran) {
+        c2_60_cam_ran = 0;
+        c2_60_cam_read(pose);
+        memcpy(c2_60_cam_prev, c2_60_cam_cur, sizeof c2_60_cam_prev);
+        memcpy(c2_60_cam_cur, pose, sizeof c2_60_cam_cur);
+        c2_60_cam_cut = (int)((c2_60_peek(C2_60_CAM_CUT & ~3u)
+                               >> (8u * (C2_60_CAM_CUT & 3u))) & 0xFFu);
+        if (c2_60_cam_hist < 2) c2_60_cam_hist++;
+    } else if (c2_60_gool_step) {
+        /* The loop just gone was a step and its update did not run (no crash
+         * yet, a load): the next pose is not one step after the last. */
+        c2_60_cam_hist = 0;
+    }
+}
+
+/* A physics-only field, its camera update skipped: draw it from the last
+ * update's pose moved on by the share of a step since then, at the last step's
+ * speed. The real pose goes back at the next loop's top (c2_60_cam_loop). */
+static void c2_60_cam_between(void)
+{
+    if (c2_60_cam_hist < 2 || c2_60_cam_drawn || c2_60_cam_cut) {
+        c2_60_cam_held++;
+        return;
+    }
+    int32_t pose[C2_60_CAM_WORDS];
+    c2_60_cam_read(pose);
+    if (memcmp(pose, c2_60_cam_cur, sizeof pose) != 0) {
+        c2_60_cam_hist = 0;        /* moved since its update: draw what is there */
+        c2_60_cam_held++;
+        return;
+    }
+    const int64_t since = (int64_t)c2_60_gool_since;
+    const int64_t span = (int64_t)c2_60_gool_ticks;
+    if (since <= 0 || span <= 0 || since >= span) {
+        c2_60_cam_held++;
+        return;
+    }
+    int32_t delta[C2_60_CAM_WORDS];
+    for (uint32_t i = 0; i < C2_60_CAM_WORDS; i++) {
+        uint32_t d = (uint32_t)c2_60_cam_cur[i] - (uint32_t)c2_60_cam_prev[i];
+        int32_t limit = C2_60_CAM_MAX_MOVE;
+        if (i >= 3) {              /* angles: 4096 a turn, the shortest way */
+            d &= 0xFFFu;
+            delta[i] = d >= 2048u ? (int32_t)d - 4096 : (int32_t)d;
+            limit = C2_60_CAM_MAX_TURN;
+        } else {
+            delta[i] = (int32_t)d;
+        }
+        if (delta[i] > limit || delta[i] < -limit) {
+            c2_60_cam_held++;      /* a cut or a jump, not camera motion */
+            return;
+        }
+    }
+    for (uint32_t i = 0; i < C2_60_CAM_WORDS; i++) {
+        const int64_t num = (int64_t)delta[i] * since;
+        const int64_t add = (num >= 0 ? num + span / 2 : num - span / 2) / span;
+        c2_60_cam_drawn_words[i] = (uint32_t)c2_60_cam_cur[i] + (uint32_t)(int32_t)add;
+        c2_60_poke(C2_60_CAM_POSE + 4u * i, c2_60_cam_drawn_words[i]);
+    }
+    c2_60_cam_drawn = 1;
+    c2_60_cam_extrapolated++;
+}
+
+/* Entry to the camera update, before its first instruction: publish the flag
+ * the patched load at 0x80026D04 reads (see C2_60_CAM_UPDATE), and on a
+ * physics-only field draw the frame from where the camera is heading - the
+ * matrix (0x80017BC4) is built from the pose right after this call returns.
+ * Nothing before that load touches sp+44: the function saves its registers at
+ * sp+32..40 and the debug-camera block's two calls keep to their own frames. */
+static void c2_60_cam_entry(CPUState *cpu, uint32_t address)
+{
+    (void)address;
+    const uint32_t crash = c2_60_peek(C2_60_CRASH);
+    c2_60_cam_hooked = 1;
+    const int step = (c2_60_gool_active && c2_60_cam_enabled == 1)
+                         ? c2_60_gool_step : 1;
+    c2_60_poke(cpu->gpr[29] - C2_60_CAM_FLAG_SLOT, step ? crash : 0u);
+    if (step) {
+        if (crash) {
+            c2_60_cam_ran = 1;
+            c2_60_cam_updates++;
+            c2_60_win_cam++;
+        }
+        return;
+    }
+    c2_60_cam_between();
+}
+
+PSX_MOD_CONSTRUCTOR(c2_60_register_cam_entry)
+{
+    psx_mod_register_function_entry_plugin("crash2.native60.camera_rate",
+                                           C2_60_CAM_UPDATE, c2_60_cam_entry);
 }
 

+/* host_profiler.c - see host_profiler.h. */
+#include "host_profiler.h"
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+
+#define HP_SLOTS 32768u               /* distinct instruction pointers */
+#define HP_TOP   800                  /* written, by count             */
+#define HP_PATH  "psx_host_profile.json"
+
+typedef struct {
+    uint64_t ip;
+    uint32_t n[HP_PHASES];
+} HpSlot;
+
+static HpSlot  *s_slots;              /* allocated on first start       */
+static volatile LONG s_phase;
+static HANDLE   s_target;             /* the emulation thread           */
+static DWORD    s_target_id;
+static HANDLE   s_thread;             /* the sampler                    */
+/* 0 idle, 1 sampling, 2 paused, 3 finished (budget spent or shut down) */
+static volatile LONG s_state;
+static volatile LONG s_written;
+static char     s_tag[48];
+static uint64_t s_budget_us, s_active_us;
+static uint64_t s_samples, s_dropped, s_phase_n[HP_PHASES];
+static int      s_env = -1;           /* PSX_HOST_PROFILE: -1 unset, 0, 1 */
+
+static void hp_write(void);
+
+void host_profiler_attach(void)
+{
+    if (s_target) return;
+    s_target_id = GetCurrentThreadId();
+    if (!DuplicateHandle(GetCurrentProcess(), GetCurrentThread(),
+                         GetCurrentProcess(), &s_target,
+                         THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT |
+                             THREAD_QUERY_INFORMATION,
+                         FALSE, 0))
+        s_target = NULL;
+    const char *e = getenv("PSX_HOST_PROFILE");
+    s_env = (e && e[0]) ? (e[0] != '0') : -1;
+    if (s_env == 1) host_profiler_start("session", 60);
+}
+
+void host_profiler_phase(int phase)
+{
+    s_phase = phase;
+}
+
+/* One sample. Nothing here may take a lock the suspended thread could hold:
+ * no allocation, no loader or debug-help calls - only the context read. */
+static void hp_sample(void)
+{
+    if (SuspendThread(s_target) == (DWORD)-1) return;
+    CONTEXT ctx;
+    memset(&ctx, 0, sizeof(ctx));
+    ctx.ContextFlags = CONTEXT_CONTROL;
+    const BOOL ok = GetThreadContext(s_target, &ctx);
+    const LONG phase = s_phase;
+    ResumeThread(s_target);
+    if (!ok) return;
+#if defined(_M_X64) || defined(__x86_64__)
+    const uint64_t ip = (uint64_t)ctx.Rip;
+#else
+    const uint64_t ip = (uint64_t)ctx.Eip;
+#endif
+    const int ph = (phase >= 0 && phase < HP_PHASES) ? (int)phase : HP_OTHER;
+    s_samples++;
+    s_phase_n[ph]++;
+    uint32_t h = (uint32_t)((ip * 0x9E3779B97F4A7C15ull) >> 49) & (HP_SLOTS - 1u);
+    for (uint32_t probe = 0; probe < 64u; probe++) {
+        HpSlot *s = &s_slots[(h + probe) & (HP_SLOTS - 1u)];
+        if (s->ip == ip) { s->n[ph]++; return; }
+        if (s->ip == 0) { s->ip = ip; s->n[ph] = 1; return; }
+    }
+    s_dropped++;
+}
+
+static DWORD WINAPI hp_thread_main(LPVOID arg)
+{
+    (void)arg;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+    HANDLE timer = CreateWaitableTimerExW(NULL, NULL,
+                                          CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                          TIMER_ALL_ACCESS);
+    LARGE_INTEGER freq, last, now;
+    QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&last);
+    while (s_state != 3) {
+        /* Every 2 ms: ~500 samples a second, 10,000 in the 120 FPS budget.
+         * Each one stops the sampled thread for a few microseconds, so the
+         * rate is kept where that stays well under 1% of it - profiling a
+         * mode that is short of time must not be what tips it over. */
+        if (timer) {
+            LARGE_INTEGER due;
+            due.QuadPart = -20000;                  /* 2 ms, relative */
+            if (SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE))
+                WaitForSingleObject(timer, 30);
+            else
+                Sleep(2);
+        } else {
+            Sleep(2);
+        }
+        QueryPerformanceCounter(&now);
+        const uint64_t dt = (uint64_t)(now.QuadPart - last.QuadPart) * 1000000ull /
+                            (uint64_t)freq.QuadPart;
+        last = now;
+        if (s_state != 1) continue;
+        s_active_us += dt;
+        hp_sample();
+        if (s_active_us >= s_budget_us) {
+            InterlockedExchange(&s_state, 3);
+            hp_write();
+        }
+    }
+    if (timer) CloseHandle(timer);
+    return 0;
+}
+
+int host_profiler_start(const char *tag, unsigned seconds)
+{
+    if (!s_target || s_env == 0) return 0;
+    if (s_state == 3) return 0;
+    if (s_state == 1) return 1;
+    if (!s_slots) {
+        s_slots = (HpSlot *)calloc(HP_SLOTS, sizeof(HpSlot));
+        if (!s_slots) return 0;
+        snprintf(s_tag, sizeof(s_tag), "%s", tag ? tag : "profile");
+        s_budget_us = (uint64_t)(seconds ? seconds : 20u) * 1000000ull;
+    }
+    InterlockedExchange(&s_state, 1);
+    if (!s_thread) {
+        s_thread = CreateThread(NULL, 0, hp_thread_main, NULL, 0, NULL);
+        if (!s_thread) { InterlockedExchange(&s_state, 0); return 0; }
+    }
+    return 1;
+}
+
+void host_profiler_pause(void)
+{
+    InterlockedCompareExchange(&s_state, 2, 1);
+}
+
+void host_profiler_finish(void)
+{
+    if (!s_thread) return;
+    InterlockedExchange(&s_state, 3);
+    WaitForSingleObject(s_thread, 1000);
+    hp_write();
+}
+
+static int hp_cmp(const void *a, const void *b)
+{
+    const HpSlot *x = *(const HpSlot *const *)a, *y = *(const HpSlot *const *)b;
+    const uint64_t nx = (uint64_t)x->n[0] + x->n[1] + x->n[2] + x->n[3];
+    const uint64_t ny = (uint64_t)y->n[0] + y->n[1] + y->n[2] + y->n[3];
+    return nx < ny ? 1 : nx > ny ? -1 : 0;
+}
+
+/* Module of an address, as a short name and a base, with a small cache. */
+static const char *hp_module(uint64_t ip, uint64_t *base)
+{
+    static struct { HMODULE h; char name[64]; } cache[64];
+    static int ncache;
+    HMODULE h = NULL;
+    *base = 0;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                            (LPCWSTR)(uintptr_t)ip, &h) || !h)
+        return "?";
+    *base = (uint64_t)(uintptr_t)h;
+    for (int i = 0; i < ncache; i++)
+        if (cache[i].h == h) return cache[i].name;
+    char path[MAX_PATH];
+    DWORD n = GetModuleFileNameA(h, path, sizeof(path));
+    const char *name = "?";
+    if (n > 0) {
+        const char *slash = strrchr(path, '\\');
+        name = slash ? slash + 1 : path;
+    }
+    if (ncache < 64) {
+        cache[ncache].h = h;
+        snprintf(cache[ncache].name, sizeof(cache[ncache].name), "%s", name);
+        return cache[ncache++].name;
+    }
+    return "?";
+}
+
+static void hp_write(void)
+{
+    if (!s_slots || s_samples == 0) return;
+    if (InterlockedExchange(&s_written, 1)) return;
+    HpSlot **order = (HpSlot **)malloc(sizeof(HpSlot *) * HP_SLOTS);
+    if (!order) return;
+    int used = 0;
+    for (uint32_t i = 0; i < HP_SLOTS; i++)
+        if (s_slots[i].ip) order[used++] = &s_slots[i];
+    qsort(order, (size_t)used, sizeof(order[0]), hp_cmp);
+
+    FILE *f = fopen(HP_PATH, "w");
+    if (!f) { free(order); return; }
+    const uint64_t exe = (uint64_t)(uintptr_t)GetModuleHandleW(NULL);
+    fprintf(f, "{\n  \"tag\": \"%s\",\n  \"active_ms\": %llu,\n  \"samples\": %llu,\n"
+               "  \"dropped\": %llu,\n  \"distinct\": %d,\n  \"exe_base\": \"0x%llX\",\n"
+               "  \"phases\": {\"emulate\": %llu, \"present\": %llu, \"pace\": %llu, "
+               "\"other\": %llu},\n  \"leaf\": [\n",
+            s_tag, (unsigned long long)(s_active_us / 1000u),
+            (unsigned long long)s_samples, (unsigned long long)s_dropped, used,
+            (unsigned long long)exe,
+            (unsigned long long)s_phase_n[0], (unsigned long long)s_phase_n[1],
+            (unsigned long long)s_phase_n[2], (unsigned long long)s_phase_n[3]);
+    const int top = used < HP_TOP ? used : HP_TOP;
+    for (int i = 0; i < top; i++) {
+        const HpSlot *s = order[i];
+        uint64_t base = 0;
+        const char *mod = hp_module(s->ip, &base);
+        fprintf(f, "    {\"m\": \"%s\", \"rva\": \"0x%llX\", \"n\": [%u, %u, %u, %u]}%s\n",
+                mod, (unsigned long long)(base ? s->ip - base : s->ip),
+                s->n[0], s->n[1], s->n[2], s->n[3], i + 1 < top ? "," : "");
+    }
+    fprintf(f, "  ]\n}\n");
+    fclose(f);
+    free(order);
+    fprintf(stdout, "psxrecomp: host profile (%s, %llu samples) written to %s\n",
+            s_tag, (unsigned long long)s_samples, HP_PATH);
+}
+
+#else  /* !_WIN32 */
+
+void host_profiler_attach(void) {}
+void host_profiler_phase(int phase) { (void)phase; }
+int  host_profiler_start(const char *tag, unsigned seconds) { (void)tag; (void)seconds; return 0; }
+void host_profiler_pause(void) {}
+void host_profiler_finish(void) {}
+
+#endif

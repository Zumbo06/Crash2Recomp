+/* host_profiler.h - a sampling profiler for the emulation thread.
+ *
+ * A helper thread suspends the emulation thread about 500 times a second,
+ * reads its instruction pointer, resumes it, and counts. What the
+ * thread was doing at the time - emulating, presenting, waiting on the pacer -
+ * is a plain store the main loop makes (host_profiler_phase), sampled in the
+ * same breath. The result, psx_host_profile.json in the working directory,
+ * is a flat profile by module and address: tuning/scripts/host_profile.py
+ * names the addresses from the executable's symbol table.
+ *
+ * Nothing is sampled unless something starts it: native 120 FPS does, for its
+ * first seconds engaged (the one mode that runs out of host time by design),
+ * and PSX_HOST_PROFILE=1 profiles a whole session from the start.
+ * PSX_HOST_PROFILE=0 turns it off entirely. Windows only; elsewhere every call
+ * is a no-op. */
+#ifndef HOST_PROFILER_H
+#define HOST_PROFILER_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+    HP_EMULATE = 0,   /* running guest code (and the GPU work it issues)  */
+    HP_PRESENT = 1,   /* the VBlank present body: render, post-fx, swap   */
+    HP_PACE    = 2,   /* waiting for the wall clock                       */
+    HP_OTHER   = 3,   /* menus, pause, anything else                      */
+    HP_PHASES  = 4
+};
+
+/* Once, on the thread to be sampled. */
+void host_profiler_attach(void);
+/* What that thread is doing now. A plain store; callable from anywhere. */
+void host_profiler_phase(int phase);
+/* Sample for up to `seconds` of active time under `tag`. One profile per
+ * session: a later call resumes the same one. Returns 1 while sampling. */
+int  host_profiler_start(const char *tag, unsigned seconds);
+/* Stop counting time and samples until the next start. */
+void host_profiler_pause(void);
+/* Write the profile if anything was sampled and it is not written yet. */
+void host_profiler_finish(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif

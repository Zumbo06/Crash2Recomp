+/* psx_pause_menu.h - full-screen Home-key pause menu.
+ *
+ * Same split as psx_savestate_menu: this module is a pure rasterizer with no
+ * input handling and no state of its own beyond what is pushed into it. The
+ * state machine, navigation and the actions themselves live in main.cpp, which
+ * calls psx_pause_menu_set_state() whenever anything changes.
+ */
+#ifndef PSX_PAUSE_MENU_H
+#define PSX_PAUSE_MENU_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Row indices. Kept public so main.cpp can act on a selection without
+ * duplicating the label table. */
+enum {
+    PSX_PAUSE_ROW_RESUME = 0,
+    PSX_PAUSE_ROW_QUICK_SAVE,
+    PSX_PAUSE_ROW_QUICK_LOAD,
+    PSX_PAUSE_ROW_ASPECT,
+    PSX_PAUSE_ROW_FIT,
+    PSX_PAUSE_ROW_FPS,
+    PSX_PAUSE_ROW_RESTART,
+    PSX_PAUSE_ROW_COUNT
+};
+
+/* Value counts for the three option rows, so main.cpp can wrap the cursor
+ * without hardcoding them. */
+#define PSX_PAUSE_ASPECT_COUNT 3   /* 4:3, 16:9, 21:9 */
+#define PSX_PAUSE_FIT_COUNT    4   /* letterbox, stretch, fill, fit width */
+
+/* Non-zero when the row responds to Left/Right rather than Enter. */
+int psx_pause_menu_row_is_option(int row);
+
+/* Push the whole visible state in one call. `aspect` and `fit` are indices,
+ * `fps_on` and `restart_armed` are booleans. Only marks dirty on real change,
+ * so calling it every frame is free. */
+void psx_pause_menu_set_state(int open, int selected,
+                              int aspect, int fit, int fps_on,
+                              int restart_armed);
+
+int psx_pause_menu_needs_present(void);
+
+/* ARGB8888, top-down, fully opaque. Returns 0 and NULLs the outputs when the
+ * menu is closed. Stretched to the full window by both present paths. */
+int psx_pause_menu_overlay_image(const uint32_t **pixels, int *w, int *h);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PSX_PAUSE_MENU_H */

+    {0x3F,0x66,0x66,0x3E,0x06,0x06,0x06,0x00}, {0x1E,0x33,0x33,0x33,0x3B,0x1E,0x38,0x00},
+    {0x3F,0x66,0x66,0x3E,0x36,0x66,0x67,0x00}, {0x1E,0x33,0x07,0x0E,0x38,0x33,0x1E,0x00},
+    {0x3F,0x2D,0x0C,0x0C,0x0C,0x0C,0x1E,0x00}, {0x33,0x33,0x33,0x33,0x33,0x33,0x3F,0x00},
+    {0x33,0x33,0x33,0x33,0x33,0x1E,0x0C,0x00}, {0x63,0x63,0x63,0x6B,0x7F,0x77,0x63,0x00},
+    {0x63,0x63,0x36,0x1C,0x1C,0x36,0x63,0x00}, {0x33,0x33,0x33,0x1E,0x0C,0x0C,0x1E,0x00},
+    {0x7F,0x63,0x31,0x18,0x4C,0x66,0x7F,0x00},
+};
+
+static int s_open;
+static int s_selected;
+static int s_aspect;
+static int s_fit;
+static int s_fps_on;
+static int s_restart_armed;
+static int s_dirty = 1;
+static uint32_t s_panel[PM_W * PM_H];
+
+static const char *const ROW_LABEL[PSX_PAUSE_ROW_COUNT] = {
+    "RESUME", "QUICK SAVE", "QUICK LOAD",
+    "GAME ASPECT", "IMAGE FIT", "FPS DISPLAY", "RESTART GAME",
+};
+static const char *const ASPECT_LABEL[PSX_PAUSE_ASPECT_COUNT] = {
+    "4:3", "16:9", "21:9",
+};
+static const char *const FIT_LABEL[PSX_PAUSE_FIT_COUNT] = {
+    "LETTERBOX", "STRETCH", "FILL", "FIT WIDTH",
+};
+
+int psx_pause_menu_row_is_option(int row)
+{
+    return row == PSX_PAUSE_ROW_ASPECT
+        || row == PSX_PAUSE_ROW_FIT
+        || row == PSX_PAUSE_ROW_FPS;
+}
+
+static void fill_rect(uint32_t *dst, int x0, int y0, int w, int h, uint32_t col)
+{
+    int x, y;
+    if (x0 < 0) { w += x0; x0 = 0; }
+    if (y0 < 0) { h += y0; y0 = 0; }
+    if (x0 + w > PM_W) w = PM_W - x0;
+    if (y0 + h > PM_H) h = PM_H - y0;
+    if (w <= 0 || h <= 0) return;
+    for (y = 0; y < h; y++)
+        for (x = 0; x < w; x++)
+            dst[(y0 + y) * PM_W + (x0 + x)] = col;
+}
+
+static void stroke_rect(uint32_t *dst, int x, int y, int w, int h, uint32_t col)
+{
+    fill_rect(dst, x, y, w, 1, col);
+    fill_rect(dst, x, y + h - 1, w, 1, col);
+    fill_rect(dst, x, y, 1, h, col);
+    fill_rect(dst, x + w - 1, y, 1, h, col);
+}
+
+static void fill_disc(uint32_t *dst, int cx, int cy, int r, uint32_t col)
+{
+    int x, y;
+    for (y = -r; y <= r; y++)
+        for (x = -r; x <= r; x++)
+            if (x * x + y * y <= r * r) {
+                int dx = cx + x, dy = cy + y;
+                if ((unsigned)dx < PM_W && (unsigned)dy < PM_H)
+                    dst[dy * PM_W + dx] = col;
+            }
+}
+
+static void draw_char(uint32_t *dst, int x0, int y0, char c,
+                      uint32_t col, int scale)
+{
+    int x, y, sx, sy;
+    const uint8_t *g;
+    if (c >= 'a' && c <= 'z') c = (char)(c - 32);
+    if (c < 32 || c > 90) c = '?';
+    g = FONT8[(int)c - 32];
+    for (y = 0; y < 8; y++) {
+        uint8_t row = g[y];
+        for (x = 0; x < 8; x++) {
+            if ((row & (1u << x)) == 0) continue;
+            for (sy = 0; sy < scale; sy++)
+                for (sx = 0; sx < scale; sx++) {
+                    int dx = x0 + x * scale + sx;
+                    int dy = y0 + y * scale + sy;
+                    if ((unsigned)dx < PM_W && (unsigned)dy < PM_H)
+                        dst[dy * PM_W + dx] = col;
+                }
+        }
+    }
+}
+
+static void draw_text(uint32_t *dst, int x, int y, const char *s,
+                      uint32_t col, int scale)
+{
+    if (!s) return;
+    while (*s) {
+        draw_char(dst, x, y, *s++, col, scale);
+        x += 8 * scale;
+    }
+}
+
+/* Right-aligned, for the value column. */
+static void draw_text_r(uint32_t *dst, int right_x, int y, const char *s,
+                        uint32_t col, int scale)
+{
+    int len = 0;
+    const char *p = s;
+    if (!s) return;
+    while (*p++) len++;
+    draw_text(dst, right_x - len * 8 * scale, y, s, col, scale);
+}
+
+static void draw_psx_button(uint32_t *dst, int x, int y, char kind)
+{
+    switch (kind) {
+    case 'x':
+        fill_disc(dst, x + 9, y + 9, 9, 0xFF2C3446u);
+        draw_text(dst, x + 5, y + 5, "X", 0xFF5FA8FFu, 1);
+        break;
+    case 'o':
+        fill_disc(dst, x + 9, y + 9, 9, 0xFF2C3446u);
+        fill_disc(dst, x + 9, y + 9, 6, 0xFFFF6B6Bu);
+        fill_disc(dst, x + 9, y + 9, 3, 0xFF2C3446u);
+        break;
+    default:
+        fill_rect(dst, x + 7, y + 2, 5, 15, 0xFFD7DCE6u);
+        fill_rect(dst, x + 2, y + 7, 15, 5, 0xFFD7DCE6u);
+        break;
+    }
+}
+
+static const char *value_for_row(int row, char *buf, size_t cap)
+{
+    switch (row) {
+    case PSX_PAUSE_ROW_ASPECT:
+        return ASPECT_LABEL[(unsigned)s_aspect < PSX_PAUSE_ASPECT_COUNT
+                            ? s_aspect : 0];
+    case PSX_PAUSE_ROW_FIT:
+        return FIT_LABEL[(unsigned)s_fit < PSX_PAUSE_FIT_COUNT ? s_fit : 0];
+    case PSX_PAUSE_ROW_FPS:
+        return s_fps_on ? "ON" : "OFF";
+    case PSX_PAUSE_ROW_RESTART:
+        if (s_restart_armed) {
+            snprintf(buf, cap, "PRESS AGAIN");
+            return buf;
+        }
+        return NULL;
+    default:
+        return NULL;
+    }
+}
+
+static void rasterize_panel(void)
+{
+    int i;
+    char buf[64];
+    char key[32];
+
+    for (i = 0; i < PM_W * PM_H; i++)
+        s_panel[i] = 0xFF0F1118u;
+
+    fill_rect(s_panel, 0, 0, PM_W, 46, 0xFF171B25u);
+    draw_text(s_panel, 24, 14, "PAUSED", 0xFFFFD24Du, 2);
+    host_keymap_label(HOST_KEYMAP_PAUSE_MENU, key, sizeof(key));
+    snprintf(buf, sizeof(buf), "%s MENU", key[0] ? key : "HOME");
+    draw_text(s_panel, 432, 18, buf, 0xFFB8BDC8u, 1);
+
+    for (i = 0; i < PSX_PAUSE_ROW_COUNT; i++) {
+        int y = PM_ROWS_Y + i * (PM_ROW_H + PM_ROW_GAP);
+        int sel = (i == s_selected);
+        int opt = psx_pause_menu_row_is_option(i);
+        uint32_t bg = sel ? 0xFF2B2830u : 0xFF191D27u;
+        uint32_t fg = sel ? 0xFFFFD24Du : 0xFFE2E5EBu;
+        uint32_t sub = sel ? 0xFFFFFFFFu : 0xFFB2B8C2u;
+        const char *val;
+
+        /* Restart stays red while armed so a second Enter is never a
+         * surprise. */
+        if (i == PSX_PAUSE_ROW_RESTART && s_restart_armed) {
+            bg = sel ? 0xFF3A2028u : 0xFF2A1820u;
+            fg = 0xFFFF8080u;
+        }
+        fill_rect(s_panel, PM_ROWS_X, y, PM_ROWS_W, PM_ROW_H, bg);
+        stroke_rect(s_panel, PM_ROWS_X, y, PM_ROWS_W, PM_ROW_H,
+                    sel ? 0xFFFFD24Du : 0xFF303746u);
+        draw_text(s_panel, PM_ROWS_X + 18, y + 16, ROW_LABEL[i], fg, 1);
+
+        buf[0] = 0;
+        val = value_for_row(i, buf, sizeof(buf));
+        if (val) {
+            if (opt && sel) {
+                draw_text(s_panel, PM_VALUE_X - 4, y + 16, "<", 0xFFFFD24Du, 1);
+                draw_text(s_panel, PM_ROWS_X + PM_ROWS_W - 26, y + 16, ">",
+                          0xFFFFD24Du, 1);
+            }
+            draw_text_r(s_panel, PM_ROWS_X + PM_ROWS_W - 38, y + 16, val,
+                        sub, 1);
+        }
+    }
+
+    fill_rect(s_panel, 0, 400, PM_W, 80, 0xFF171B25u);
+    draw_psx_button(s_panel, 32, 414, 'd');
+    draw_text(s_panel, 56, 418, "MOVE", 0xFFE2E5EBu, 1);
+    draw_psx_button(s_panel, 152, 414, 'x');
+    draw_text(s_panel, 176, 418, "SELECT", 0xFFE2E5EBu, 1);
+    draw_psx_button(s_panel, 288, 414, 'o');
+    draw_text(s_panel, 312, 418, "CLOSE", 0xFFE2E5EBu, 1);
+    draw_text(s_panel, 32, 444,
+              "KEYS: ARROWS MOVE/CHANGE  ENTER SELECT  ESC CLOSE",
+              0xFFB8BDC8u, 1);
+    s_dirty = 0;
+}
+
+void psx_pause_menu_set_state(int open, int selected,
+                              int aspect, int fit, int fps_on,
+                              int restart_armed)
+{
+    if (selected < 0) selected = 0;
+    if (selected >= PSX_PAUSE_ROW_COUNT) selected = PSX_PAUSE_ROW_COUNT - 1;
+    open = open ? 1 : 0;
+    fps_on = fps_on ? 1 : 0;
+    restart_armed = restart_armed ? 1 : 0;
+    if (s_open != open || s_selected != selected || s_aspect != aspect
+        || s_fit != fit || s_fps_on != fps_on
+        || s_restart_armed != restart_armed)
+        s_dirty = 1;
+    s_open = open;
+    s_selected = selected;
+    s_aspect = aspect;
+    s_fit = fit;
+    s_fps_on = fps_on;
+    s_restart_armed = restart_armed;
+}
+
+int psx_pause_menu_needs_present(void)
+{
+    return s_open;
+}
+
+int psx_pause_menu_overlay_image(const uint32_t **pixels, int *w, int *h)
+{
+    if (!s_open) {
+        if (pixels) *pixels = NULL;
+        if (w) *w = 0;
+        if (h) *h = 0;
+        return 0;
+    }
+    if (s_dirty)
+        rasterize_panel();
+    if (pixels) *pixels = s_panel;
+    if (w) *w = PM_W;
+    if (h) *h = PM_H;
+    return 1;
+}

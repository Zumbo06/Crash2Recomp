+/* ---------------------------------------------------------------------
+ * Home pause menu
+ *
+ * Same split as the savestate menu: psx_pause_menu.c only rasterizes, and
+ * everything below owns the state, the input and the actions. It reuses that
+ * menu's pause loop shape (blocking nested loop inside the vblank present
+ * body, so the guest cannot advance a cycle) and its re-present helper.
+ * ------------------------------------------------------------------- */
+
+static int pause_menu_open = 0;
+static int pause_menu_sel = 0;
+static int pause_menu_restart_armed = 0;   /* Restart needs a second press */
+static SDL_Keycode pause_menu_open_key = 0;
+
+/* Index order must match ASPECT_LABEL in psx_pause_menu.c. */
+static const int kPauseAspect[PSX_PAUSE_ASPECT_COUNT][2] = {
+    { 4, 3 }, { 16, 9 }, { 21, 9 }
+};
+
+static int pause_menu_aspect_index(void) {
+    for (int i = 0; i < PSX_PAUSE_ASPECT_COUNT; i++)
+        if (kPauseAspect[i][0] == g_video_aspect_num &&
+            kPauseAspect[i][1] == g_video_aspect_den)
+            return i;
+    return 0;   /* something custom is live; show 4:3 rather than lying */
+}
+
+static void pause_menu_sync_overlay(void) {
+    psx_pause_menu_set_state(pause_menu_open, pause_menu_sel,
+                             pause_menu_aspect_index(), g_present_fit_mode,
+                             fps_osd_enabled(), pause_menu_restart_armed);
+}
+
+/* Live aspect change. Same sequence update_adaptive_widescreen() uses when the
+ * window is resized - the GL display aspect, the SDL logical size, then the
+ * GTE/GPU widescreen projection. No relaunch. */
+static void pause_menu_apply_aspect(int index) {
+    if (index < 0 || index >= PSX_PAUSE_ASPECT_COUNT) return;
+    const int num = kPauseAspect[index][0];
+    const int den = kPauseAspect[index][1];
+    if (num == g_video_aspect_num && den == g_video_aspect_den) return;
+    /* A fixed pick from the menu is an explicit choice; stop following the
+     * window or the next resize would immediately overwrite it. */
+    g_ws_adaptive_view = false;
+    g_video_aspect_num = num;
+    g_video_aspect_den = den;
+    gl_renderer_set_display_aspect(num, den);
+    if (sdl_renderer) {
+        g_logical_w = 480 * num * g_video_scale / den;
+        SDL_RenderSetLogicalSize(sdl_renderer, g_logical_w, 480 * g_video_scale);
+    }
+    refresh_widescreen_projection();
+}
+
+static void pause_menu_apply_fit(int mode) {
+    if (mode < 0 || mode >= PSX_PAUSE_FIT_COUNT) return;
+    g_present_fit_mode = mode;
+    gl_renderer_set_scaling_mode(mode);
+}
+
+/* Restart = boot the game again from scratch. There is no soft reset in the
+ * runtime, and psx_game_codegen_relaunch_or_exit() is compiled out of this
+ * build (it needs PSX_HAS_GAME_CODEGEN + RECOMP_LAUNCHER), so re-exec the
+ * process with the exact command line we were started with. */
+static void pause_menu_restart_game(void) {
+#if defined(_WIN32)
+    STARTUPINFOW si;
+    PROCESS_INFORMATION pi;
+    wchar_t *cmd = _wcsdup(GetCommandLineW());
+    if (!cmd) return;
+    std::memset(&si, 0, sizeof(si));
+    si.cb = sizeof(si);
+    std::memset(&pi, 0, sizeof(pi));
+    std::fprintf(stdout, "psxrecomp: restart requested from pause menu\n");
+    std::fflush(stdout);
+    /* Tear the old process down first: it holds the audio device, the GL
+     * context and the overlay cache files the new one is about to open. */
+    psx_crash_trace_set_exit_origin("pause_menu_restart");
+    shutdown_runtime();
+    if (CreateProcessW(NULL, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi)) {
+        CloseHandle(pi.hProcess);
+        CloseHandle(pi.hThread);
+        std::free(cmd);
+        std::exit(0);
+    }
+    std::free(cmd);
+    /* Spawn failed - we have already shut down, so there is nothing to go
+     * back to. Exiting is the honest outcome. */
+    std::fprintf(stderr, "psxrecomp: restart failed to spawn; exiting\n");
+    std::exit(1);
+#else
+    host_osd_push("Restart is Windows-only in this build", 2000);
+#endif
+}
+
+static void pause_menu_close(void) {
+    pause_menu_open = 0;
+    pause_menu_restart_armed = 0;
+    pause_menu_sync_overlay();
+}
+
+static void pause_menu_toggle(SDL_Keycode opened_by_key) {
+    /* One modal at a time, matching savestate_menu_toggle's guard. */
+    if (!pause_menu_open && (psx_rewind_is_open() || savestate_menu_open))
+        return;
+    pause_menu_open = !pause_menu_open;
+    pause_menu_restart_armed = 0;
+    if (pause_menu_open) {
+        pause_menu_sel = 0;
+        pause_menu_open_key = opened_by_key;
+    } else {
+        pause_menu_open_key = 0;
+    }
+    pause_menu_sync_overlay();
+}
+
+static void pause_menu_move(int delta) {
+    pause_menu_sel += delta;
+    while (pause_menu_sel < 0) pause_menu_sel += PSX_PAUSE_ROW_COUNT;
+    while (pause_menu_sel >= PSX_PAUSE_ROW_COUNT)
+        pause_menu_sel -= PSX_PAUSE_ROW_COUNT;
+    /* Moving off Restart disarms it. */
+    pause_menu_restart_armed = 0;
+    pause_menu_sync_overlay();
+}
+
+/* Left/Right on an option row. */
+static void pause_menu_adjust(int delta) {
+    switch (pause_menu_sel) {
+    case PSX_PAUSE_ROW_ASPECT: {
+        int i = pause_menu_aspect_index() + delta;
+        while (i < 0) i += PSX_PAUSE_ASPECT_COUNT;
+        while (i >= PSX_PAUSE_ASPECT_COUNT) i -= PSX_PAUSE_ASPECT_COUNT;
+        pause_menu_apply_aspect(i);
+        break;
+    }
+    case PSX_PAUSE_ROW_FIT: {
+        int i = g_present_fit_mode + delta;
+        while (i < 0) i += PSX_PAUSE_FIT_COUNT;
+        while (i >= PSX_PAUSE_FIT_COUNT) i -= PSX_PAUSE_FIT_COUNT;
+        pause_menu_apply_fit(i);
+        break;
+    }
+    case PSX_PAUSE_ROW_FPS:
+        fps_osd_set(!fps_osd_enabled());
+        break;
+    default:
+        return;
+    }
+    pause_menu_sync_overlay();
+}
+
+/* Enter / Cross on the selected row. */
+static void pause_menu_activate(void) {
+    if (psx_pause_menu_row_is_option(pause_menu_sel)) {
+        pause_menu_adjust(1);
+        return;
+    }
+    switch (pause_menu_sel) {
+    case PSX_PAUSE_ROW_RESUME:
+        pause_menu_close();
+        break;
+    case PSX_PAUSE_ROW_QUICK_SAVE:
+        if (savestate_submit_slot(psx_quick_slot(), 1))
+            host_osd_push("Quick save", 1200);
+        pause_menu_close();
+        break;
+    case PSX_PAUSE_ROW_QUICK_LOAD:
+        if (!savestate_slot_exists(psx_quick_slot())) {
+            host_osd_push("No quick save yet", 1500);
+        } else if (savestate_submit_slot(psx_quick_slot(), 0)) {
+            host_osd_push("Quick load", 1200);
+        }
+        pause_menu_close();
+        break;
+    case PSX_PAUSE_ROW_RESTART:
+        if (!pause_menu_restart_armed) {
+            pause_menu_restart_armed = 1;   /* confirm on the next press */
+            pause_menu_sync_overlay();
+        } else {
+            pause_menu_restart_game();      /* does not return */
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static void pause_menu_handle_key(SDL_Keycode key, SDL_Scancode sc,
+                                  int mod, int repeat) {
+    if (repeat) return;
+    if (key == SDLK_ESCAPE || key == SDLK_BACKSPACE) {
+        pause_menu_close();
+        return;
+    }
+    if (host_keymap_match_event(HOST_KEYMAP_PAUSE_MENU, key, sc, mod)
+        && key != pause_menu_open_key) {
+        pause_menu_close();
+        return;
+    }
+    switch (key) {
+    case SDLK_UP:    pause_menu_move(-1); break;
+    case SDLK_DOWN:  pause_menu_move(1);  break;
+    case SDLK_LEFT:  pause_menu_adjust(-1); break;
+    case SDLK_RIGHT: pause_menu_adjust(1);  break;
+    case SDLK_RETURN:
+    case SDLK_KP_ENTER:
+    case SDLK_SPACE: pause_menu_activate(); break;
+    default: break;
+    }
+}
+
+/* Gamepad navigation, mirroring savestate_menu_poll_nav: edge-detected with a
+ * 160 ms auto-repeat so a held stick scrolls rather than races. */
+static void pause_menu_poll_nav(uint32_t now_ms) {
+    static int prev_up = 0, prev_down = 0, prev_left = 0, prev_right = 0;
+    static int prev_accept = 0, prev_cancel = 0;
+    static uint32_t repeat_at = 0;
+    int up = 0, down = 0, left = 0, right = 0, accept = 0, cancel = 0;
+
+    SDL_GameController *c = g_players[0].handle;
+    if (c) {
+        const Sint16 ax_y = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_LEFTY);
+        const Sint16 ax_x = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_LEFTX);
+        const int dz = 16000;
+        if (SDL_GameControllerGetButton(c, SDL_CONTROLLER_BUTTON_DPAD_UP)    || ax_y < -dz) up = 1;
+        if (SDL_GameControllerGetButton(c, SDL_CONTROLLER_BUTTON_DPAD_DOWN)  || ax_y >  dz) down = 1;
+        if (SDL_GameControllerGetButton(c, SDL_CONTROLLER_BUTTON_DPAD_LEFT)  || ax_x < -dz) left = 1;
+        if (SDL_GameControllerGetButton(c, SDL_CONTROLLER_BUTTON_DPAD_RIGHT) || ax_x >  dz) right = 1;
+        if (SDL_GameControllerGetButton(c, SDL_CONTROLLER_BUTTON_A)) accept = 1;
+        if (SDL_GameControllerGetButton(c, SDL_CONTROLLER_BUTTON_B)) cancel = 1;
+    }
+
+    const int held = up || down || left || right;
+    const int edge_up    = up    && !prev_up;
+    const int edge_down  = down  && !prev_down;
+    const int edge_left  = left  && !prev_left;
+    const int edge_right = right && !prev_right;
+    int fire = edge_up || edge_down || edge_left || edge_right;
+    if (!fire && held && now_ms >= repeat_at) fire = 1;
+    if (fire) {
+        if (up)         pause_menu_move(-1);
+        else if (down)  pause_menu_move(1);
+        else if (left)  pause_menu_adjust(-1);
+        else if (right) pause_menu_adjust(1);
+        repeat_at = now_ms + 160u;
+    }
+    if (!held) repeat_at = 0;
+
+    if (accept && !prev_accept) pause_menu_activate();
+    if (cancel && !prev_cancel) pause_menu_close();
+
+    prev_up = up; prev_down = down; prev_left = left; prev_right = right;
+    prev_accept = accept; prev_cancel = cancel;
+}
+
+/* The pad's Home/Guide button. SDL only reports GUIDE on backends that grab
+ * it; where it never arrives the keyboard Home key and the pad chord below
+ * still open the menu. */
+static void pause_menu_poll_toggle_buttons(void) {
+    static int prev = 0;
+    int now = 0;
+    SDL_GameController *c = g_players[0].handle;
+    if (c) {
+        if (SDL_GameControllerGetButton(c, SDL_CONTROLLER_BUTTON_GUIDE))
+            now = 1;
+        /* Start+Select is the universally available fallback chord. */
+        if (SDL_GameControllerGetButton(c, SDL_CONTROLLER_BUTTON_START) &&
+            SDL_GameControllerGetButton(c, SDL_CONTROLLER_BUTTON_BACK))
+            now = 1;
+    }
+    if (now && !prev) pause_menu_toggle(0);
+    prev = now;
+}
+
+static void pause_menu_host_pause_loop(void) {
+    while (pause_menu_open) {
+        SDL_Event ev;
+        while (SDL_PollEvent(&ev)) {
+            if (ev.type == SDL_QUIT) {
+                psx_crash_trace_set_exit_origin("sdl_window_close");
+                shutdown_runtime();
+                std::exit(0);
+            } else if (ev.type == SDL_CONTROLLERDEVICEADDED) {
+                refresh_player_devices();
+            } else if (ev.type == SDL_CONTROLLERDEVICEREMOVED) {
+                close_controller();
+                refresh_player_devices();
+            } else if (ev.type == SDL_KEYDOWN) {
+#if defined(PSX_SDL3)
+                const SDL_Keymod mod = ev.key.mod;
+                const SDL_Keycode key = ev.key.key;
+                const SDL_Scancode scancode = ev.key.scancode;
+                const int repeat = ev.key.repeat ? 1 : 0;
+#else
+                const Uint16 mod = ev.key.keysym.mod;
+                const SDL_Keycode key = ev.key.keysym.sym;
+                const SDL_Scancode scancode = ev.key.keysym.scancode;
+                const int repeat = ev.key.repeat ? 1 : 0;
+#endif
+                pause_menu_handle_key(key, scancode, (int)mod, repeat);
+            } else if (ev.type == SDL_KEYUP) {
+#if defined(PSX_SDL3)
+                const SDL_Keycode key = ev.key.key;
+#else
+                const SDL_Keycode key = ev.key.keysym.sym;
+#endif
+                if (pause_menu_open_key == key)
+                    pause_menu_open_key = 0;
+            }
+        }
+        pause_menu_poll_nav((uint32_t)SDL_GetTicks());
+        rewind_pause_present();
+        SDL_Delay(8);
+    }
+    /* Swallow the closing press so it does not bleed into the guest pad. */
+    savestate_input_guard_arm();
+}

         memset(v, 0, sizeof(*v));
         v->active = 1;
         /* Address registers count 8-byte units but hardware ignores bit0
@@ -927,6 +1050,8 @@
         v->adsr_divider = 0;
         v->adsr_phase = ADSR_ATTACK;

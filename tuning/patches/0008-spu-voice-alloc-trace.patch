+        /* Classify what this key-on is displacing, before memset wipes it. */
+        if (alloc_trace_on()) {
+            if (!v->active || v->env_level <= 0x0100) {
+                s_keyon_onto_silent++;
+            } else if (v->adsr_phase == ADSR_RELEASE) {
+                s_keyon_onto_released++;
+            } else {
+                s_keyon_onto_live++;
+                s_keyon_live_voice[i]++;
+            }

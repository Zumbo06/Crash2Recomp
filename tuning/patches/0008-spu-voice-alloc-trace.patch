             /* Voice register 6 (byte offset 0x0C) is CURVOL / ADSR_LEVEL —
@@ -1405,8 +1536,10 @@
             if (addr >= 0x1F801C00u && addr < 0x1F801D80u
                 && (idx & 7u) == 6u) {
                 int v = (int)(idx >> 3);
-                if (v >= 0 && v < SPU_VOICE_COUNT)

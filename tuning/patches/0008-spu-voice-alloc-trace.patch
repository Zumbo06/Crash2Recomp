+/* The 39-tap half-band FIR the SPU applies at the 44.1 <-> 22.05 kHz
+ * boundary (psx-spx, "SPU Reverb Formula": reverb down/upsampling filter).
+ * Symmetric; every odd tap except the centre is zero; taps sum to 0x8000, so
+ * (acc >> 15) is unity gain. */
+#define REV_FIR_TAPS 39
+static const int32_t REV_FIR[REV_FIR_TAPS] = {
+    -0x0001, 0x0000,  0x0002, 0x0000, -0x000A, 0x0000,  0x0023, 0x0000,
+    -0x0067, 0x0000,  0x010A, 0x0000, -0x0268, 0x0000,  0x0534, 0x0000,
+    -0x0B90, 0x0000,  0x2806, 0x4000,  0x2806, 0x0000, -0x0B90, 0x0000,
+     0x0534, 0x0000, -0x0268, 0x0000,  0x010A, 0x0000, -0x0067, 0x0000,
+     0x0023, 0x0000, -0x000A, 0x0000,  0x0002, 0x0000, -0x0001,
+};
+
+/* Filter histories, per channel. Deliberately NOT serialised: after a
+ * savestate load they restart from silence and settle within 39 frames
+ * (under 1 ms), inaudible for a delay effect, and it keeps the state format
+ * unchanged. */
+static int32_t rev_dn_hist[2][REV_FIR_TAPS];   /* 44.1 kHz send, pre-decimation */
+static int32_t rev_up_hist[2][REV_FIR_TAPS];   /* zero-stuffed 22.05 kHz engine output */
+static int     rev_dn_pos, rev_up_pos;
+
+static void rev_fir_reset(void) {
+    memset(rev_dn_hist, 0, sizeof(rev_dn_hist));
+    memset(rev_up_hist, 0, sizeof(rev_up_hist));
+    rev_dn_pos = rev_up_pos = 0;
+}
+
+/* FIR dot product over a ring whose NEWEST sample sits at `pos` (tap 38). */
+static inline int32_t rev_fir_apply(const int32_t *hist, int pos) {
+    int64_t acc = 0;
+    int i = pos;
+    for (int k = REV_FIR_TAPS - 1; k >= 0; k--) {
+        acc += (int64_t)REV_FIR[k] * hist[i];
+        i = (i == 0) ? REV_FIR_TAPS - 1 : i - 1;
+    }
+    return (int32_t)(acc >> 15);
+}
+
+/* One 44.1 kHz frame of the reverb path, shared by the idle and active mix
+ * loops.
+ *
+ *   input : the send goes through the FIR, and every other frame the
+ *           band-limited result feeds one 22.05 kHz engine step. Replaces the
+ *           box average of two frames, which let everything above 11 kHz in
+ *           the send alias straight into the reverb.
+ *   output: the engine result is zero-stuffed to 44.1 kHz and filtered by the
+ *           same FIR. Replaces the linear midpoint between steps, which rolled
+ *           the wet signal's highs off. The x2 undoes the stuffing (half the
+ *           samples are zero); at frames aligned to a step only the centre tap
+ *           sees a non-zero sample, so those frames reproduce the engine
+ *           output exactly, as before. The filter's 19-frame group delay is
+ *           ~0.43 ms, inside a delay effect. */
+static inline void reverb_frame(int32_t send_l, int32_t send_r, int wren,
+                                int32_t *wet_l, int32_t *wet_r) {
+    rev_dn_pos = (rev_dn_pos + 1) % REV_FIR_TAPS;
+    rev_dn_hist[0][rev_dn_pos] = send_l;
+    rev_dn_hist[1][rev_dn_pos] = send_r;
+
+    int32_t stuffed_l = 0, stuffed_r = 0;
+    if (rev_phase == 0) {
+        rev_phase = 1;
+    } else {
+        reverb_step(clamp16(rev_fir_apply(rev_dn_hist[0], rev_dn_pos)),
+                    clamp16(rev_fir_apply(rev_dn_hist[1], rev_dn_pos)),
+                    wren);
+        stuffed_l = rev_out_l;
+        stuffed_r = rev_out_r;
+        rev_phase = 0;
+    }
+
+    rev_up_pos = (rev_up_pos + 1) % REV_FIR_TAPS;
+    rev_up_hist[0][rev_up_pos] = stuffed_l;
+    rev_up_hist[1][rev_up_pos] = stuffed_r;
+    *wet_l = clamp16(rev_fir_apply(rev_up_hist[0], rev_up_pos) * 2);
+    *wet_r = clamp16(rev_fir_apply(rev_up_hist[1], rev_up_pos) * 2);
 }
 

-    cpu->gte_ts_done = psx_cycle_count + (uint64_t)latency;
+    /* Scaled with the CPU clock: the GTE is COP2, on the CPU die. Unscaled,
+     * the overclock made GTE-bound code no faster at all - and slightly worse,
+     * because the instructions between a command and its read now advance the
+     * clock by half as much, so the read stalls for MORE of the fixed latency.
+     * Every stall path advances to this deadline, so arming it scaled is the
+     * one change they all need. */
+    cpu->gte_ts_done = psx_cycle_count
+                     + (uint64_t)psx_crash2_cpu_clock_latency(latency);
 }
 

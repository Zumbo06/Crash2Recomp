+/* Whether the GTE can place a camera-relative point at all: in front of the
+ * eye and far enough that its division does not saturate (H < 2 SZ). A
+ * polygon with a corner it cannot place is drawn as a wedge from wherever
+ * that corner's saturated position lands. */
+static int c2wg_placeable(const C2wgCam *c, int32_t x, int32_t y, int32_t z)
+{
+    const int64_t m3 = ((int64_t)c->r[6] * x + (int64_t)c->r[7] * y + (int64_t)c->r[8] * z) >> 12;
+    const int64_t sz = m3 > 0xFFFF ? 0xFFFF : m3;
+    return m3 > 0 && (int64_t)c->h < sz * 2;
+}

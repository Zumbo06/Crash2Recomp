+/* The camera test's verdict on a side-on path: what c2wg_classify calls
+ * C2WG_WIDE, but never a polygon with a corner the GTE cannot place, and a
+ * pool polygon only while it lies wholly in the extra columns of one side. */
+static int c2sl_side_keep(const C2wgCam *c, int32_t (*v)[3], int n, int pool)
+{
+    const int lo = -c->margin - C2WG_GUARD, hi = 512 + c->margin + C2WG_GUARD;
+    int all_l = 1, all_r = 1, all_t = 1, all_b = 1, left = 0, right = 0;
+    for (int i = 0; i < n; i++) {
+        int sx, sy;
+        if (!c2wg_placeable(c, v[i][0], v[i][1], v[i][2]) ||
+            !c2wg_project(c, v[i][0], v[i][1], v[i][2], &sx, &sy))
+            return 0;
+        if (sx >= lo) all_l = 0;
+        if (sx < hi) all_r = 0;
+        if (sy >= -C2WG_GUARD) all_t = 0;
+        if (sy < C2WG_FRAME_H + C2WG_GUARD) all_b = 0;
+        if (sx < 0) left++;
+        else if (sx >= 512) right++;
+    }
+    if (all_l || all_r || all_t || all_b) return 0;
+    if (!left && !right) return 0;                       /* inside the 4:3 columns */
+    return !pool || left == n || right == n;
+}

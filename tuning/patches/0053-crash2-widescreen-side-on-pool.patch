+/* The camera paths whose lists feed `cam`'s pool: every other path of its
+ * zone and of each resident neighbour zone (each zone once), with its zone;
+ * how many. */
+static int c2sl_pool_paths(uint32_t cam, uint32_t zone, uint32_t *paths, uint32_t *zones, int max)
+{
+    uint32_t zs[1 + C2WG_MAX_NEIGH];
+    int nz = 0, n = 0;
+    zs[nz++] = zone;
+    for (unsigned s = 0; s < C2WG_MAX_NEIGH; ++s) {
+        const uint32_t z = c2wg_neighbour(zone, s);
+        int seen = !z;
+        for (int i = 0; i < nz && !seen; ++i) seen = zs[i] == z;
+        if (!seen) zs[nz++] = z;
+    }
+    for (int i = 0; i < nz; ++i) {
+        const uint32_t h = c2wg_item(zs[i], 0u);
+        if (!h || !c2wg_ram(h, 0x18Cu)) continue;
+        const uint32_t first = C2WG_R32(h + 0x184u), items = C2WG_R32(h + 0x188u);
+        if (first > 4096u || items > 3u * C2SL_POOL_PATHS) continue;
+        for (uint32_t it = first; it < first + items && n < max; it += 3u) {
+            const uint32_t p = c2wg_item(zs[i], it);
+            if (!p || p == cam) continue;
+            paths[n] = p;
+            zones[n] = zs[i];
+            n++;
+        }
+    }
+    return n;
+}
+
+/* (Re)build the pool of `cam` in `zone` unless it is already the one these
+ * resident entries give. A path whose SLST is not resident, or does not
+ * rebuild, adds nothing. */
+static void c2sl_pool_build(uint32_t cam, uint32_t zone)
+{
+    static uint32_t paths[C2SL_POOL_PATHS], zones[C2SL_POOL_PATHS];
+    const int np = c2sl_pool_paths(cam, zone, paths, zones, C2SL_POOL_PATHS);
+    uint32_t sig = 2166136261u;
+    for (int i = 0; i < np; ++i) {
+        sig = (sig ^ paths[i]) * 16777619u;
+        sig = (sig ^ c2wg_slst_of(paths[i])) * 16777619u;
+    }
+    if (c2sl_pool.cam == cam && c2sl_pool.zone == zone && c2sl_pool.sig == sig) return;
+    c2sl_pool.cam = cam;
+    c2sl_pool.zone = zone;
+    c2sl_pool.sig = sig;
+    c2sl_pool.n = c2sl_pool.paths = 0;
+    memset(c2sl_pool_have, 0, sizeof c2sl_pool_have);
+    for (int i = 0; i < np; ++i) {
+        const uint32_t entry = c2wg_slst_of(paths[i]);
+        if (!entry) continue;
+        uint8_t map[C2WG_MAX_WORLDS];
+        for (unsigned w = 0; w < C2WG_MAX_WORLDS; ++w) {
+            map[w] = 0xFF;
+            const uint32_t eid = c2wg_world(zones[i], w);
+            for (unsigned j = 0; eid && j < C2WG_MAX_WORLDS; ++j)
+                if (c2wg_world(zone, j) == eid) { map[w] = (uint8_t)j; break; }
+        }
+        c2sl_build_entry(&c2sl_pool_tmp, entry);
+        if (c2sl_pool_tmp.ok) {
+            c2sl_pool.paths++;
+            for (int nd = 0; nd < c2sl_pool_tmp.nodes; ++nd) {
+                const uint16_t *l = c2sl_pool_tmp.ids + c2sl_pool_tmp.off[nd];
+                for (int k = 0; k < c2sl_pool_tmp.len[nd] && c2sl_pool.n < C2SL_POOL_MAX; ++k) {
+                    const unsigned w = map[l[k] >> 13];
+                    if (w >= C2WG_MAX_WORLDS) continue;
+                    const uint16_t id = (uint16_t)((w << 13) | (l[k] & 0x1FFFu));
+                    const uint16_t key = c2sl_key(id);
+                    if (c2sl_pool_have[key >> 3] & (1u << (key & 7))) continue;
+                    c2sl_pool_have[key >> 3] |= (uint8_t)(1u << (key & 7));
+                    c2sl_pool_ids[c2sl_pool.n++] = id;
+                }
+            }
+        }
+        c2sl_free(&c2sl_pool_tmp);
+    }
+}

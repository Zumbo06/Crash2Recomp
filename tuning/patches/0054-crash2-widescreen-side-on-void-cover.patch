+ * of its own; else flood the void reaching the 4:3 strip as open (2), then
+ * the rest of the void reaching the frame's outer edge (3), and want the side
+ * covered up to the innermost cell of that. */
+static void c2sl_vc_scan(const C2wgCam *cam, const C2wgWorld *ws, int nw, const uint8_t *ram,

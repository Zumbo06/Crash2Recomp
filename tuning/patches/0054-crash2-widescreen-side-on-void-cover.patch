+/* This frame's cover, from what the scan wanted (nothing unless `judged`). */
+static void c2sl_vc_step(int judged)
+{
+    for (int s = 0; s < 2; ++s) {
+        const int want = judged ? c2sl_vc.want[s] : 0;
+        if (want >= c2sl_vc.shown[s]) {
+            c2sl_vc.shown[s] = want;
+            c2sl_vc.idle[s] = 0;
+        } else if (++c2sl_vc.idle[s] > C2SL_VC_HOLD) {
+            c2sl_vc.shown[s] -= C2SL_VC_SHRINK;
+            if (c2sl_vc.shown[s] < want) c2sl_vc.shown[s] = want;
+        }
+    }
+}

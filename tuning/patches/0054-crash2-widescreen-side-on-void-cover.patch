+ * the bytes used. */
+static uint32_t c2sl_vc_draw(uint32_t frame, uint32_t prim)
+{
+    uint32_t used = 0;
+    const int marg = c2sl_vc.marg > 0 ? c2sl_vc.marg : c2sl_margin;
+    for (int s = 0; s < 2; ++s) {
+        if (c2sl_vc.shown[s] <= 0) continue;
+        const int x0 = s == 0 ? -marg - 32 : 512 + marg - c2sl_vc.shown[s];
+        const int x1 = s == 0 ? -marg + c2sl_vc.shown[s] : 512 + marg + 32;

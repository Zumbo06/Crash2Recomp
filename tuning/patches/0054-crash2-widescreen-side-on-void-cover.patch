+        const uint32_t p = prim + used;
+        C2SL_W32(p + 4u, 0x28000000u);                       /* POLY_F4, black */
+        C2SL_W32(p + 8u, ((uint32_t)(uint16_t)y0 << 16) | (uint16_t)x0);
+        C2SL_W32(p + 12u, ((uint32_t)(uint16_t)y0 << 16) | (uint16_t)x1);
+        C2SL_W32(p + 16u, ((uint32_t)(uint16_t)y1 << 16) | (uint16_t)x0);
+        C2SL_W32(p + 20u, ((uint32_t)(uint16_t)y1 << 16) | (uint16_t)x1);
+        const uint32_t ot = frame + 24u + 4u * C2SL_VC_OT;
+        const uint32_t head = C2SL_R32(ot);
+        C2SL_W32(p, (5u << 24) | (head & 0x00FFFFFFu));
+        C2SL_W32(ot, (head & 0xFF000000u) | (p & 0x00FFFFFFu));
+        used += C2SL_VC_PRIM;
+    }

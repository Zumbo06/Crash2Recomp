+/* Mark the cells of side `s` whose centres one screen triangle (grown by
+ * C2SL_VC_GROW) covers. Side 0's column c spans x from -margin + 2c, side 1's
+ * from 512 + margin - 2(c + 1): column 0 is at the wide frame's edge. */
+static void c2sl_vc_tri(int s, const float *x, const float *y)
+{
+    const float area = (x[1] - x[0]) * (y[2] - y[0]) - (y[1] - y[0]) * (x[2] - x[0]);
+    if (area > -0.5f && area < 0.5f) return;
+    float nx[3], ny[3], nd[3];
+    for (int e = 0; e < 3; ++e) {
+        const int a = e, b = (e + 1) % 3;
+        const float ex = x[b] - x[a], ey = y[b] - y[a];
+        const float len = sqrtf(ex * ex + ey * ey);
+        if (!(len > 0.0f)) return;
+        const float k = (area > 0.0f ? 1.0f : -1.0f) / len;
+        nx[e] = -ey * k; ny[e] = ex * k;                 /* inside: >= -grow */
+        nd[e] = -(nx[e] * x[a] + ny[e] * y[a]);
+    }
+    float x0 = x[0], x1 = x[0], y0 = y[0], y1 = y[0];
+    for (int i = 1; i < 3; ++i) {
+        if (x[i] < x0) x0 = x[i];
+        if (x[i] > x1) x1 = x[i];
+        if (y[i] < y0) y0 = y[i];
+        if (y[i] > y1) y1 = y[i];
+    }
+    const float g = C2SL_VC_GROW, cell = (float)C2SL_VC_CELL;
+    const float edge = s == 0 ? (float)-c2sl_vc.marg : (float)(512 + c2sl_vc.marg);
+    int c0, c1;
+    if (s == 0) { c0 = (int)floorf((x0 - g - edge) / cell); c1 = (int)floorf((x1 + g - edge) / cell); }
+    else        { c0 = (int)floorf((edge - x1 - g) / cell); c1 = (int)floorf((edge - x0 + g) / cell); }
+    int r0 = (int)floorf((y0 - g) / cell), r1 = (int)floorf((y1 + g) / cell);
+    if (c0 < 0) c0 = 0;
+    if (c1 > c2sl_vc.cols - 1) c1 = c2sl_vc.cols - 1;
+    if (r0 < 0) r0 = 0;
+    if (r1 > C2SL_VC_ROWS - 1) r1 = C2SL_VC_ROWS - 1;
+    for (int r = r0; r <= r1; ++r) {
+        const float py = (float)r * cell + cell * 0.5f;
+        for (int c = c0; c <= c1; ++c) {
+            if (c2sl_vc_cell[s][r][c]) continue;
+            const float px = s == 0 ? edge + (float)c * cell + cell * 0.5f
+                                    : edge - (float)c * cell - cell * 0.5f;
+            if (nx[0] * px + ny[0] * py + nd[0] >= -g && nx[1] * px + ny[1] * py + nd[1] >= -g &&
+                nx[2] * px + ny[2] * py + nd[2] >= -g)
+                c2sl_vc_cell[s][r][c] = 1;
+        }
+    }
+}
